  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\n# sort, greedy\nclass Solution(object):\n    def maxScore(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        nums.sort(reverse=True)\n        curr = 0\n        for i, x in enumerate(nums):\n            curr += x\n            if curr <= 0:\n                return i\n        return len(nums)"
    },
