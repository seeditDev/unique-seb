    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nunsigned int reverseBits(unsigned int n) {\n    unsigned int rev = 0;\n    \n    // Process all 32 bits\n    for(int i = 0; i < 32; i++) {\n        // Left shift rev to make space for next bit\n        rev <<= 1;\n        \n        // If current bit in n is 1, add it to rev\n        if(n & 1) {\n            rev |= 1;\n        }\n        \n        // Right shift n to process next bit\n        n >>= 1;\n    }\n    \n    return rev;\n}\n\nint main() {\n    int t;\n    cin >> t;\n    \n    while(t--) {\n        unsigned int n;\n        cin >> n;\n        cout << reverseBits(n) << endl;\n    }\n    \n    return 0;\n}",
