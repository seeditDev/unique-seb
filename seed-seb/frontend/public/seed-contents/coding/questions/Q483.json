  "solution": {
    "code": {
      "Python3": "# Time:  O(logn * log(logn))\n# Space: O(1)\n\nimport math\n\n\nclass Solution(object):\n    def smallestGoodBase(self, n):\n        \"\"\"\n        :type n: str\n        :rtype: str\n        \"\"\"\n        num = int(n)\n        max_len = int(math.log(num,2))\n        for l in range(max_len, 1, -1):\n            b = int(num ** (l**-1))\n            if (b**(l+1)-1) // (b-1) == num:\n                return str(b)\n        return str(num-1)"
    },
