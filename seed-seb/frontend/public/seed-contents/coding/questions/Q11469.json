  "solution": {
    "approach": "Divide the total cost by the cost per shovel and round up to the nearest whole number",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\n#include <math.h>\nint main() {\n    int k, n;\n    scanf(\"%d %d\", &k, &n);\n    printf(\"%d\\n\", (int)ceil((double)n / k));\n    return 0;\n}",
      "C++": "#include <iostream>\n#include <cmath>\nusing namespace std;\nint main() {\n    int k, n;\n    cin >> k >> n;\n    cout << (int)ceil((double)n / k) << endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int k = scanner.nextInt();\n        int n = scanner.nextInt();\n        System.out.println((int)Math.ceil((double)n / k));\n    }\n}",
      "Python3": "import math\nk, n = map(int, input().split())\nprint(math.ceil(n / k))",
      "JavaScript": "const readline = require('readline');\nconst rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nrl.on('line', (input) => {\n    const [k, n] = input.split(' ').map(Number);\n    console.log(Math.ceil(n / k));\n});"
    },
