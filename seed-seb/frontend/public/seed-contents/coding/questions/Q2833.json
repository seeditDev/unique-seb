  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def furthestDistanceFromOrigin(self, moves):\n        \"\"\"\n        :type moves: str\n        :rtype: int\n        \"\"\"\n        curr = cnt = 0\n        for x in moves:\n            if x == 'L':\n                curr -= 1\n            elif x == 'R':\n                curr += 1\n            else:\n                cnt += 1\n        return abs(curr)+cnt"
    },
