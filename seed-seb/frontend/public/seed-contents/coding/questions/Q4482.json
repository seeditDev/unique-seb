  "content": {
    "problemStatement": "Given a bubbleSort function that accepts an array as a parameter, sort the array using the **Bubble sort** algorithm.\n\n**Note:** Do not write code to take input or print output, Only complete the implementation of the bubbleSort function.",
    "constraints": [
      "1 <= T <= 100",
      "1 <= N <= 1000",
      "1 <= arr[i] <= 10000"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each test case consists of two lines: the first line contains an integer N, the size of the array. The second line contains N space‑separated integers.",
    "outputFormat": "For each test case output the array sorted in non‑decreasing order on a single line. Numbers are separated by a single space.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n8\n6 5 3 1 8 7 2 4",
        "output": "1 2 3 4 5 6 7 8",
        "explanation": "The array is sorted in ascending order using bubble sort."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n5\n5 4 3 2 1",
        "output": "1 2 3 4 5",
        "explanation": "The descending array becomes ascending after sorting."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n1\n10",
        "output": "10",
        "explanation": "A single‑element array is already sorted."
