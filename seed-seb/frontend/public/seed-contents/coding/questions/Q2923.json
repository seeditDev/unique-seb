  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def findChampion(self, grid):\n        \"\"\"\n        :type grid: List[List[int]]\n        :rtype: int\n        \"\"\"\n        return next(u for u in range(len(grid)) if sum(grid[u]) == len(grid)-1)"
    },
