  "solution": {
    "approach": "Calculate the day of the week based on the number of days passed since the beginning of the year, considering that the year starts on a Monday.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    char *days[] = {\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"};\n    printf(\"%s\\n\", days[(n - 1) % 7]);\n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    string days[] = {\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"};\n    cout << days[(n - 1) % 7] << endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        String[] days = {\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"};\n        System.out.println(days[(n - 1) % 7]);\n    }\n}",
      "Python3": "n = int(input())\ndays = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"]\nprint(days[(n - 1) % 7])",
      "JavaScript": "const readline = require('readline');\nconst rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nrl.on('line', (n) => {\n    const days = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"];\n    console.log(days[(n - 1) % 7]);\n});"
    },
