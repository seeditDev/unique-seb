  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def removeTrailingZeros(self, num):\n        \"\"\"\n        :type num: str\n        :rtype: str\n        \"\"\"\n        return num[:next(i for i in reversed(range(len(num))) if num[i] != '0')+1]"
    },
