    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int m, n;\n    scanf(\"%d %d\", &m, &n);\n\n    int matrix[m][n];\n\n    for (int i = 0; i < m; i++) {\n        for (int j = 0; j < n; j++) {\n            scanf(\"%d\", &matrix[i][j]);\n        }\n    }\n\n    for (int i = 0; i < m; i++) {\n        int rowSum = 0;\n        for (int j = 0; j < n; j++) {\n            rowSum += matrix[i][j];\n        }\n        printf(\"%d \", rowSum);\n    }\n    printf(\"\\n\");\n\n    for (int j = 0; j < n; j++) {\n        int colSum = 0;\n        for (int i = 0; i < m; i++) {\n            colSum += matrix[i][j];\n        }\n        printf(\"%d \", colSum);\n    }\n    printf(\"\\n\");\n\n    return 0;\n}",
