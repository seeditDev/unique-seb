  "solution": {
    "code": {
      "Python3": "# Time:  O(n + r)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def findMissingElements(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        lookup = set(nums)\n        return [x for x in range(min(nums)+1, max(nums)) if x not in lookup]"
    },
