        "type": "reg",
        "input": "3 2\n1 -2 3",
        "output": "0.5",
        "explanation": "Explanation:\nIn given array {1, -2, 3}, selecting subsegment {3}, gets you {1, -2, 1.5} after division by 2, which gives sum = 0.5"
