  "solution": {
    "code": {
      "Python3": "# Time:  O(m * nlogn)\n# Space: O(1)\n\n# sort\nclass Solution(object):\n    def matrixSum(self, nums):\n        \"\"\"\n        :type nums: List[List[int]]\n        :rtype: int\n        \"\"\"\n        for row in nums:\n            row.sort()\n        return sum(max(nums[r][c] for r in range(len(nums))) for c in range(len(nums[0])))"
    },
