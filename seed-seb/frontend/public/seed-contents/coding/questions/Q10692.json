    "code": {
      "C": "",
      "C++": "#include <iostream>\nusing namespace std;\n\nint russianPeasant(int a, int b) {\n    int result = 0;\n    \n    // While second number is greater than 0\n    while(b > 0) {\n        // If second number is odd\n        // add the first number to result\n        if(b & 1) {  // Same as b % 2 == 1\n            result = result + a;\n        }\n        \n        // Double first number\n        a = a << 1;  // Same as a = a * 2\n        \n        // Halve second number\n        b = b >> 1;  // Same as b = b / 2\n    }\n    \n    return result;\n}\n\nint main() {\n    int t;\n    cin >> t;\n    \n    while(t--) {\n        int a, b;\n        cin >> a >> b;\n        cout << russianPeasant(a, b) << endl;\n    }\n    \n    return 0;\n}",
