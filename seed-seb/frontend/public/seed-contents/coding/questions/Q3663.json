  "solution": {
    "code": {
      "Python3": "# Time:  O(logn + 10)\n# Space: O(10)\n\n# freq table\nclass Solution(object):\n    def getLeastFrequentDigit(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        cnt = [0]*10\n        while n:\n            n, r = divmod(n, 10)\n            cnt[r] += 1\n        mn = min(x for x in cnt if x)\n        return next(i for i in range(len(cnt)) if cnt[i] == mn)"
    },
