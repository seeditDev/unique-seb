  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\nimport math\n\n\nclass Solution(object):\n    def constructRectangle(self, area):\n        \"\"\"\n        :type area: int\n        :rtype: List[int]\n        \"\"\"\n        w = int(math.sqrt(area))\n        while area % w:\n            w -= 1\n        return [area // w, w]"
    },
