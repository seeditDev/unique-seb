  "solution": {
    "code": {
      "Python3": "# Time:  O(n * 2^n)\n# Space: O(n * 2^n)\n\nclass Solution(object):\n    def letterCasePermutation(self, S):\n        \"\"\"\n        :type S: str\n        :rtype: List[str]\n        \"\"\"\n        result = [[]]\n        for c in S:\n            if c.isalpha():\n                for i in range(len(result)):\n                    result.append(result[i][:])\n                    result[i].append(c.lower())\n                    result[-1].append(c.upper())\n            else:\n                for s in result:\n                    s.append(c)\n        return map(\"\".join, result)"
    },
