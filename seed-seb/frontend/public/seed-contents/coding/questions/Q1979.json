      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport fractions\n\n\nclass Solution(object):\n    def findGCD(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        return fractions.gcd(min(nums), max(nums))"
