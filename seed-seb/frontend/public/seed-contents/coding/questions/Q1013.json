  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def canThreePartsEqualSum(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: bool\n        \"\"\"\n        total = sum(A)\n        if total % 3 != 0:\n            return False\n        parts, curr = 0, 0\n        for x in A:\n            curr += x\n            if curr == total//3:\n                parts += 1\n                curr = 0\n        return parts >= 3"
    },
