  "content": {
    "problemStatement": "Write a program that takes three space separated numbers as input.\n\n\nPrints \"**Increasing**\" if the numbers are in strictly increasing order,\n\"**Decreasing**\" if they are in strictly decreasing order,\nand \"**Neither**\" otherwise.\nCheck the sample input / output below for further clarity.",
    "constraints": [
      "1 <= T <= 1000",
      "1 <= a, b, c <= 100"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains three space-separated integers a, b, and c.",
    "outputFormat": "For each test case, print **Increasing** if a<b<c, **Decreasing** if a>b>c, otherwise print **Neither**. Each answer on its own line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n20 30 41",
        "output": "**Increasing**",
        "explanation": "Only one test case. 20 < 30 < 41, so the sequence is strictly increasing."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n41 30 20",
        "output": "**Decreasing**",
        "explanation": "Only one test case. 41 > 30 > 20, so the sequence is strictly decreasing."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n20 20 20",
        "output": "**Neither**",
        "explanation": "All three numbers are equal, which is neither strictly increasing nor strictly decreasing."
      }
    ]
  },
