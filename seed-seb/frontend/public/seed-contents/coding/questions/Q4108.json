  "content": {
    "problemStatement": "Rectify the errors in the program to correctly print the last character of the string.",
    "constraints": [
      "1 <= T <= 100",
      "1 <= |S| <= 1000",
      "S contains printable ASCII characters"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single string S (may contain spaces).",
    "outputFormat": "For each test case, print the last character of the given string on its own line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\nCodeChef\nHelloWorld\na",
        "output": "f\nd\na",
        "explanation": "The last characters are 'f' from \"CodeChef\", 'd' from \"HelloWorld\", and 'a' from \"a\"."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2\nOpenAI\nChatGPT",
        "output": "I\nT",
        "explanation": "For \"OpenAI\" the last character is 'I'; for \"ChatGPT\" it is 'T'."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\nZ",
        "output": "Z",
        "explanation": "A single-character string returns that character itself."
      }
    ]
  },
