  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport itertools\n\n\nclass Solution(object):\n    def sortSentence(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        words = s.split()\n        for i in range(len(words)):\n            while int(words[i][-1])-1 != i:\n                words[int(words[i][-1])-1], words[i] = words[i], words[int(words[i][-1])-1]\n        return \" \".join(itertools.imap(lambda x: x[:-1], words))"
    },
