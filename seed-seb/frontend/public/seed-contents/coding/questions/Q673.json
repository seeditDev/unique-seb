  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(n)\n\nclass Solution(object):\n    def findNumberOfLIS(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result, max_len = 0, 0\n        dp = [[1, 1] for _ in range(len(nums))]  # {length, number} pair\n        for i in range(len(nums)):\n            for j in range(i):\n                if nums[i] > nums[j]:\n                    if dp[i][0] == dp[j][0]+1:\n                        dp[i][1] += dp[j][1]\n                    elif dp[i][0] < dp[j][0]+1:\n                        dp[i] = [dp[j][0]+1, dp[j][1]]\n            if max_len == dp[i][0]:\n                result += dp[i][1]\n            elif max_len < dp[i][0]:\n                max_len = dp[i][0]\n                result = dp[i][1]\n        return result"
    },
