  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\nclass Solution(object):\n    def integerReplacement(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        result = 0\n        while n != 1:\n            b = n & 3\n            if n == 3:\n                n -= 1\n            elif b == 3:\n                n += 1\n            elif b == 1:\n                n -= 1\n            else:\n                n /= 2\n            result += 1\n\n        return result"
    },
