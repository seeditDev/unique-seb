  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\n# sort\nclass Solution(object):\n    def countOperationsToEmptyArray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        idxs = range(len(nums))\n        idxs.sort(key=lambda x: nums[x])\n        return len(idxs)+sum(len(idxs)-(i+1) for i in range(len(idxs)-1) if idxs[i] > idxs[i+1])"
    },
