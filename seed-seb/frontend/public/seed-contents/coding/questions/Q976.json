  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\nclass Solution(object):\n    def largestPerimeter(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        A.sort()\n        for i in reversed(range(len(A) - 2)):\n            if A[i] + A[i+1] > A[i+2]:\n                return A[i] + A[i+1] + A[i+2]\n        return 0"
    },
