  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\n# sort\nclass Solution(object):\n    def minimumAverage(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: float\n        \"\"\"\n        nums.sort()\n        return min((nums[i]+nums[~i])/2.0 for i in range(len(nums)//2))"
    },
