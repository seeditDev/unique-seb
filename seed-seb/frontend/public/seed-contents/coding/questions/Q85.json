  "content": {
    "problemStatement": "You receive a `rows x cols` binary `matrix` filled with `0`'s and `1`'s, determine the largest rectangle containing only `1`'s and output *its area*.",
    "constraints": [
      "None"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
