  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\nimport itertools\n\n\nclass Solution(object):\n    def maxCoins(self, piles):\n        \"\"\"\n        :type piles: List[int]\n        :rtype: int\n        \"\"\"\n        piles.sort()\n        return sum(itertools.islice(piles, len(piles)//3, len(piles), 2))"
    },
