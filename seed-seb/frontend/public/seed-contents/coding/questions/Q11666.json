  "solution": {
    "approach": "Count the number of 'H' characters in the string.",
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    char s[101];\n    scanf(\"%s\", s);\n    int count = 0;\n    for (int i = 0; s[i]; i++) {\n        if (s[i] == 'H') count++;\n    }\n    printf(\"%d\\n\", count);\n    return 0;\n}",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    string s;\n    cin >> s;\n    int count = 0;\n    for (char c : s) {\n        if (c == 'H') count++;\n    }\n    cout << count << endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        String s = scanner.next();\n        int count = 0;\n        for (char c : s.toCharArray()) {\n            if (c == 'H') count++;\n        }\n        System.out.println(count);\n    }\n}",
      "Python3": "s = input()\nprint(s.count('H'))",
      "JavaScript": "const readline = require('readline');\nconst rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nrl.on('line', (s) => {\n    let count = 0;\n    for (let c of s) {\n        if (c === 'H') count++;\n    }\n    console.log(count);\n});"
    },
