  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# forward solution\nclass Solution(object):\n    def freqAlphabets(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        def alpha(num):\n            return chr(ord('a') + int(num)-1)\n\n        i = 0\n        result = []\n        while i < len(s):\n            if i+2 < len(s) and s[i+2] == '#':\n                result.append(alpha(s[i:i+2]))\n                i += 3\n            else:\n                result.append(alpha(s[i]))\n                i += 1\n        return \"\".join(result)"
    },
