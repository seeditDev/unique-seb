  "solution": {
    "approach": "For each test case we simply compare the two percentages. If the first percentage is larger we output the first name, if the second is larger we output the second name, otherwise we output the special token **equal**. The algorithm is O(1) per test case and uses O(1) extra space.",
    "timeComplexity": "O(T) total, O(1) per test case.",
    "spaceComplexity": "O(1) additional space.",
    "code": {
      "C": "",
      "C++": "",
      "Java": "import java.io.*;import java.util.*;public class Main{public static void main(String[] args) throws Exception{BufferedReader br=new BufferedReader(new InputStreamReader(System.in));StringBuilder sb=new StringBuilder();int T=Integer.parseInt(br.readLine().trim());for(int t=0;t<T;t++){StringTokenizer st=new StringTokenizer(br.readLine());String name1=st.nextToken();String name2=st.nextToken();st=new StringTokenizer(br.readLine());int p1=Integer.parseInt(st.nextToken());int p2=Integer.parseInt(st.nextToken());if(p1>p2)sb.append(name1);else if(p2>p1)sb.append(name2);else sb.append(\"**equal**\");if(t<T-1)sb.append('\\n');}System.out.print(sb.toString());}}",
      "Python3": "",
      "JavaScript": ""
    },
