  "content": {
    "problemStatement": "Write a program to input two student's names and percentages and print the name of the student with the higher percentage. In case they score equal percentages, print '**equal**'.\n\n\nInput Format\n\nThe first line of input will contain two strings: the name of the first student and the name of the second student.\nThe second line of input will contain two percentages: the percentage of the first student and the percentage of the second student.",
    "constraints": [
      "1 <= T <= 100",
      "1 <= name length <= 20",
      "0 <= percentage <= 100",
      "name1 != name2"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each test case consists of two lines: the first line contains two strings denoting the names of the two students, and the second line contains two integers denoting their percentages.",
    "outputFormat": "For each test case, output a single line containing the name of the student with the higher percentage. If both percentages are equal, output **equal**.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\nAmit Swarup\n95 92",
        "output": "Amit",
        "explanation": "Only one test case. Amit's percentage (95) is higher than Swarup's (92), so Amit is printed."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\nJohn Doe\n92 95",
        "output": "Doe",
        "explanation": "Doe's percentage (95) exceeds John's (92), therefore Doe is printed."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\nAlice Bob\n95 95",
        "output": "**equal**",
        "explanation": "Both percentages are equal (95), so the special token **equal** is printed."
      }
    ]
  },
