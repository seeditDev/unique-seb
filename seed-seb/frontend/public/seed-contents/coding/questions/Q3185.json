  "solution": {
    "code": {
      "Python3": "# Time:  O(n + 24)\n# Space: O(24)\n\n# freq table\nclass Solution(object):\n    def countCompleteDayPairs(self, hours):\n        \"\"\"\n        :type hours: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        cnt = [0]*24\n        for x in hours:\n            result += cnt[-x%24]\n            cnt[x%24] += 1\n        return result"
    },
