  "solution": {
    "code": {
      "Python3": "class Solution(object):\n    def maximumSum(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: int\n        \"\"\"\n        result, prev, curr = float(\"-inf\"), float(\"-inf\"), float(\"-inf\")\n        for x in arr:\n            curr = max(prev, curr+x, x)\n            result = max(result, curr)\n            prev = max(prev+x, x)\n        return result"
    },
