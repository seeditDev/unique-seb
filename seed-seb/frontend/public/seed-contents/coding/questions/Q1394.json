  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def findLucky(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: int\n        \"\"\"\n        count = collections.Counter(arr)\n        result = -1\n        for k, v in count.iteritems():\n            if k == v:\n                result = max(result, k)\n        return result"
    },
