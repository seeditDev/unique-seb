    "code": {
      "C": "#include <stdio.h>\nint main()\n{\n   int num;\n    \n    scanf(\"%d\", &num);\n\n    // Check odd or even using both modulus and conditional operator\n    printf( (num % 2 == 0) ? \"Even\" : \"Odd\");\n    \n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\n\nint main() {\n    int num;\n    \n    cin >> num;\n\n    // Check odd or even using both modulus and conditional operator\n    cout <<((num % 2 == 0) ? \"Even\" : \"Odd\") <<endl;\n    \n    return 0;\n}",
      "Java": "import java.util.Scanner;\nclass Codechef\n{\n    public static void main (String[] args) \n    {\n        // your code goes here\n         Scanner scanner = new Scanner(System.in);\n        \n        int num = scanner.nextInt();\n        \n        // Check odd or even using modulus and conditional operator\n        System.out.println(num % 2 == 0 ? \"Even\" : \"Odd\");\n    }\n}\n",
