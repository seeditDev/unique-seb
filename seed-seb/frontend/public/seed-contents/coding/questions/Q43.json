  "content": {
    "problemStatement": "You receive two non-negative integers `num1` and `num2` represented as strings, output the product of `num1` and `num2`, also represented as a string.\n\n**Note:** You must not use any built-in BigInteger library or convert the inputs to integer directly.",
    "constraints": [
      "1 <= num1.length, num2.length <= 200",
      "num1 and num2 consist of digits only",
      "num1 and num2 do not contain leading zeros except the number \"0\""
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [],
