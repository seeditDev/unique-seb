  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def numSteps(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result, carry = 0, 0\n        for i in reversed(range(1, len(s))):\n            if int(s[i]) + carry == 1:\n                carry = 1  # once it was set, it would keep carrying forever\n                result += 2\n            else:\n                result += 1\n        return result+carry"
    },
