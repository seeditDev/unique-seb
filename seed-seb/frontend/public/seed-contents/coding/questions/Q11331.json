  "content": {
    "problemStatement": "Chef bought some number of sacks of flour, and some number of sacks of sugar. It is unknown exactly how many of each.\n\nEach sack of flour weighs 222 kilograms, and each sack of sugar weighs 111 kilogram. It is known that the total weight of Chef's sacks of flours and sugar was NNN kilograms.\n\nIs it possible that Chef bought an equal number of sacks of flour and sugar? Print Yes\\text{Yes}Yes if it is possible and No\\text{No}No otherwise.\n\n\nInput Format\n\nThe first and only line contains 111 integer - NNN.\n\n\nOutput Format\nOutput Yes\\text{Yes}Yes if it was possible for Chef to buy an equal number of sacks of rice and sugar, and No\\text{No}No otherwise.",
    "constraints": [
      "1≤N≤101 \\le N \\le 101≤N≤10"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3",
        "output": "Yes",
        "explanation": "Explanation:\nChef could have bought 111 sack of flour and 111 sack of sugar for a total weight of 333 kilograms."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "5",
        "output": "No",
        "explanation": "Explanation:\nIt is impossible for Chef to buy an equal amount of sacks of flour and sugar."
      }
    ]
  },
