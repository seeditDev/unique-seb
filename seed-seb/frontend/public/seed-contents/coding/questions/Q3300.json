  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogr)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def minElement(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def f(x):\n            result = 0\n            while x:\n                result += x%10\n                x //= 10\n            return result\n\n        return min(f(x) for x in nums)"
    },
