  "solution": {
    "code": {
      "Python3": "# Time:  O(n * l)\n# Space: O(1)\n\nclass Solution(object):\n    def minDeletionSize(self, A):\n        \"\"\"\n        :type A: List[str]\n        :rtype: int\n        \"\"\"\n        result = 0\n        for c in range(len(A[0])):\n            for r in range(1, len(A)):\n                if A[r-1][c] > A[r][c]:\n                    result += 1\n                    break\n        return result"
    },
