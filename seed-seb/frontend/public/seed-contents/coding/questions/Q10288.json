  "content": {
    "problemStatement": "Surya Namaskar, also known as Sun Salutation, is a series of 121212 yoga poses performed in a sequence.\n\nChef repeats this sequence of yoga poses multiple times during his session.\n\nGiven that Chef has performed NNN yoga poses, find the number of rounds of Surya Namaskar he completed during the session.\n\n\nInput Format\nThe input will contain a single integer NNN, denoting the number of yoga poses Chef performed during his session.\n\n\n\nOutput Format\nOutput the number of rounds of Surya Namaskar Chef completed during the session.",
    "constraints": [
      "1≤N≤1001 \\leq N \\leq 1001≤N≤100"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "55",
        "output": "4",
        "explanation": "Explanation:\nChef completed 444 rounds of Surya Namaskar comprising of 4⋅12=484\\cdot 12 = 484⋅12=48 yoga poses.\nThe fifth round was incomplete since Chef performed only 777 poses in that round."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "11",
        "output": "0",
        "explanation": "Explanation:\nChef performed 111111 yoga poses whereas each Surya Namaskar consists of 121212 poses. Thus, he did not complete even 111 round of Surya Namaskar."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "24",
        "output": "2",
        "explanation": "Explanation:\nSince Chef performed 242424 yoga poses and each Surya Namaskar consists of 121212 poses, he completed 222 rounds of Surya Namaskar."
      }
    ]
  },
