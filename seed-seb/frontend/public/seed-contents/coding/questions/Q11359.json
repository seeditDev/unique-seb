  "solution": {
    "approach": "Mathematical calculation of the sum of an arithmetic series",
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "\n         #include <stdio.h>\n         int findMissingNumber(int* nums, int numsSize) {\n            int n = numsSize + 1;\n            int expectedSum = (n * (n + 1)) / 2;\n            int actualSum = 0;\n            for (int i = 0; i < numsSize; i++) {\n               actualSum += nums[i];\n            }\n            return expectedSum - actualSum;\n         }\n      ",
      "C++": "\n         #include <iostream>\n         #include <vector>\n         int findMissingNumber(std::vector<int>& nums) {\n            int n = nums.size() + 1;\n            int expectedSum = (n * (n + 1)) / 2;\n            int actualSum = 0;\n            for (int num : nums) {\n               actualSum += num;\n            }\n            return expectedSum - actualSum;\n         }\n      ",
      "Java": "\n         public class Main {\n            public static int findMissingNumber(int[] nums) {\n               int n = nums.length + 1;\n               int expectedSum = (n * (n + 1)) / 2;\n               int actualSum = 0;\n               for (int num : nums) {\n                  actualSum += num;\n               }\n               return expectedSum - actualSum;\n            }\n         }\n      ",
      "Python3": "\n         def find_missing_number(nums):\n            n = len(nums) + 1\n            expected_sum = (n * (n + 1)) // 2\n            actual_sum = sum(nums)\n            return expected_sum - actual_sum\n      ",
      "JavaScript": "\n         function findMissingNumber(nums) {\n            let n = nums.length + 1;\n            let expectedSum = (n * (n + 1)) / 2;\n            let actualSum = nums.reduce((a, b) => a + b, 0);\n            return expectedSum - actualSum;\n         }\n      "
    },
