  "content": {
    "problemStatement": "You receive an array of `intervals` where `intervals[i] = [starti, endi]`, merge all overlapping intervals, and output *an array of the non-overlapping intervals that cover all the intervals in the input*.",
    "constraints": [
      "1 <= nums.length <= 10^4",
      "0 <= nums[i] <= 10^5"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "[[1,3],[2,6],[8,10],[15,18]]",
        "output": "[[1,6],[8,10],[15,18]]",
        "explanation": "For this input, applying the required rules of Merge Intervals produces [[1,6],[8,10],[15,18]]."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "[[1,4],[4,5]]",
        "output": "[[1,5]]",
        "explanation": "For this input, applying the required rules of Merge Intervals produces [[1,5]]."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "[[4,7],[1,4]]",
        "output": "[[1,7]]",
        "explanation": "For this input, applying the required rules of Merge Intervals produces [[1,7]]."
      }
    ]
  },
