  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def averageValue(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        total = cnt = 0\n        for x in nums:\n            if x%6:\n                continue\n            total += x\n            cnt += 1\n        return total//cnt if cnt else 0"
    },
