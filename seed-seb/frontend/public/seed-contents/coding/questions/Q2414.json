  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def longestContinuousSubstring(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = l = 0\n        for i in range(len(s)):\n            l += 1\n            if i+1 == len(s) or ord(s[i])+1 != ord(s[i+1]):\n                result = max(result, l)\n                l = 0\n        return result"
    },
