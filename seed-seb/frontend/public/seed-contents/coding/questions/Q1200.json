  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\nclass Solution(object):\n    def minimumAbsDifference(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: List[List[int]]\n        \"\"\"\n        result = []\n        min_diff = float(\"inf\")\n        arr.sort()\n        for i in range(len(arr)-1):\n            diff = arr[i+1]-arr[i]\n            if diff < min_diff:\n                min_diff = diff\n                result = [[arr[i], arr[i+1]]]\n            elif diff == min_diff:\n                result.append([arr[i], arr[i+1]])\n        return result"
    },
