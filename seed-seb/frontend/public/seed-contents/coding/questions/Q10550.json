  "content": {
    "problemStatement": "Chef has XXX cones and YYY scoops of ice cream. Each ice cream cone requires exactly one cone and one scoop of ice cream.\n\nYour task is to determine the **maximum** number of ice cream cones Chef can make with the available ingredients.\n\n\nInput Format\n\nInput will contain two integers XXX and YYY - the number of cones and ice cream scoops, respectively.\n\n\nOutput Format\nOutput the maximum number of ice cream cones Chef can make.",
    "constraints": [
      "1≤X≤1001 \\leq X \\leq 1001≤X≤100",
      "1≤Y≤1001 \\leq Y \\leq 1001≤Y≤100"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
