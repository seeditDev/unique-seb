  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def decode(self, encoded):\n        \"\"\"\n        :type encoded: List[int]\n        :rtype: List[int]\n        \"\"\"\n        curr = 0\n        for i in range(1, (len(encoded)+1) + 1):\n            curr ^= i\n            if i < len(encoded) and i%2 == 1:\n                curr ^= encoded[i]\n        result = [curr]\n        for x in encoded:\n            result.append(result[-1]^x)\n        return result"
    },
