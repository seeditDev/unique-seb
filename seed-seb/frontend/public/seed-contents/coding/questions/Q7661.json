  "content": {
    "problemStatement": "You are given two integers NNN and MMM. Find the number of sequences A1,A2,…,ANA_1, A_2, \\ldots, A_NA1​,A2​,…,AN​, where each element is an integer between 111 and MMM (inclusive) and no three consecutive elements are equal. Since this number could be very large, compute it modulo 109+710^9+7109+7.",
    "constraints": [
      "1≤T≤1051 \\le T \\le 10^51≤T≤105",
      "1≤N,M≤10181 \\le N, M \\le 10^{18}1≤N,M≤1018",
      "Subtasks**Subtask #1 (50 points):**",
      "T≤20T \\le 20T≤20",
      "N≤105N \\le 10^5N≤105"
    ],
    "inputFormat": "The first line of the input contains a single integer TTT denoting the number of test cases. The description of TTT test cases follows.\nThe first and only line of each test case contains two space-separated integers NNN and MMM.",
    "outputFormat": "For each test case, print a single line containing one integer ― the number of valid sequences modulo 109+710^9+7109+7.",
    "notes": [],
    "sampleTestCases": [
      {
