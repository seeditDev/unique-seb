      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# bit manipulation\nclass Solution(object):\n    def smallestNumber(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        return (1<<n.bit_length())-1"
