  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n\n// Implement findMedianSortedArrays(nums1, m, nums2, n) returning double\n\ndouble findMedianSortedArrays(int* nums1, int m, int* nums2, int n) {\n    if (m > n) return findMedianSortedArrays(nums2, n, nums1, m);\n    int imin = 0, imax = m, half = (m + n + 1) / 2;\n    while (imin <= imax) {\n        int i = (imin + imax) / 2;\n        int j = half - i;\n        int maxLeft1 = (i == 0) ? INT_MIN : nums1[i-1];\n        int minRight1 = (i == m) ? INT_MAX : nums1[i];\n        int maxLeft2 = (j == 0) ? INT_MIN : nums2[j-1];\n        int minRight2 = (j == n) ? INT_MAX : nums2[j];\n        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {\n            if ((m + n) % 2 == 1) return (double) ( (maxLeft1 > maxLeft2) ? maxLeft1 : maxLeft2 );\n            int leftMax = (maxLeft1 > maxLeft2) ? maxLeft1 : maxLeft2;\n            int rightMin = (minRight1 < minRight2) ? minRight1 : minRight2;\n            return ((double)leftMax + (double)rightMin) / 2.0;\n        } else if (maxLeft1 > minRight2) {\n            imax = i - 1;\n        } else {\n            imin = i + 1;\n        }\n    }\n    return 0.0;\n}\n\nint main() { return 0; }",
    "C++": "",
    "Java": "import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static double findMedianSortedArrays(int[] nums1, int[] nums2) {\n        if (nums1.length > nums2.length) return findMedianSortedArrays(nums2, nums1);\n        int m = nums1.length, n = nums2.length;\n        int imin = 0, imax = m, half = (m + n + 1) / 2;\n        while (imin <= imax) {\n            int i = (imin + imax) / 2;\n            int j = half - i;\n            int maxLeft1 = (i == 0) ? Integer.MIN_VALUE : nums1[i-1];\n            int minRight1 = (i == m) ? Integer.MAX_VALUE : nums1[i];\n            int maxLeft2 = (j == 0) ? Integer.MIN_VALUE : nums2[j-1];\n            int minRight2 = (j == n) ? Integer.MAX_VALUE : nums2[j];\n            if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {\n                if ((m + n) % 2 == 1) return (double)Math.max(maxLeft1, maxLeft2);\n                return ((double)Math.max(maxLeft1, maxLeft2) + (double)Math.min(minRight1, minRight2)) / 2.0;\n            } else if (maxLeft1 > minRight2) {\n                imax = i - 1;\n            } else {\n                imin = i + 1;\n            }\n        }\n        return 0.0;\n    }\n\n    public static void main(String[] args) throws Exception {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String line = br.readLine();\n        // Expect JSON array like [[1,3],[2]]\n        // Minimal parsing using split is acceptable in judge harness; here we assume harness provides parsed arrays.\n    }\n}",
    "Python3": "import sys, json\n\nimport math\n\ndef findMedianSortedArrays(nums1, nums2):\n    # Ensure nums1 is the smaller array\n    if len(nums1) > len(nums2):\n        nums1, nums2 = nums2, nums1\n    m, n = len(nums1), len(nums2)\n    imin, imax = 0, m\n    half = (m + n + 1) // 2\n    while imin <= imax:\n        i = (imin + imax) // 2\n        j = half - i\n        maxLeft1 = -math.inf if i == 0 else nums1[i-1]\n        minRight1 = math.inf if i == m else nums1[i]\n        maxLeft2 = -math.inf if j == 0 else nums2[j-1]\n        minRight2 = math.inf if j == n else nums2[j]\n        if maxLeft1 <= minRight2 and maxLeft2 <= minRight1:\n            if (m + n) % 2 == 1:\n                return float(max(maxLeft1, maxLeft2))\n            else:\n                return (max(maxLeft1, maxLeft2) + min(minRight1, minRight2)) / 2.0\n        elif maxLeft1 > minRight2:\n            imax = i - 1\n        else:\n            imin = i + 1\n    return 0.0\n\nif __name__ == '__main__':\n    args = json.loads(sys.stdin.readline())\n    nums1, nums2 = args[0], args[1]\n    print(json.dumps(findMedianSortedArrays(nums1, nums2)))",
    "JavaScript": "'use strict';\nconst rl = require('readline');\nconst reader = rl.createInterface({ input: process.stdin });\nreader.on('line', line => {\n    const args = JSON.parse(line.trim());\n    let nums1 = args[0], nums2 = args[1];\n    if (nums1.length > nums2.length) [nums1, nums2] = [nums2, nums1];\n    const m = nums1.length, n = nums2.length;\n    let imin = 0, imax = m, half = Math.floor((m + n + 1) / 2);\n    while (imin <= imax) {\n        const i = Math.floor((imin + imax) / 2);\n        const j = half - i;\n        const maxLeft1 = (i === 0) ? -Infinity : nums1[i-1];\n        const minRight1 = (i === m) ? Infinity : nums1[i];\n        const maxLeft2 = (j === 0) ? -Infinity : nums2[j-1];\n        const minRight2 = (j === n) ? Infinity : nums2[j];\n        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {\n            if ((m + n) % 2 === 1) { console.log(JSON.stringify(Math.max(maxLeft1, maxLeft2))); reader.close(); return; }\n            console.log(JSON.stringify((Math.max(maxLeft1, maxLeft2) + Math.min(minRight1, minRight2)) / 2.0));\n            reader.close(); return;\n        } else if (maxLeft1 > minRight2) {\n            imax = i - 1;\n        } else {\n            imin = i + 1;\n        }\n    }\n    console.log(JSON.stringify(0.0));\n    reader.close();\n});",
