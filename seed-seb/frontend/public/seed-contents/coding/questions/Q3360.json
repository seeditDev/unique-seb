  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def canAliceWin(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: bool\n        \"\"\"\n        c = 10\n        # (c+(c-l+1))*l/2 <= n\n        # l^2-(2*c+1)*l-2*n >= 0\n        # l <= ((2*c+1)-((2*c+1)**2-8*n)**0.5)/2\n        l = int(((2*c+1)-((2*c+1)**2-8*n)**0.5)/2)\n        return l%2 == 1"
    },
