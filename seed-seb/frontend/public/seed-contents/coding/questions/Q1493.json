  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def longestSubarray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        count, left = 0, 0\n        for right in range(len(nums)):\n            count += (nums[right] == 0)\n            if count >= 2:\n                count -= (nums[left] == 0)\n                left += 1\n        return (right-left+1)-1"
    },
