  "content": {
    "problemStatement": "Write a program for the coding challenge \"Hanoi Factory\". Refer to LeetCode description: https://codeforces.com/contest/777/problem/E",
    "constraints": [
      "1 <= n <= 10",
      "1 <= disk_size <= 10^5"
    ],
    "inputFormat": "The first line contains an integer n, which is the number of disks. The next line contains n integers representing the initial state of the disks.",
    "outputFormat": "The minimum number of moves required to solve the Tower of Hanoi problem.",
