  "solution": {
    "approach": "Use a recursive approach to solve the Tower of Hanoi problem.",
    "timeComplexity": "O(2^n)",
    "spaceComplexity": "O(n)",
    "code": {
      "C": "#include <stdio.h>\nint hanoi(int n) {\n    if (n == 1) return 1;\n    return 2 * hanoi(n - 1) + 1;\n}\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    printf(\"%d\\n\", hanoi(n));\n    return 0;\n}",
      "C++": "#include <iostream>\nint hanoi(int n) {\n    if (n == 1) return 1;\n    return 2 * hanoi(n - 1) + 1;\n}\nint main() {\n    int n;\n    std::cin >> n;\n    std::cout << hanoi(n) << std::endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Hanoi {\n    public static int hanoi(int n) {\n        if (n == 1) return 1;\n        return 2 * hanoi(n - 1) + 1;\n    }\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        System.out.println(hanoi(n));\n    }\n}",
      "Python3": "def hanoi(n):\n    if n == 1:\n        return 1\n    return 2 * hanoi(n - 1) + 1\nn = int(input())\nprint(hanoi(n))",
      "JavaScript": "function hanoi(n) {\n    if (n == 1) return 1;\n    return 2 * hanoi(n - 1) + 1;\n}\nconst readline = require('readline');\nconst rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nrl.on('line', (input) => {\n    const n = parseInt(input);\n    console.log(hanoi(n));\n});"
    },
