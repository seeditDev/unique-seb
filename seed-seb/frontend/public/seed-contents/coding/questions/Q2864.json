  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy, partition\nclass Solution(object):\n    def maximumOddBinaryNumber(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        a = list(s)\n        left = 0\n        for i in range(len(a)):\n            if a[i] != '1':\n                continue\n            a[i], a[left] = a[left], a[i]\n            left += 1\n        if a[-1] != '1':\n            a[-1], a[left-1] = a[left-1], a[-1]\n        return \"\".join(a)"
    },
