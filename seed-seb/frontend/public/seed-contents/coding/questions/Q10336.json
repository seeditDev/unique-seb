    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\n2\n3\n838",
        "output": "2\n16\n839372959",
        "explanation": "Explanation:\nTest case 111: The possible strings are {\"00\",\"01\",\"10\",\"11\"}\\{\"00\", \"01\", \"10\", \"11\"\\}{\"00\",\"01\",\"10\",\"11\"}.\n\nThe sqing value for \"00\"\"00\"\"00\" is 000.\nThe sqing value for \"01\"\"01\"\"01\" is 111 (for i=2i = 2i=2, we find j=1j = 1j=1).\nThe sqing value for \"10\"\"10\"\"10\" is 111 (for i=2i = 2i=2, we find j=1j = 1j=1).\nThe sqing value for \"11\"\"11\"\"11\" is 000.\n\nHence, the answer to this test case is 222.\nTest case 222: There are 888 binary strings of length 333.\n\nThe sqing value for \"000\"\"000\"\"000\" is 000\nThe sqing value for \"001\"\"001\"\"001\" is 111\nThe sqing value for \"010\"\"010\"\"010\" is 222\nThe sqing value for \"011\"\"011\"\"011\" is 555\nThe sqing value for \"100\"\"100\"\"100\" is 555\nThe sqing value for \"101\"\"101\"\"101\" is 222\nThe sqing value for \"110\"\"110\"\"110\" is 111\nThe sqing value for \"111\"\"111\"\"111\" is 000\n\nHence, the answer to this test case is 161616."
      }
    ]
