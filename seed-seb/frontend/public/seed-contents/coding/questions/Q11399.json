  "content": {
    "problemStatement": "Write a program for the coding challenge \"Check if a tree is a BST or not\". Refer to LeetCode description: https://leetcode.com/problems/validate-binary-search-tree/",
    "constraints": [
      "1 <= Number of nodes <= 100",
      "0 <= Node.val <= 10^4",
      "Each node's value is unique"
    ],
    "inputFormat": "The input is the root of a binary tree where each node has a unique value.",
    "outputFormat": "A boolean indicating whether the binary tree is a valid binary search tree (BST).",
    "notes": [],
    "sampleTestCases": []
