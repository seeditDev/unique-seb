  "solution": {
    "approach": "Recursion or Iteration with In-Order Traversal",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(H) where H is the height of the tree",
    "code": {
      "C": "\n         #include <stdio.h>\n         #include <stdlib.h>\n         \n         struct TreeNode {\n            int val;\n            struct TreeNode *left;\n            struct TreeNode *right;\n         };\n         \n         bool isValidBST(struct TreeNode* root) {\n            long long prev = -1e18;\n            return inOrder(root, &prev);\n         }\n         \n         bool inOrder(struct TreeNode* root, long long* prev) {\n            if (!root) return true;\n            if (!inOrder(root->left, prev)) return false;\n            if (*prev >= root->val) return false;\n            *prev = root->val;\n            return inOrder(root->right, prev);\n         }\n      ",
      "C++": "\n         #include <iostream>\n         #include <climits>\n         \n         struct TreeNode {\n            int val;\n            TreeNode *left;\n            TreeNode *right;\n            TreeNode(int x) : val(x), left(NULL), right(NULL) {}\n         };\n         \n         class Solution {\n         public:\n            bool isValidBST(TreeNode* root) {\n               long long prev = LLONG_MIN;\n               return inOrder(root, prev);\n            }\n            \n            bool inOrder(TreeNode* root, long long& prev) {\n               if (!root) return true;\n               if (!inOrder(root->left, prev)) return false;\n               if (prev >= root->val) return false;\n               prev = root->val;\n               return inOrder(root->right, prev);\n            }\n         };\n      ",
      "Java": "\n         class Solution {\n            public boolean isValidBST(TreeNode root) {\n               long[] prev = new long[] {Long.MIN_VALUE};\n               return inOrder(root, prev);\n            }\n            \n            private boolean inOrder(TreeNode root, long[] prev) {\n               if (root == null) return true;\n               if (!inOrder(root.left, prev)) return false;\n               if (prev[0] >= root.val) return false;\n               prev[0] = root.val;\n               return inOrder(root.right, prev);\n            }\n         }\n      ",
      "Python3": "\n         class Solution:\n            def isValidBST(self, root: TreeNode) -> bool:\n               self.prev = float('-inf')\n               return self.inOrder(root)\n            \n            def inOrder(self, root):\n               if not root:\n                   return True\n               if not self.inOrder(root.left):\n                   return False\n               if self.prev >= root.val:\n                   return False\n               self.prev = root.val\n               return self.inOrder(root.right)\n      ",
      "JavaScript": "\n         var isValidBST = function(root) {\n            let prev = -Infinity;\n            return inOrder(root);\n            \n            function inOrder(root) {\n               if (!root) return true;\n               if (!inOrder(root.left)) return false;\n               if (prev >= root.val) return false;\n               prev = root.val;\n               return inOrder(root.right);\n            }\n         };\n      "
    },
