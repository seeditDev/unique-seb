  "solution": {
    "code": {
      "Python3": "# Time:  O(nlog(logm)), n the length of nums, m is the max value of nums\n# Space: O(logm)\n\nimport bisect\n\n\nclass Solution(object):\n    def __init__(self):\n        M = 10**5\n        self.__lookup = [0]\n        i = 10\n        while i < M:\n            self.__lookup.append(i)\n            i *= 10\n        self.__lookup.append(i)\n\n    def findNumbers(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def digit_count(n):\n            return bisect.bisect_right(self.__lookup, n)\n\n        return sum(digit_count(n) % 2 == 0 for n in nums)"
    },
