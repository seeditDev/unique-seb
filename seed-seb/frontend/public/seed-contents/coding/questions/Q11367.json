  "solution": {
    "approach": "To solve this problem, we can use a depth-first search (DFS) or breadth-first search (BFS) approach to traverse the graph and clone each node.",
    "timeComplexity": "O(N + M)",
    "spaceComplexity": "O(N)",
    "code": {
      "C": "\n         #include <stdio.h>\n         #include <stdlib.h>\n\n         typedef struct Node {\n            int val;\n            int numNeighbors;\n            struct Node** neighbors;\n         } Node;\n\n         Node* cloneGraph(Node* node) {\n            if (!node) return NULL;\n\n            Node* clone = (Node*)malloc(sizeof(Node));\n            clone->val = node->val;\n            clone->numNeighbors = node->numNeighbors;\n            clone->neighbors = (Node**)malloc(sizeof(Node*) * node->numNeighbors);\n\n            for (int i = 0; i < node->numNeighbors; i++) {\n               clone->neighbors[i] = cloneGraph(node->neighbors[i]);\n            }\n\n            return clone;\n         }\n      ",
      "C++": "\n         #include <iostream>\n         #include <vector>\n\n         class Node {\n         public:\n            int val;\n            std::vector<Node*> neighbors;\n\n            Node() {\n               val = 0;\n               neighbors = std::vector<Node*>(0);\n            }\n\n            Node(int _val, std::vector<Node*> _neighbors) {\n               val = _val;\n               neighbors = _neighbors;\n            }\n\n            Node* cloneGraph(Node* node) {\n               if (!node) return NULL;\n\n               Node* clone = new Node();\n               clone->val = node->val;\n\n               for (Node* neighbor : node->neighbors) {\n                  clone->neighbors.push_back(cloneGraph(neighbor));\n               }\n\n               return clone;\n            }\n         };\n      ",
