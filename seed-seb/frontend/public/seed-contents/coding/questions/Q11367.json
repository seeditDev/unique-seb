  "content": {
    "problemStatement": "Write a program for the coding challenge \"Clone Graph\". Refer to LeetCode description: https://leetcode.com/problems/clone-graph/",
    "constraints": [
      "1 <= Node.val <= 100",
      "Node.val is unique for each node.",
      "Number of nodes will not exceed 100",
      "1 <= Node.neighbors.length <= 100"
    ],
    "inputFormat": "The input is a graph represented as an adjacency list, where each node is an instance of the Node class with a val and a list of its neighbors.",
    "outputFormat": "The output is the cloned graph, where each node is a new instance of the Node class with the same val and neighbors as the corresponding node in the original graph.",
    "notes": [],
    "sampleTestCases": []
  },
