  "content": {
    "problemStatement": "Chef wants to visit a fair, but there is an age restriction for entry. A person can attend the fair if their age is **greater than or equal** to 101010 years.\n\nYou are given Chef's age, represented by the integer XXX. Your task is to determine whether Chef is eligible to attend the fair or not.\n\n\nIf Chef's age is greater than or equal to 10, print \"YES\".\nOtherwise, print \"NO\".\n\nInput Format\nA single integer XXX, representing Chef's age.\n\n\n\nOutput Format\nPrint `YES` if Chef is eligible to attend the fair , otherwise print `NO`.\n\n\nYou may print each character of the string in uppercase or lowercase (for example, the strings `YES`, `yEs`, `yes`, and `yeS` will all be treated as identical).",
    "constraints": [
      "1≤X≤201 \\leq X \\leq 201≤X≤20"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "10",
        "output": "YES",
        "explanation": "Explanation:\nSince Chef is 101010 years old, which is the minimum age required to attend the fair, he can attend the fair."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "9",
        "output": "NO",
        "explanation": "Explanation:\nSince Chef is 999 years old, which is below the minimum age required to attend the fair, he cannot attend the fair."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "11",
        "output": "YES",
        "explanation": "Explanation:\nSince Chef is 111111 years old, which is above the minimum age required to attend the fair, he can attend the fair."
      }
    ]
  },
