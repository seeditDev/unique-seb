  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# bitmasks\nclass Solution(object):\n    def kthCharacter(self, k):\n        \"\"\"\n        :type k: int\n        :rtype: str\n        \"\"\"\n        def popcount(x):\n            return bin(x)[2:].count('1')\n\n        return chr(ord('a')+popcount(k-1)%26)"
    },
