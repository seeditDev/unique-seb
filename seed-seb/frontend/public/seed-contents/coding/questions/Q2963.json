  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table, combinatorics\nclass Solution(object):\n    def numberOfGoodPartitions(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        MOD = 10**9+7\n        lookup = {x:i for i, x in enumerate(nums)}\n        result = 1\n        right = cnt = 0\n        for left, x in enumerate(nums):\n            if left == right+1:\n                cnt += 1\n            right = max(right, lookup[x])\n        return pow(2, cnt, MOD)"
    },
