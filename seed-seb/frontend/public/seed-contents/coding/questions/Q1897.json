  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    def makeEqual(self, words):\n        \"\"\"\n        :type words: List[str]\n        :rtype: bool\n        \"\"\"\n        cnt = collections.defaultdict(int)\n        for w in words:\n            for c in w:\n                cnt[c] += 1\n        return all(v%len(words) == 0 for v in cnt.itervalues())"
    },
