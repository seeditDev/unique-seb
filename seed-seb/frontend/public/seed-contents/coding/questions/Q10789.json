  "content": {
    "problemStatement": "**Code-mat** is an annual programming competition organized by the **Mathematics and Computing Society (MACS)** at **IIT BHU**. Last year, the event had XXX participants, while this year it attracted YYY participants. Determine whether this year's event was more successful by checking if YYY is greater than XXX. If it was more successful, print Yes. Otherwise, print No.\n\n\nInput Format\nThe input consists of two space-separated integers XXX and YYY, where:\n\n\n\nXXX  denotes the number of participants last year.\nYYY denotes the number of participants this year.\n\n\nOutput Format\nPrint `YES` if this year's event had more participants than last year, otherwise print `NO`.\n\n\nYou may print each character of the string in uppercase or lowercase (for example, the strings `YES`, `yEs`, `yes`, and `yeS` will all be treated as identical).",
    "constraints": [
      "1≤X≤10001 \\leq X \\leq 10001≤X≤1000",
      "1≤Y≤10001 \\leq Y \\leq 10001≤Y≤1000"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "234 643",
        "output": "Yes",
        "explanation": "Explanation:\nSince this year's event attracted more participants and was more successful, so the answer is Yes."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "976 899",
        "output": "No",
        "explanation": "Explanation:\nSince fewer participants attended this year compared to last year, so the answer is No."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "250 250",
        "output": "No",
        "explanation": "Explanation:\nThis year's event was not more successful than the previous year, as the number of participants remained the same. So, the answer is No."
      }
    ]
  },
