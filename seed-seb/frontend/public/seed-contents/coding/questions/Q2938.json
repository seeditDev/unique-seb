  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# two pointers\nclass Solution(object):\n    def minimumSteps(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = left = 0\n        for right in range(len(s)):\n            if s[right] != '0':\n                continue\n            result += right-left\n            left += 1\n        return result"
    },
