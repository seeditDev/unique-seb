  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nclass Solution(object):\n    def hIndex(self, citations):\n        \"\"\"\n        :type citations: List[int]\n        :rtype: int\n        \"\"\"\n        n = len(citations)\n        count = [0] * (n + 1)\n        for x in citations:\n            # Put all x >= n in the same bucket.\n            if x >= n:\n                count[n] += 1\n            else:\n                count[x] += 1\n\n        h = 0\n        for i in reversed(range(0, n + 1)):\n            h += count[i]\n            if h >= i:\n                return i\n        return h"
    },
