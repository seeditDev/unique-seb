  "content": {
    "problemStatement": "Declare a variable **\"temperature\"** and initialise it with a value of **25.5** (in Celsius) and Print it in Celsius and Kelvin(add 273 to temperature in Celsius). [**Note:** print the output exactly in the same format as given below.]",
    "constraints": [
      "No constraints."
    ],
    "inputFormat": "No input required.",
    "outputFormat": "Print the temperature in Celsius and Kelvin on a single line, separated by two spaces, exactly as: \"Celsius - x.x  Kelvin - y.y\" where x.x is the Celsius value with one decimal place and y.y is the Kelvin value with one decimal place.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "",
        "output": "Celsius - 25.5  Kelvin - 298.7",
        "explanation": "The constant Celsius value is 25.5. Adding 273.15 gives 298.65, which rounds to one decimal place as 298.7."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "",
        "output": "Celsius - 25.5  Kelvin - 298.7",
        "explanation": "Repeated sample to illustrate that the program always prints the same result because there is no input."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "",
        "output": "Celsius - 25.5  Kelvin - 298.7",
        "explanation": "Another identical case confirming deterministic output."
      }
    ]
