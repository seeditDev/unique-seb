  "content": {
    "problemStatement": "Write a program for the coding challenge \"Decoding Genome\". Refer to LeetCode description: https://codeforces.com/contest/222/problem/E",
    "constraints": [
      "1 <= n <= 100000",
      "The genome string only contains the characters 'A', 'C', 'G', and 'T'."
    ],
    "inputFormat": "The first line contains an integer n, which is the length of the genome. The second line contains a string of length n, representing the genome.",
    "outputFormat": "The decoded genome as a string.",
    "notes": [],
    "sampleTestCases": []
