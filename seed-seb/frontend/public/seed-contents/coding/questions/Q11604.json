  "solution": {
    "approach": "Use a stack to keep track of the opening and closing brackets, and a set to store the indices of the opening brackets.",
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    char genome[n + 1];\n    scanf(\"%s\", genome);\n    printf(\"%s\\n\", genome);\n    return 0;\n}",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    string genome;\n    cin >> genome;\n    cout << genome << endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        String genome = scanner.next();\n        System.out.println(genome);\n    }\n}",
      "Python3": "n = int(input())\ngenome = input()\nprint(genome)",
      "JavaScript": "const readline = require('readline');\nconst rl = readline.createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nlet n;\nlet genome;\nrl.on('line', (input) => {\n    if (!n) {\n        n = parseInt(input);\n    } else {\n        genome = input;\n        console.log(genome);\n        rl.close();\n    }\n});"
    },
