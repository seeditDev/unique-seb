  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def minSwaps(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        def cost(s, x): \n            diff = 0 \n            for c in s:\n                diff += int(c) != x\n                x ^= 1\n            return diff//2\n    \n        ones = s.count('1')\n        zeros = len(s)-ones \n        if abs(ones-zeros) > 1:\n            return -1\n        if ones > zeros:\n            return cost(s, 1)\n        if ones < zeros:\n            return cost(s, 0)\n        return min(cost(s, 1), cost(s, 0))"
    },
