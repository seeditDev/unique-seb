  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# two pointers\nclass Solution(object):\n    def findTheLongestBalancedSubstring(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = 0\n        for i in range(len(s)):\n            left, right = i+1, i\n            while left-1 >= 0 and right+1 < len(s) and s[left-1] == '0' and s[right+1] == '1':\n                left -= 1\n                right += 1\n            result = max(result, right-left+1)\n        return result"
    },
