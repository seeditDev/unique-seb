    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "t = int(input())\n\nfor _ in range(t):\n    n = int(input())\n\n    if n < 2:\n        print(\"no\")\n        continue\n\n    is_prime = True\n    for i in range(2, n):   # full loop, no sqrt\n        if n % i == 0:\n            is_prime = False\n            break\n\n    if is_prime:\n        print(\"yes\")\n    else:\n        print(\"no\")\n",
