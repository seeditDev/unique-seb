  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nint solve(int n) {\n    vector<int> dp(n + 1);\n    \n    // Base case: fill with number of A's possible by just pressing A\n    for(int i = 0; i <= n; i++) {\n        dp[i] = i;\n    }\n    \n    // For each length\n    for(int i = 3; i <= n; i++) {\n        // Try breaking at different positions\n        for(int j = 2; j < i - 1; j++) {\n            // dp[j-1] represents A's before break\n            // (i-j) represents number of times we can paste\n            dp[i] = max(dp[i], dp[j-1] * (i-j));\n        }\n    }\n    \n    return dp[n];\n}\n\nint main() {\n    int t;\n    cin >> t;\n    while(t--) {\n        int n;\n        cin >> n;\n        cout << solve(n) << endl;\n    }\n    return 0;\n}",
