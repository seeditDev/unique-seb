  "content": {
    "problemStatement": "Q6) A . Write different types of searching and sorting techniques. Explain Binary search in detail ?   ---3 Marks.",
    "constraints": [
      "1 <= T <= 10",
      "Each string length <= 100 characters"
    ],
    "inputFormat": "The first line contains an integer T (1 ≤ T ≤ 10), the number of test cases. Each of the next T lines contains a string (up to 100 characters) which may include spaces. The line may be empty.",
    "outputFormat": "Print the T strings in the same order, each on its own line, exactly as they were read.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\nBinary Search\nLinear Search\nBubble Sort",
        "output": "Binary Search\nLinear Search\nBubble Sort",
        "explanation": "The program reads T=3 and echoes each of the three technique names on its own line."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2\nMerge Sort\nQuick Sort",
        "output": "Merge Sort\nQuick Sort",
        "explanation": "T=2, the two sorting technique names are printed unchanged."
      },
