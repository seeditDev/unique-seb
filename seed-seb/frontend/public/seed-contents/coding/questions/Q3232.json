  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# brute force, game theory\nclass Solution(object):\n    def canAliceWin(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        total1 = total2 = 0\n        for x in nums:\n            if x < 10:\n                total1 += x\n            else:\n                total2 += x\n        return total1 != total2"
    },
