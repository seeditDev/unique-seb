  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\nimport itertools\n\n\nclass Solution(object):\n    def largestTimeFromDigits(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: str\n        \"\"\"\n        result = \"\"\n        for i in range(len(A)):\n            A[i] *= -1\n        A.sort()\n        for h1, h2, m1, m2 in itertools.permutations(A):\n            hours = -(10*h1 + h2)\n            mins = -(10*m1 + m2)\n            if 0 <= hours < 24 and 0 <= mins < 60:\n                result = \"{:02}:{:02}\".format(hours, mins)\n                break\n        return result"
    },
