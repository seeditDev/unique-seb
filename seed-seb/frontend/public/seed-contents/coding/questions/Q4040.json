  "content": {
    "problemStatement": "Write a C program to find maximum between two numbers using switch case statement.\n\n\nInput Format\n\nThe first and only line of input contains two space separated integers.\n\n\nOutput Format\n\nOutput the maximum of two input integers.",
    "constraints": [
      "1 <= T <= 100",
      "1 <= a, b <= 1000"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains two space-separated integers a and b.",
    "outputFormat": "For each test case, print the maximum of a and b on a new line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n3 4\n",
        "output": "4\n",
        "explanation": "Only one test case. The larger of 3 and 4 is 4."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n7 2\n",
        "output": "7\n",
        "explanation": "Only one test case. The larger of 7 and 2 is 7."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n10 10\n",
        "output": "10\n",
        "explanation": "Both numbers are equal, so the maximum is 10."
      }
    ]
  },
