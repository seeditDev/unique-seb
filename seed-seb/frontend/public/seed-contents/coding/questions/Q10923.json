    "spaceComplexity": "",
    "code": {
      "C": "#include <stdio.h>\n\nint main() {\n    int n, m;\n    scanf(\"%d %d\", &n, &m);\n    int A[n][m];\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < m; j++) {\n            scanf(\"%d\", &A[i][j]);\n        }\n    }\n\n    int p, q;\n    scanf(\"%d %d\", &p, &q);\n    int B[p][q];\n    for (int i = 0; i < p; i++) {\n        for (int j = 0; j < q; j++) {\n            scanf(\"%d\", &B[i][j]);\n        }\n    }\n\n    if (m != p) {\n        printf(\"-1\\n\");\n        return 0;\n    }\n\n    int C[n][q];\n\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < q; j++) {\n            int sum = 0;\n            for (int k = 0; k < m; k++) {\n                sum += A[i][k] * B[k][j];\n            }\n            C[i][j] = sum;\n        }\n    }\n\n    for (int i = 0; i < n; i++) {\n        for (int j = 0; j < q; j++) {\n            printf(\"%d \", C[i][j]);\n        }\n        printf(\"\\n\");\n    }\n\n    return 0;\n}\n",
