  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# two pointers\nclass Solution(object):\n    def clearDigits(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        s = list(s)\n        j = 0\n        for i, x in enumerate(s):\n            if x.isdigit():\n                j -= 1\n                continue\n            s[j] = x\n            j += 1\n        while len(s) > j:\n            s.pop()\n        return \"\".join(s)"
    },
