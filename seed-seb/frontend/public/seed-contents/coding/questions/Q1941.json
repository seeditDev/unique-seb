  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    def areOccurrencesEqual(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: bool\n        \"\"\"\n        return len(set(collections.Counter(s).itervalues())) == 1"
    },
