  "content": {
    "problemStatement": "Go through the code in your editor slowly to see what’s causing the problem and fix it.\n\nFor a given integer, we need to print an integer twice the input. \n\nCheck the sample input / output below for further clarity.",
    "constraints": [
      "1 <= T <= 1000",
      "0 <= N <= 1000"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single integer N.",
    "outputFormat": "For each test case, print a single line containing the value 2 × N.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n10",
        "output": "20",
        "explanation": "N is 10, doubling gives 20."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n5",
        "output": "10",
        "explanation": "N is 5, doubling gives 10."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n0",
        "output": "0",
        "explanation": "N is 0, doubling gives 0."
      }
    ]
  },
