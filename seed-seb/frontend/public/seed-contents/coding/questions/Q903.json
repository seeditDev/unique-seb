  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(n)\n\nclass Solution(object):\n    def numPermsDISequence(self, S):\n        \"\"\"\n        :type S: str\n        :rtype: int\n        \"\"\"\n        dp = [1]*(len(S)+1)\n        for c in S:\n            if c == \"I\":\n                dp = dp[:-1]\n                for i in range(1, len(dp)):\n                    dp[i] += dp[i-1]\n            else:\n                dp = dp[1:]\n                for i in reversed(range(len(dp)-1)):\n                    dp[i] += dp[i+1]\n        return dp[0] % (10**9+7)"
    },
