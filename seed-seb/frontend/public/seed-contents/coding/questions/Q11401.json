  "content": {
    "problemStatement": "Write a program for the coding challenge \"LCA in BST\". Refer to LeetCode description: https://leetcode.com/problems/lowest-common-ancestor-of-a-binary-search-tree/",
    "constraints": [
      "1 <= number of nodes <= 10^5",
      "1 <= Node.val <= 10^6",
      "All Node.val are unique.",
      "p != q",
      "p and q will exist in the BST."
    ],
    "inputFormat": "The input will be the root of a binary search tree and two nodes, p and q.",
    "outputFormat": "The output will be the lowest common ancestor of p and q.",
    "notes": [],
    "sampleTestCases": []
  },
