  "content": {
    "problemStatement": "Write a C++ program to:\n\n\nCreate a class `Number`\nData member: value\nOverload + operator to add two objects\nDisplay result in `main()`",
    "constraints": [
      "1 <= T <= 1000",
      "1 <= a <= 1000",
      "1 <= b <= 1000"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains two space-separated integers a and b.",
    "outputFormat": "For each test case, print the sum of a and b on a new line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\n5 7\n10 20\n100 200\n",
        "output": "12\n30\n300\n",
        "explanation": "Three test cases are processed. 5+7=12, 10+20=30, 100+200=300."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n1 1\n",
        "output": "2\n",
        "explanation": "Only one test case: 1+1=2."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "2\n2 3\n4 5\n",
        "output": "5\n9\n",
        "explanation": "First case 2+3=5, second case 4+5=9."
      }
    ]
  },
