  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# dp\nclass Solution(object):\n    def maximumLength(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :type k: int\n        :rtype: int\n        \"\"\"\n        k = 2\n        result = 0\n        for i in range(k):\n            dp = [0]*k\n            for x in nums:\n                dp[x%k] = dp[(i-x)%k]+1\n            result = max(result, max(dp))\n        return result"
    },
