  "content": {
    "problemStatement": "Write a program that calculates and prints the results of arithmetic operations such as addition, subtraction, division, and multiplication between the numbers 888 and 444.",
    "constraints": [
      "1 <= a, b <= 1000",
      "a and b are integers"
    ],
    "inputFormat": "No input required.",
    "outputFormat": "Four lines, each containing the result of an arithmetic operation between 888 and 444 in this order: addition, subtraction, division (exactly two digits after the decimal point), multiplication.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "",
        "output": "1332\n444\n2.00\n394272\n",
        "explanation": "888 + 444 = 1332, 888 - 444 = 444, 888 / 444 = 2.00 (two decimal places), 888 * 444 = 394272."
      },
      {
        "id": "sample_2",
        "type": "reg",
