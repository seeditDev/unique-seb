  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "// Solution as follows\n\n#include <stdio.h>\n\nint main() {\n    int N, sum = 0;\n    scanf(\"%d\", &N);\n    int i = 0;      // i had not been declared and initialised\n\n    while (i <= N) {\n        sum += i;\n        i++;\n    };\n    \n    printf(\"%d\", sum);\n    return 0;\n}",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nint main() {\n    int n;\n    cin >> n;\n    int sum = 0;\n    int i = 1;\n    while (i <= n) {\n        sum = sum + i;\n        i++;\n    }\n    cout << sum << endl;\n}",
      "Java": "// Solution as follows.\nimport java.util.Scanner;\n\nclass Codechef\n{\n    public static void main (String[] args) \n    {\n        Scanner scanner = new Scanner(System.in);\n\n        int N, sum = 0;\n        N = scanner.nextInt();\n        int i = 0; // i had not been declared and initialized\n\n        while (i <= N) {\n            sum += i;\n            i++;\n        }\n        System.out.println(sum);\n    }\n}\n",
      "Python3": "# Solution as follows\n\nn = int(input())\nsum = 0\ni = 1\n\nwhile i <= n:\n    sum = sum + i\n    i = i+1\n    \nprint(sum)",
      "JavaScript": "// Solution as follows\n\n#include <stdio.h>\n\nint main() {\n    int N, sum = 0;\n    scanf(\"%d\", &N);\n    int i = 0;      // i had not been declared and initialised\n\n    while (i <= N) {\n        sum += i;\n        i++;\n    };\n    \n    printf(\"%d\", sum);\n    return 0;\n}"
