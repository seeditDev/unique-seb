  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\n# sort, greedy\nclass Solution(object):\n    def minimizeSum(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        nums.sort()\n        return min(nums[-3+i]-nums[i] for i in range(3))"
    },
