  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def maximumProduct(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        min1, min2 = float(\"inf\"), float(\"inf\")\n        max1, max2, max3 = float(\"-inf\"), float(\"-inf\"), float(\"-inf\")\n\n        for n in nums:\n            if n <= min1:\n                min2 = min1\n                min1 = n\n            elif n <= min2:\n                min2 = n\n\n            if n >= max1:\n                max3 = max2\n                max2 = max1\n                max1 = n\n            elif n >= max2:\n                max3 = max2\n                max2 = n\n            elif n >= max3:\n                max3 = n\n\n        return max(min1 * min2 * max1, max1 * max2 * max3)"
    },
