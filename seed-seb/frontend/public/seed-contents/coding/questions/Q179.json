  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\nclass Solution(object):\n    # @param num, a list of integers\n    # @return a string\n    def largestNumber(self, num):\n        num = [str(x) for x in num]\n        num.sort(cmp=lambda x, y: cmp(y + x, x + y))\n        largest = ''.join(num)\n        return largest.lstrip('0') or '0'"
    },
