  "solution": {
    "approach": "The problem does not require any computation. The program simply prints the two required lines. No input is read. This runs in constant time and uses O(1) extra space.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main(void) {\n    printf(\"Hello\\n\");\n    printf(\"CodeChef!\\n\");\n    return 0;\n}",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    cout << \"Hello\" << '\\n';\n    cout << \"CodeChef!\" << '\\n';\n    return 0;\n}",
      "Java": "import java.io.*;\npublic class Main {\n    public static void main(String[] args) throws IOException {\n        BufferedWriter bw = new BufferedWriter(new OutputStreamWriter(System.out));\n        bw.write(\"Hello\\n\");\n        bw.write(\"CodeChef!\\n\");\n        bw.flush();\n    }\n}",
      "Python3": "import sys\nsys.stdout.write(\"Hello\\nCodeChef!\\n\")",
      "JavaScript": "const fs = require('fs');\nprocess.stdout.write('Hello\\nCodeChef!\\n');"
    },
