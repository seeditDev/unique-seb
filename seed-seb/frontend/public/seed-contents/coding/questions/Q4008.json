  "content": {
    "problemStatement": "Write a C program which uses a single string variable to print\n\n`Hello\nCodeChef!\n`",
    "constraints": [
      "The output must be exactly two lines.",
      "The first line must be 'Hello'.",
      "The second line must be 'CodeChef!'."
    ],
    "inputFormat": "No input required.",
    "outputFormat": "Print exactly two lines: first line 'Hello', second line 'CodeChef!' (including the exclamation mark).",
    "notes": [],
