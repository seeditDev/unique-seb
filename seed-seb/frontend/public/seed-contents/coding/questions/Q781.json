  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def numRabbits(self, answers):\n        \"\"\"\n        :type answers: List[int]\n        :rtype: int\n        \"\"\"\n        count = collections.Counter(answers)\n        return sum((((k+1)+v-1)//(k+1))*(k+1) for k, v in count.iteritems())"
    },
