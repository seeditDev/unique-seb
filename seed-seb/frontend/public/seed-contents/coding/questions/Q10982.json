    "spaceComplexity": "",
    "code": {
      "C": "#include <stdio.h>\n#include <string.h>\n\nint main() {\n    int t;\n    scanf(\"%d\", &t);\n\n    char s[1005], p[1005], result[2100];\n    int pos;\n\n    while (t--) {\n        scanf(\"%s %s\", s, p);\n        scanf(\"%d\", &pos);\n\n        int lenS = strlen(s);\n\n        strncpy(result, s, pos - 1);\n        result[pos - 1] = '\\0';\n\n        strcat(result, p);\n        strcat(result, s + (pos - 1));\n\n        printf(\"%s\\n\", result);\n    }\n\n    return 0;\n}",
