  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\n# sort\nclass Solution(object):\n    def numberGame(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        nums.sort()\n        for i in range(0, len(nums), 2):\n            nums[i], nums[i+1] = nums[i+1], nums[i]\n        return nums"
    },
