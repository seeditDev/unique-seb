  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# bit manipulation\nclass Solution(object):\n    def longestSubarray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        mx = max(nums)\n        result, l = 1, 0\n        for x in nums:\n            if x == mx:\n                l += 1\n                result = max(result, l)\n            else:\n                l = 0\n        return result"
    },
