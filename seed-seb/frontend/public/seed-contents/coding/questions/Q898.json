  "solution": {
    "code": {
      "Python3": "# Time:  O(32 * n)\n# Space: O(1)\n\nclass Solution(object):\n    def subarrayBitwiseORs(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        result, curr = set(), {0}\n        for i in A:\n            curr = {i} | {i | j for j in curr}\n            result |= curr\n        return len(result)"
    },
