  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\nclass Solution(object):\n    def getMaximumConsecutive(self, coins):\n        \"\"\"\n        :type coins: List[int]\n        :rtype: int\n        \"\"\"\n        coins.sort()\n        result = 1\n        for c in coins:\n            if c > result:\n                break\n            result += c\n        return result"
    },
