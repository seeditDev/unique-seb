  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def uniqueOccurrences(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: bool\n        \"\"\"\n        count = collections.Counter(arr)\n        lookup = set()\n        for v in count.itervalues():\n            if v in lookup:\n                return False\n            lookup.add(v)\n        return True"
    },
