  "solution": {
    "code": {
      "Python3": "# Time:  O(logr)\n# Space: O(1)\n\n# hash table, bit manipulations\nclass Solution(object):\n    def minImpossibleOR(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        lookup = set(nums)\n        return next(1<<i for i in range(31) if 1<<i not in lookup)"
    },
