  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def isTrionic(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        p = 0\n        while p+1 < len(nums) and nums[p] < nums[p+1]:\n            p += 1\n        q = p\n        while q+1 < len(nums) and nums[q] > nums[q+1]:\n            q += 1\n        i = q\n        while i+1 < len(nums) and nums[i] < nums[i+1]:\n            i += 1\n        return 0 < p < q < i == len(nums)-1"
    },
