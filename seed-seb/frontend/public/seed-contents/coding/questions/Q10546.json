  "content": {
    "problemStatement": "Chef is trying to buy a Diwali gift for Rs. AAA, and he has a voucher for Rs. BBB. Chef will have to pay the remaining amount after applying the voucher. If the voucher's value exceeds the gift's value, Chef will not have to pay anything.\n\nFind the amount that Chef will pay for buying the gift.\n\n\nInput Format\n\nThe first and only line of input contains 222 integers - AAA and BBB.\n\n\nOutput Format\nFor each test case, output on a new line the amount paid by Chef.",
    "constraints": [
      "1≤A,B≤50001 \\le A, B \\le 50001≤A,B≤5000"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3000 1000",
        "output": "2000",
        "explanation": "Explanation:\nChef is trying to buy a gift of Rs. 300030003000, and his voucher is of Rs. 100010001000. Thus, he still has to pay 3000−1000=3000 - 1000 = 3000−1000= Rs. 200020002000."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1000 5000",
        "output": "0",
        "explanation": "Explanation:\nChef's voucher value exceeds the gift value, so he has to pay nothing."
      }
    ]
  },
