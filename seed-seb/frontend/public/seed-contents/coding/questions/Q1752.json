  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def check(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        count = 0\n        for i in range(len(nums)):\n            if nums[i] > nums[(i+1)%len(nums)]:\n                count += 1\n                if count > 1:\n                    return False\n        return True"
    },
