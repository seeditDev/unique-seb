  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def checkDivisibility(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: bool\n        \"\"\"\n        curr = n\n        total, product = 0, 1\n        while curr:\n            curr, r = divmod(curr, 10)\n            total += r\n            product *= r\n        return n%(total+product) == 0"
    },
