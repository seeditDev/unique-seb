  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def numDecodings(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        if len(s) == 0 or s[0] == '0':\n            return 0\n        prev, prev_prev = 1, 0\n        for i in range(len(s)):\n            cur = 0\n            if s[i] != '0':\n                cur = prev\n            if i > 0 and (s[i - 1] == '1' or (s[i - 1] == '2' and s[i] <= '6')):\n                cur += prev_prev\n            prev, prev_prev = cur, prev\n        return prev"
    },
