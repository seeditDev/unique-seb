  "content": {
    "problemStatement": "You receive two binary strings `a` and `b`, output *their sum as a binary string*.",
    "constraints": [
      "1 <= a.length, b.length <= 10^4:",
      "a and b consist only of characters '0' or '1'.",
      "Each string does not contain leading zeros except for the string \"0\"."
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "[\"11\",\"1\"]",
        "output": "\"100\"",
        "explanation": "For this input, applying the required rules of Add Binary produces \"100\"."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "[\"1010\",\"1011\"]",
        "output": "\"10101\"",
        "explanation": "For this input, applying the required rules of Add Binary produces \"10101\"."
      }
    ]
  },
