  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogr), r = max(nums)\n# Space: O(n)\n\n# hash table   \nclass Solution(object):\n    def countDistinctIntegers(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def reverse(n):\n            result = 0\n            while n:\n                result = result*10 + n%10\n                n //= 10\n            return result\n\n        return len({y for x in nums for y in (x, reverse(x))})"
    },
