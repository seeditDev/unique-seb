  "solution": {
    "code": {
      "Python3": "# Time:  O(n), k is the number of distinct barcodes\n# Space: O(k)\n\nimport collections\nimport itertools\n\n\nclass Solution(object):\n    def rearrangeBarcodes(self, barcodes):\n        \"\"\"\n        :type barcodes: List[int]\n        :rtype: List[int]\n        \"\"\"\n        k = 2\n        cnts = collections.Counter(barcodes)\n        bucket_cnt = max(cnts.itervalues())\n        result = [0]*len(barcodes)\n        i = (len(barcodes)-1)%k\n        for c in itertools.chain((c for c, v in cnts.iteritems() if v == bucket_cnt), (c for c, v in cnts.iteritems() if v != bucket_cnt)):\n            for _ in range(cnts[c]):\n                result[i] = c\n                i += k\n                if i >= len(result):\n                    i = (i-1)%k\n        return result"
    },
