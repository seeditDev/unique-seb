    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\n4\n1 1 1 1\n1 1 1 1\n4\n1 -2 3 5\n3 1 -2 7\n4\n0 -3 4 0\n1 -4 3 1",
        "output": "YES\nNO\nYES",
        "explanation": "Explanation:\nTest case 111: Both the arrays are already same so no operation is needed.\nTest case 222: There is no sequence of operations using which array AAA can be transformed into array BBB .\nTest case 333: In this case, after applying the operation on index 222 the transformed array is [1,−4,3,1][1,-4,3,1][1,−4,3,1] which is same as array BBB ."
      }
