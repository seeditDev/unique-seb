  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def minSwaps(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = curr = 0\n        for c in s:\n            if c == ']':\n                curr += 1\n                result = max(result, curr)\n            else:\n                curr -= 1\n        return (result+1)//2"
    },
