  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def removePalindromeSub(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        def is_palindrome(s):\n            for i in range(len(s)//2):\n                if s[i] != s[-1-i]:\n                    return False\n            return True\n        \n        return 2 - is_palindrome(s) - (s == \"\")"
    },
