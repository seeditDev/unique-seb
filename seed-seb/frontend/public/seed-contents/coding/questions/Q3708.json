  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def longestSubarray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = cnt = 2\n        for i in range(2, len(nums)):\n            if nums[i] != nums[i-1]+nums[i-2]:\n                cnt = 2\n                continue\n            cnt += 1\n            result = max(result, cnt)\n        return result"
    },
