  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# bit manipulation\nclass Solution(object):\n    def evenOddBit(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: List[int]\n        \"\"\"\n        def popcount(x):\n            return bin(x)[2:].count('1')\n\n        return [popcount(n&0b0101010101), popcount(n&0b1010101010)]"
    },
