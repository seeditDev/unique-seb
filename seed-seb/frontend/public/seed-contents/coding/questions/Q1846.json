  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\nclass Solution(object):\n    def maximumElementAfterDecrementingAndRearranging(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: int\n        \"\"\"\n        arr.sort()\n        result = 1\n        for i in range(1, len(arr)):\n            result = min(result+1, arr[i])\n        return result"
    },
