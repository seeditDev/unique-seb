  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nfrom collections import defaultdict\n\nclass Solution(object):\n    def firstUniqChar(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        lookup = defaultdict(int)\n        candidtates = set()\n        for i, c in enumerate(s):\n            if lookup[c]:\n                candidtates.discard(lookup[c])\n            else:\n                lookup[c] = i+1\n                candidtates.add(i+1)\n\n        return min(candidtates)-1 if candidtates else -1"
    },
