  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def movesToMakeZigzag(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = [0, 0]\n        for i in range(len(nums)):\n            left = nums[i-1] if i-1 >= 0 else float(\"inf\")\n            right = nums[i+1] if i+1 < len(nums) else float(\"inf\")\n            result[i%2] += max(nums[i] - min(left, right) + 1, 0)\n        return min(result)"
    },
