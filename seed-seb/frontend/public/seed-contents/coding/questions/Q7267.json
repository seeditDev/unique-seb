  "content": {
    "problemStatement": "After successfully defending her title of World Chess Champion, Ada noticed that she is lacking in rook endgames.\n\nTo improve her endgame skills, Ada placed KKK kings on a chessboard with NNN rows and MMM columns, and now she is calculating the minimum number of rooks she must place on the board to satisfy the following conditions:\n\n\nNo king is attacked by a rook.\nThe kings are isolated, i.e. no king can reach another king without passing through a square attacked by a rook or capturing a rook.\nHelp Ada check her answers.",
    "constraints": [
      "1≤T≤1,0241 \\le T \\le 1,0241≤T≤1,024",
      "1≤N,M≤1,0241 \\le N, M \\le 1,0241≤N,M≤1,024",
      "each string contains only characters '.' and 'K'",
      "the sum of N⋅MN \\cdot MN⋅M over all test cases does not exceed 1,0241,0241,024"
    ],
    "inputFormat": "The first line of the input contains a single integer TTT denoting the number of test cases. The description of TTT test cases follows.\nThe first line of each test case contains two space-separated integers NNN and MMM.\nThe next NNN lines describe the chessboard. Each of these lines contains a string with length MMM describing one row, where an empty square and a square containing a king are denoted by '.' and 'K' respectively.",
    "outputFormat": "For each test case, print a single line containing one integer ― the minimum required number of rooks, or −1-1−1 if it is impossible to place rooks in a way that satisfies all conditions.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n8 8\n........\n........\n..K.....\n......K.\n........\n........\n.K..K...\n........",
        "output": "1",
        "explanation": "Explanation:\nExample case 1: One possible position for the only necessary rook is depicted in the following image."
      }
    ]
  },
