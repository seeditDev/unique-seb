  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# two pointers, combinatorics\nclass Solution(object):\n    def zeroFilledSubarray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        prev = -1\n        for i in range(len(nums)):\n            if nums[i]:\n                prev = i\n                continue\n            result += i-prev\n        return result"
    },
