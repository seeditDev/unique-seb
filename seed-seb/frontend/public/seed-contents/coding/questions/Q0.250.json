  "content": {
    "problemStatement": "Given an array containing both positive and negative integers , find the longest running positive sequence in an array.\n\nExample :\n\nInput : arr[]={1,2,-3,2,3,4,-6,1,2,3,4,5,-8,5,6}\n\nOutput: 5",
    "constraints": [
      "1 <= N <= 10^4"
    ],
    "inputFormat": "The input has the size and array elements.",
    "outputFormat": "Print the length of the longest positive subarray",
    "notes": [],
