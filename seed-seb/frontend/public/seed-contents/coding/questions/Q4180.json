  "content": {
    "problemStatement": "Given an integer **N**, Chef wants to find the smallest positive integer **M** such that the bitwise XOR of **M** and **M+1** is **N**. If no such **M** exists output **-1**.",
    "constraints": [
      "1 <= T <= 5000",
      "1 <= N <= 1073741824",
      "All values are integers"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single integer N.",
    "outputFormat": "For each test case, print the smallest positive integer M such that M XOR (M+1) equals N. If no such M exists, print -1. Each answer on its own line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n3",
        "output": "1",
        "explanation": "3 = 2^2 - 1, so M = (3-1)/2 = 1. 1 XOR 2 = 3."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2\n4\n5",
        "output": "-1\n-1",
        "explanation": "4 and 5 are not of the form 2^t - 1, therefore no positive M exists."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "3\n1\n2\n6",
        "output": "-1\n-1\n-1",
        "explanation": "1 would give M=0 which is not positive; 2 and 6 are not all-ones numbers."
      }
    ]
  },
