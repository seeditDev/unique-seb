  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def isValid(self, word):\n        \"\"\"\n        :type word: str\n        :rtype: bool\n        \"\"\"\n        VOWELS = \"aeiou\"\n\n        if len(word) < 3:\n            return False\n        vowel = consonant = False\n        for x in word:\n            if x.isalpha():\n                if x.lower() in VOWELS:\n                    vowel = True\n                else:\n                    consonant = True\n            elif not x.isdigit():\n                return False\n        return vowel and consonant"
    },
