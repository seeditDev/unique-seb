  "content": {
    "problemStatement": "Write a function named **calculatePower** that takes two integer, **base** and **exponent** respectively, and returns the result of raising **base** to the power of **exponent**.",
    "constraints": [
      "1 <= T <= 10",
      "1 <= base <= 100",
      "0 <= exponent <= 100"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains two space‑separated integers: base and exponent.",
    "outputFormat": "For each test case, output base raised to the power exponent on a separate line.",
    "notes": [],
    "sampleTestCases": [
