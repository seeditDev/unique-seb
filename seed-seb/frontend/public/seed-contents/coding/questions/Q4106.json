  "content": {
    "problemStatement": "Identify and correct the error in the following code",
    "constraints": [
      "1 <= T <= 10",
      "1 <= N <= 1000",
      "1 <= |S| <= 100",
      "S contains only letters (a‑z, A‑Z)"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each test case consists of two lines: the first line contains an integer N (unused), and the second line contains a non‑empty string S consisting only of English letters (a‑z, A‑Z).",
    "outputFormat": "For each test case, output a single line containing the number of letters in the given string S.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n1\nnumber",
        "output": "6",
        "explanation": "The string \"number\" has 6 letters."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n2\nNumber",
        "output": "6",
        "explanation": "The string \"Number\" has 6 letters (case does not matter)."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "2\n1\nnumber\n2\nNumber",
        "output": "6\n6",
        "explanation": "First test case: \"number\" → 6. Second test case: \"Number\" → 6."
      }
    ]
  },
