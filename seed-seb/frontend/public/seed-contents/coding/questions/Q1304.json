  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def sumZero(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: List[int]\n        \"\"\"\n        return [i for i in range(-(n//2), n//2+1) if not (i == 0 and n%2 == 0)]"
    },
