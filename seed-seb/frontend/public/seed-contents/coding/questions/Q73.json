  "content": {
    "problemStatement": "You receive an `m x n` integer matrix `matrix`, if an element is `0`, set its entire row and column to `0`'s.\n\nYou must do it [in place](https://en.wikipedia.org/wiki/In-place_algorithm).",
    "constraints": [
      "1 <= m, n <= 200",
      "-2^31 <= matrix[i][j] <= 2^31 - 1"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "[[[1,1,1],[1,0,1],[1,1,1]]]",
        "output": "[[1,0,1],[0,0,0],[1,0,1]]",
        "explanation": "For this input, applying the required rules of Set Matrix Zeroes produces [[1,0,1],[0,0,0],[1,0,1]]."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "[[[0,1,2,0],[3,4,5,2],[1,3,1,5]]]",
        "output": "[[0,0,0,0],[0,4,5,0],[0,3,1,0]]",
        "explanation": "For this input, applying the required rules of Set Matrix Zeroes produces [[0,0,0,0],[0,4,5,0],[0,3,1,0]]."
      }
    ]
  },
