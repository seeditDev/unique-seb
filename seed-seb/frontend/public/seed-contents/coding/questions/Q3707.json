  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# prefix sum\nclass Solution(object):\n    def scoreBalance(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: bool\n        \"\"\"\n        total = sum(ord(x)-ord('a')+1 for x in s)\n        prefix = 0\n        for x in s:\n            prefix += ord(x)-ord('a')+1\n            if prefix == total-prefix:\n                return True\n        return False"
    },
