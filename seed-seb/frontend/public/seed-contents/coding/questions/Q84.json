  "content": {
    "problemStatement": "You receive an array of integers `heights` representing the histogram's bar height where the width of each bar is `1`, output *the area of the largest rectangle in the histogram*.",
    "constraints": [
      "None"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
