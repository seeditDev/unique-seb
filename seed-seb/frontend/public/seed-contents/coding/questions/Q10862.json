    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "# Initialize the total score accumulator\ntotal_positive_score = 0\n\n# Read the first score from the user\nscore = int(input())  # Input score (or 0/negative to stop)\n\n# Loop as long as the score is positive\nwhile score > 0:\n    # Add the current score to the total\n    total_positive_score += score\n    \n    # Read the next score\n    score = int(input())  # Input score (or 0/negative to stop)\n\n# Print the final accumulated positive score\nprint(\"Total positive score:\", total_positive_score)\n",
