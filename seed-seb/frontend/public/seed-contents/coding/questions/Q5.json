  "content": {
    "problemStatement": "You receive a string s, output a longest contiguous substring that reads identically from left to right and right to left. If several substrings have the largest length, returning any one of them is valid.\n\nCharacter comparison is case-sensitive. A substring must occupy consecutive positions in s. Aim for O(n^2) time or better.",
    "constraints": [
      "1 <= s.length <= 1000",
      "s consists of ASCII letters (a-z, A-Z) and digits (0-9) only",
      "Return any one longest palindromic substring when multiple valid answers exist"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]. Example: [\"babad\"]",
    "outputFormat": "Single line: JSON-serialised return value (string). Example: \"bab\"",
    "notes": [
      "The judge accepts any substring that is a palindrome and has maximal length for the input.",
      "Do not perform case folding or remove non-alphanumeric characters; use the string as-is.",
      "If your solution returns any longest palindrome, it will be considered correct."
    ],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "[\"babad\"]",
        "output": "\"bab\"",
        "explanation": "The substring \"bab\" reads the same in both directions and has length 3. \"aba\" is another valid longest answer."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "[\"cbbd\"]",
        "output": "\"bb\"",
        "explanation": "The longest palindromic contiguous segment is \"bb\". No longer substring of \"cbbd\" is a palindrome."
      }
    ]
  },
