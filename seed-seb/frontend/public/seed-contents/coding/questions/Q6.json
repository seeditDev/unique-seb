  "boilerPlates": {
    "C": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nchar* convert(const char* s, int numRows) {\n    if (!s) return strdup(\"\");\n    int n = strlen(s);\n    if (numRows <= 1 || numRows >= n) return strdup(s);\n    int rowsCount = numRows < n ? numRows : n;\n    char **rows = malloc(sizeof(char*) * rowsCount);\n    int *sizes = calloc(rowsCount, sizeof(int));\n    int *caps = malloc(sizeof(int) * rowsCount);\n    for (int i = 0; i < rowsCount; ++i) { caps[i] = 16; rows[i] = malloc(caps[i]); rows[i][0] = '\\0'; }\n    int cur = 0, dir = 1;\n    for (int i = 0; i < n; ++i) {\n        if (sizes[cur] + 2 > caps[cur]) { caps[cur] *= 2; rows[cur] = realloc(rows[cur], caps[cur]); }\n        rows[cur][sizes[cur]++] = s[i]; rows[cur][sizes[cur]] = '\\0';\n        if (cur == 0) dir = 1; else if (cur == rowsCount - 1) dir = -1; cur += dir;\n    }\n    int total = 0; for (int i = 0; i < rowsCount; ++i) total += sizes[i];\n    char *out = malloc(total + 1); int oi = 0;\n    for (int i = 0; i < rowsCount; ++i) { memcpy(out + oi, rows[i], sizes[i]); oi += sizes[i]; free(rows[i]); }\n    out[oi] = '\\0'; free(rows); free(sizes); free(caps); return out;\n}\n\nint main() { return 0; }",
    "C++": "",
    "Java": "import java.io.*;\nimport java.util.*;\n\nclass Solution {\n    public String convert(String s, int numRows) {\n        if (numRows <= 1 || numRows >= s.length()) return s;\n        List<StringBuilder> rows = new ArrayList<>();\n        int n = Math.min(numRows, s.length());\n        for (int i = 0; i < n; ++i) rows.add(new StringBuilder());\n        int cur = 0, dir = 1;\n        for (char c : s.toCharArray()) {\n            rows.get(cur).append(c);\n            if (cur == 0) dir = 1;\n            else if (cur == numRows - 1) dir = -1;\n            cur += dir;\n        }\n        StringBuilder out = new StringBuilder();\n        for (StringBuilder sb : rows) out.append(sb);\n        return out.toString();\n    }\n}\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        // Judge harness will provide input as JSON: [s, numRows]\n    }\n}",
    "Python3": "import sys, json\n\nclass Solution:\n    def convert(self, s: str, numRows: int) -> str:\n        if numRows <= 1 or numRows >= len(s):\n            return s\n        rows = [\"\" for _ in range(min(numRows, len(s)))]\n        cur, dir = 0, 1\n        for c in s:\n            rows[cur] += c\n            if cur == 0:\n                dir = 1\n            elif cur == numRows - 1:\n                dir = -1\n            cur += dir\n        return ''.join(rows)\n\nif __name__ == '__main__':\n    args = json.loads(sys.stdin.readline())\n    s, numRows = args[0], args[1]\n    print(json.dumps(Solution().convert(s, numRows)))",
    "JavaScript": "'use strict';\nconst rl = require('readline');\nconst reader = rl.createInterface({ input: process.stdin });\nreader.on('line', line => {\n    const args = JSON.parse(line.trim());\n    const s = args[0], numRows = args[1];\n    if (numRows <= 1 || numRows >= s.length) { console.log(JSON.stringify(s)); reader.close(); return; }\n    const rows = Array.from({length: Math.min(numRows, s.length)}, () => '');\n    let cur = 0, dir = 1;\n    for (const c of s) {\n        rows[cur] += c;\n        if (cur === 0) dir = 1;\n        else if (cur === numRows - 1) dir = -1;\n        cur += dir;\n    }\n    console.log(JSON.stringify(rows.join('')));\n    reader.close();\n});",
