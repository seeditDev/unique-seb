  "content": {
    "problemStatement": "Task: Write the characters of s down and diagonally up across numRows rows, repeating this down-up movement until every character is placed. The task is to output the characters obtained by reading the rows from top to bottom.\n\nIf numRows is 1, or numRows is no fewer than the length of s, the result is s unchanged.",
    "constraints": [
      "1 <= s.length <= 1000",
      "s consists of printable ASCII characters (letters, digits, punctuation, symbols and spaces).",
      "1 <= numRows <= 1000"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [
      "If numRows is 1 or numRows >= len(s), return s unchanged.",
      "Simulate row assignment with a direction toggle (down/up) or compute positions using cycle length 2*numRows-2.",
      "Target O(n) time and O(n) extra space (for output)."
    ],
    "sampleTestCases": [
      {
