  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# prefix sum\nclass Solution(object):\n    def leftRightDifference(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        total = sum(nums)\n        result = []\n        curr = 0\n        for x in nums:\n            curr += x\n            result.append(abs((curr-x)-(total-curr)))\n        return result"
    },
