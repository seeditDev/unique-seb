  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# math, bit manipulation\nclass Solution(object):\n    def smallestEvenMultiple(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        return n<<(n&1)"
    },
