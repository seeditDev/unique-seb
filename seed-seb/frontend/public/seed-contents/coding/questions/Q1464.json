  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def maxProduct(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        m1 = m2 = 0\n        for num in nums:\n            if num > m1:\n                m1, m2 = num, m1\n            elif num > m2:\n                m2 = num\n        return (m1-1)*(m2-1)"
    },
