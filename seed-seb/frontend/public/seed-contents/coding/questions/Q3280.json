  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def convertDateToBinary(self, date):\n        \"\"\"\n        :type date: str\n        :rtype: str\n        \"\"\"\n        return \"-\".join(map(lambda x: bin(int(x))[2:], date.split('-')))"
    },
