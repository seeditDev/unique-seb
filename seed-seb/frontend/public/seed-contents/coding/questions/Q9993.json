  "content": {
    "problemStatement": "Chef decides to go to the water park to play. To enter the water slide, a person must have a weight of **at most** WWW Kg and a height of **at least** HHH cm.\n\nChef weighs 606060 Kg and his height is 130130130 cm.\n\nIs Chef allowed to enter the water slide?\n\n\nInput Format\n\nThe first and only line of input will contain two space-separated integers WWW and HHH.\n\n\nOutput Format\n\nOutput `YES` if Chef can enter the waterslide and `NO` if he cannot.\nYou may print each character of the string in either uppercase or lowercase (for example, the strings `YES`, `yEs`, `yes`, and `yeS` will all be treated as identical).",
    "constraints": [
      "1≤W,H≤10001 \\leq W, H \\leq 10001≤W,H≤1000"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "75 110",
        "output": "YES",
        "explanation": "Explanation:\nChef is allowed on the water slide, because:\n\nHis height is 130130130 cm, which is ≥110\\geq 110≥110.\nHis weight is 606060 kg, which is ≤75\\leq 75≤75."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "55 115",
        "output": "NO",
        "explanation": "Explanation:\nChef's height is ≥115\\geq 115≥115 cm, but his weight is greater than 555555 kg.\nSo, Chef is NOT allowed on the water slide."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "60 130",
        "output": "YES",
        "explanation": ""
      }
    ]
  },
