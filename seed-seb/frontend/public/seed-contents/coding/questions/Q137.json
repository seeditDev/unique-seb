  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    # @param A, a list of integer\n    # @return an integer\n    def singleNumber(self, A):\n        one, two = 0, 0\n        for x in A:\n            one, two = (~x & one) | (x & ~one & ~two), (~x & two) | (x & one)\n        return one"
    },
