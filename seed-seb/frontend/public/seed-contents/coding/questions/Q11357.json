  "solution": {
    "approach": "Use bitwise operations to count the number of 1 bits.",
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint hammingWeight(uint32_t n) {\n    int count = 0;\n    while (n) {\n        count += n & 1;\n        n >>= 1;\n    }\n    return count;\n}",
      "C++": "#include <iostream>\nclass Solution {\npublic:\n    int hammingWeight(uint32_t n) {\n        int count = 0;\n        while (n) {\n            count += n & 1;\n            n >>= 1;\n        }\n        return count;\n    }\n};",
      "Java": "public class Solution {\n    public int hammingWeight(int n) {\n        int count = 0;\n        while (n != 0) {\n            count += n & 1;\n            n >>>= 1;\n        }\n        return count;\n    }\n}",
      "Python3": "class Solution:\n    def hammingWeight(self, n: int) -> int:\n        count = 0\n        while n:\n            count += n & 1\n            n >>= 1\n        return count",
      "JavaScript": "var hammingWeight = function(n) {\n    let count = 0;\n    while (n) {\n        count += n & 1;\n        n >>>= 1;\n    }\n    return count;\n};"
    },
