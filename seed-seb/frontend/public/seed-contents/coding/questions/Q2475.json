  "solution": {
    "code": {
      "Python3": "# Time:  O(n * k) = O(3 * n)\n# Space: O(n + k) = O(n)\n\nimport collections\n\n\n# freq table, dp\nclass Solution(object):\n    def unequalTriplets(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        K = 3\n        cnt = collections.Counter()\n        dp = [0]*K  # dp[i]: number of unequal (i+1)-plets\n        for x in nums:\n            cnt[x] += 1\n            other_cnt = 1\n            for i in range(K):\n                dp[i] += other_cnt\n                other_cnt = dp[i]-cnt[x]*other_cnt\n        return dp[K-1]"
    },
