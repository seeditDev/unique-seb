  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def maxSumDivThree(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        dp = [0, 0, 0]\n        for num in nums:\n            for i in [num+x for x in dp]:\n                dp[i%3] = max(dp[i%3], i)\n        return dp[0]"
    },
