  "content": {
    "problemStatement": "Write a program for the coding challenge \"Populating Next Right Pointers in Each Node\". Refer to LeetCode description: https://leetcode.com/problems/populating-next-right-pointers-in-each-node/",
    "constraints": [
      "The number of nodes in the tree is in the range [1, 10^4]",
      "1 <= Node.val <= 10^5",
      "Node.left == null and Node.right == null for the rightmost and leftmost nodes"
    ],
    "inputFormat": "A tree node with a value and four pointers (left, right, next, and a flag to indicate if the node is a root node)",
    "outputFormat": "The root of the modified tree with next pointers populated",
    "notes": [],
    "sampleTestCases": []
  },
