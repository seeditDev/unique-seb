  "solution": {
    "approach": "Check if the number is odd or even and return the next page number accordingly",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int n;\n    scanf(\"%d\", &n);\n    printf(\"%d\\n\", n + 1);\n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int n;\n    cin >> n;\n    cout << n + 1 << endl;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int n = scanner.nextInt();\n        System.out.println(n + 1);\n    }\n}",
      "Python3": "n = int(input())\nprint(n + 1)",
      "JavaScript": "const readline = require('readline').createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nreadline.on('line', (line) => {\n    const n = parseInt(line);\n    console.log(n + 1);\n});"
    },
