  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def smallestAbsent(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        total = sum(nums)\n        lookup = set(nums)\n        return next(x for x in range(max(total//len(nums)+1, 1), max(max(nums)+1, 1)+1) if x not in lookup and x*len(nums) > total)"
    },
