  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    def balancedString(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        count = collections.Counter(s)\n        result = len(s) \n        left = 0\n        for right in range(len(s)):\n            count[s[right]] -= 1\n            while left < len(s) and \\\n                  all(v <= len(s)//4 for v in count.itervalues()):\n                result = min(result, right-left+1)\n                count[s[left]] += 1\n                left += 1\n        return result"
    },
