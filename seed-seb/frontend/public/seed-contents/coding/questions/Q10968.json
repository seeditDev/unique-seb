  "content": {
    "problemStatement": "India's independency day is on the 15th15^{th}15th of August. You are given a date XXX August, and must find how many days are left for the independence day.\n\nIf the independence day has passed already, print −1-1−1 instead.\n\n\nInput Format\n\nThe first and only line of input contains a single integer XXX - the date in August.\n\n\nOutput Format\nOutput the number of days left for independence day or −1-1−1 if it has already passed.",
    "constraints": [
      "1≤X≤311 \\le X \\le 311≤X≤31"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1",
        "output": "14",
        "explanation": "Explanation:\nThere are still 141414 days left for Independence day."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "15",
        "output": "0",
        "explanation": "Explanation:\n15th15^{th}15th August is the Independence day itself, hence the answer is 000."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "17",
        "output": "-1",
        "explanation": "Explanation:\nIndependence day has already passed."
      }
    ]
  },
