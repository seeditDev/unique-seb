  "content": {
    "problemStatement": "You want to go to the Coldplay concert along with NNN of your friends. You are buying tickets for everyone.\n\nEach ticket costs 500050005000 INR. Calculate the total amount you need to pay (in INR).\n\n\nInput Format\n\nThe first and only line of input contains NNN — the number of friends you have.\n\n\nOutput Format\nFor each test case, output on a new line the total cost of all tickets for yourself and your friends.",
    "constraints": [
      "1≤N≤51 \\le N \\le 51≤N≤5"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1",
        "output": "10000",
        "explanation": "Explanation:\nYou are buying tickets for yourself and one friend of yours. Thus, the cost is 2⋅5000=100002 \\cdot 5000 = 100002⋅5000=10000."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "5",
        "output": "30000",
        "explanation": ""
      }
    ]
  },
