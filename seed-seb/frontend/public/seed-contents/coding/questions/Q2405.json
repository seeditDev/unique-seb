  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def partitionString(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result, left = 1, 0\n        lookup = {}\n        for i, x in enumerate(s):\n            if x in lookup and lookup[x] >= left:\n                left = i\n                result += 1\n            lookup[x] = i\n        return result"
    },
