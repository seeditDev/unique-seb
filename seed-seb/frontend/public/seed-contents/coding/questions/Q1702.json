  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nclass Solution(object):\n    def maximumBinaryString(self, binary):\n        \"\"\"\n        :type binary: str\n        :rtype: str\n        \"\"\"\n        result = list(binary)\n        zeros = ones = 0\n        for i, c in enumerate(result):\n            if c == '0':\n                zeros += 1\n            elif zeros == 0:\n                ones += 1\n            result[i] = '1'\n        if ones != len(result):\n            result[zeros+ones-1] = '0'\n        return \"\".join(result)"
    },
