  "content": {
    "problemStatement": "The ZCO Scholarship Contest has just finished, and you finish with a rank of RRR. You know that Rank 111 to Rank 505050 will get 100%100 \\%100% scholarship on the ZCO exam fee and Rank 515151 to Rank 100100100 will get 50%50 \\%50% percentage scholarship on the ZCO exam fee. The rest do not get any scholarship.\n\nWhat percentage of scholarship will you get ?\n\n\nInput Format\n\nInput consist of single line of input containing one integer RRR.\n\n\nOutput Format\n\nOutput a single line containing one integer — the percentage of scholarship you will get.",
    "constraints": [
      "1≤R≤1091 \\le R  \\le 10^91≤R≤109"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "49",
        "output": "100",
        "explanation": "Explanation:\nSince 1≤49≤50 1 \\le 49 \\le 501≤49≤50, answer is 100100100 percentage scholarship."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "317",
        "output": "0",
        "explanation": "Explanation:\nSince 317>100317 > 100317>100, you do not get any scholarship."
      }
    ]
  },
