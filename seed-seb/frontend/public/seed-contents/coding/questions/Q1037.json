  "solution": {
    "code": {
      "Python3": "# Time:  O(1)\n# Space: O(1)\n\nclass Solution(object):\n    def isBoomerang(self, points):\n        \"\"\"\n        :type points: List[List[int]]\n        :rtype: bool\n        \"\"\"\n        return (points[0][0] - points[1][0]) * (points[0][1] - points[2][1]) - \\\n               (points[0][0] - points[2][0]) * (points[0][1] - points[1][1]) != 0"
    },
