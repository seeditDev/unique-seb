  "solution": {
    "approach": "Recursive/Iterative traversal of the binary search tree to find the floor value",
    "timeComplexity": "O(h) where h is the height of the binary search tree",
    "spaceComplexity": "O(h) where h is the height of the binary search tree",
    "code": {
      "C": "\n         #include <stdio.h>\n         #include <stdlib.h>\n\n         struct TreeNode {\n            int val;\n            struct TreeNode *left;\n            struct TreeNode *right;\n         };\n\n         int floorBST(struct TreeNode* root, int target) {\n            int floor = -1;\n            while (root) {\n               if (root->val == target) {\n                  floor = root->val;\n                  break;\n               } else if (root->val < target) {\n                  floor = root->val;\n                  root = root->right;\n               } else {\n                  root = root->left;\n               }\n            }\n            return floor;\n         }\n      ",
      "C++": "\n         #include <iostream>\n         using namespace std;\n\n         struct TreeNode {\n            int val;\n            TreeNode *left;\n            TreeNode *right;\n            TreeNode(int x) : val(x), left(NULL), right(NULL) {}\n         };\n\n         int floorBST(TreeNode* root, int target) {\n            int floor = -1;\n            while (root) {\n               if (root->val == target) {\n                  floor = root->val;\n                  break;\n               } else if (root->val < target) {\n                  floor = root->val;\n                  root = root->right;\n               } else {\n                  root = root->left;\n               }\n            }\n            return floor;\n         }\n      ",
      "Java": "\n         public class Solution {\n            public int floorBST(TreeNode root, int target) {\n               int floor = -1;\n               while (root != null) {\n                  if (root.val == target) {\n                     floor = root.val;\n                     break;\n                  } else if (root.val < target) {\n                     floor = root.val;\n                     root = root.right;\n                  } else {\n                     root = root.left;\n                  }\n               }\n               return floor;\n            }\n         }\n      ",
      "Python3": "\n         class Solution:\n            def floorBST(self, root: TreeNode, target: int) -> int:\n               floor = -1\n               while root:\n                  if root.val == target:\n                     floor = root.val\n                     break\n                  elif root.val < target:\n                     floor = root.val\n                     root = root.right\n                  else:\n                     root = root.left\n               return floor\n      ",
      "JavaScript": "\n         var floorBST = function(root, target) {\n            let floor = -1;\n            while (root) {\n               if (root.val === target) {\n                  floor = root.val;\n                  break;\n               } else if (root.val < target) {\n                  floor = root.val;\n                  root = root.right;\n               } else {\n                  root = root.left;\n               }\n            }\n            return floor;\n         };\n      "
    },
