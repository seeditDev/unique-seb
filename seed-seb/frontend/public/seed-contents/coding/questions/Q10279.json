        "type": "reg",
        "input": "5\n1 2000 1\n234\n1986\n2 2000 1\n592 593\n592 1999\n3 10 2\n1 0 0\n9 9 9\n4 10 3\n3 2 9 0\n3 9 5 2\n4 2000 4\n1 0 0 0\n1999 1999 1999 1999",
        "output": "1753\n0\n243\n295\n67854398",
