  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogr), r = max(nums)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def differenceOfSum(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def total(x):\n            result = 0\n            while x:\n                result += x%10\n                x //= 10\n            return result\n\n        return abs(sum(nums)-sum(total(x) for x in nums))"
    },
