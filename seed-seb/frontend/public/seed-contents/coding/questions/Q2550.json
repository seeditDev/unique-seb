  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# combinatorics, fast exponentiation\nclass Solution(object):\n    def monkeyMove(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        MOD = 10**9+7\n        return (pow(2, n, MOD)-2)%MOD"
    },
