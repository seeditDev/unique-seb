  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def removeZeros(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        def reverse(n):\n            result = 0\n            while n:\n                n, r = divmod(n, 10)\n                result = result*10+r\n            return result\n    \n        result = 0\n        while n:\n            n, r = divmod(n, 10)\n            if r:\n                result = result*10+r\n        return reverse(result)"
    },
