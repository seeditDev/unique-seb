      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n3\n1 4 5\n1 3 4",
        "output": "1 2 0",
        "explanation": "Explanation:\nExample case 1: After rotating BBB once, it becomes (3,4,1)(3,4,1)(3,4,1). Now C=(1,2,0)C = (1,2,0)C=(1,2,0). This is the lexicographically smallest of all possible sequences CCC."
      }
    ]
