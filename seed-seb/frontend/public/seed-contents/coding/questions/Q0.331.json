  "content": {
    "problemStatement": "Given an integer array nums, return all unique triplets [nums[i], nums[j], nums[k]] such that:\n\ni ≠ j, i ≠ k, j ≠ k\n\nnums[i] + nums[j] + nums[k] = 0\n\nThe solution set must not contain duplicate triplets.",
    "constraints": [
      "0 ≤ n ≤ 3000",
      "-10^5 ≤ nums[i] ≤ 10^5"
    ],
    "inputFormat": "First line contains integer n.\n\nSecond line contains n space-separated integers.",
    "outputFormat": "Print each unique triplet in sorted order.\n\nTriplets should be printed in lexicographical order.\n\nEach triplet should be printed in a new line separated by spaces.",
    "notes": [],
    "sampleTestCases": [
