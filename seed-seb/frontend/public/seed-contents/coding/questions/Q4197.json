  "content": {
    "problemStatement": "Given a list of NNN integers, representing height of mountains. Find the height of the tallest mountain.\n\nInput:\nFirst line will contain TTT, number of testcases. Then the testcases follow.\nThe first line in each testcase contains one integer, NNN.\nThe following line contains NNN space separated integers: the height of each mountains.\nOutput:For each testcase, output one line with one integer: the height of the tallest mountain for that test case.",
    "constraints": [
      "1 <= T <= 10",
      "1 <= N <= 100000",
      "0 <= height <= 1000000000"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case consists of two lines: the first line contains an integer N, the number of mountains; the second line contains N space‑separated integers denoting the heights of the mountains.",
    "outputFormat": "For each test case, output a single line containing one integer – the maximum height among the given mountains.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n5\n4 7 6 3 1",
        "output": "7",
        "explanation": "The heights are [4,7,6,3,1]; the largest value is 7."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n3\n10 20 30",
        "output": "30",
        "explanation": "Among 10, 20 and 30 the maximum is 30."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n1\n1000000000",
        "output": "1000000000",
        "explanation": "Only one mountain exists with height 10^9, so that is the answer."
      }
    ]
  },
