  "content": {
    "problemStatement": "Chef is currently in the year XXX in Chefland. He has a time machine that allows him to travel at most 252525 years into the future, but he can use it only once.\n\nDetermine whether Chef can reach the year 205020502050 with a single use of the time machine.\n\n\nInput Format\nA single integer XXX, representing current year in Chefland.\n\n\n\nOutput Format\nPrint `YES` if Chef can reach the year 2050 , otherwise print `NO`.\n\n\nYou may print each character of the string in uppercase or lowercase (for example, the strings `YES`, `yEs`, `yes`, and `yeS` will all be treated as identical).",
    "constraints": [
      "2000≤X≤20502000 \\leq X \\leq 20502000≤X≤2050"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "2050",
        "output": "Yes",
        "explanation": "Explanation:\nChef is already in the year 205020502050, so there's no need to use the time machine."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2000",
        "output": "No",
        "explanation": "Explanation:\nChef can use the time machine to travel up to 252525 years into the future, but that won't take him beyond the year 202520252025."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "2030",
        "output": "Yes",
        "explanation": "Explanation:\nBy using the time machine, Chef can travel 202020 years into the future, reaching the year 205020502050."
      },
      {
        "id": "sample_4",
        "type": "reg",
        "input": "2025",
        "output": "Yes",
        "explanation": "Explanation:\nBy using the time machine, Chef can travel 252525 years into the future, reaching the year 205020502050."
      }
    ]
  },
