  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def sortArrayByParityII(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: List[int]\n        \"\"\"\n        j = 1\n        for i in range(0, len(A), 2):\n            if A[i] % 2:\n                while A[j] % 2:\n                    j += 2\n                A[i], A[j] = A[j], A[i]\n        return A"
    },
