  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def validMountainArray(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: bool\n        \"\"\"\n        i = 0\n        while i+1 < len(A) and A[i] < A[i+1]:\n            i += 1\n        j = len(A)-1\n        while j-1 >= 0 and A[j-1] > A[j]:\n            j -= 1\n        return 0 < i == j < len(A)-1"
    },
