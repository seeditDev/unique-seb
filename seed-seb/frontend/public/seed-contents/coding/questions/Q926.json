  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def minFlipsMonoIncr(self, S):\n        \"\"\"\n        :type S: str\n        :rtype: int\n        \"\"\"\n        flip0, flip1 = 0, 0\n        for c in S:\n            flip0 += int(c == '1')\n            flip1 = min(flip0, flip1 + int(c == '0'))\n        return flip1"
    },
