      "Python3": "# Time:  O(1)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def accountBalanceAfterPurchase(self, purchaseAmount):\n        \"\"\"\n        :type purchaseAmount: int\n        :rtype: int\n        \"\"\"\n        return 100-(purchaseAmount+5)//10*10"
