  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy\nclass Solution(object):\n    def minDeletion(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        for i in range(len(nums)-1):\n            result += int(i%2 == result%2 and nums[i] == nums[i+1])\n        return result+(len(nums)-result)%2"
    },
