  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# one pass, array\nclass Solution(object):\n    def findNonMinOrMax(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        mx, mn = float(\"-inf\"), float(\"inf\")\n        result = -1\n        for x in nums:\n            if mn < x < mx:\n                return x\n            if x < mn:\n                result = mn\n                mn = x\n            if x > mx:\n                result = mx\n                mx = x\n        return result if mn < result < mx else -1"
    },
