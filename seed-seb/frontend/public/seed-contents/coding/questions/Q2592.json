    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# freq table, contructive algorithms\nclass Solution(object):\n    def maximizeGreatness(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        return len(nums)-max(collections.Counter(nums).itervalues())"
