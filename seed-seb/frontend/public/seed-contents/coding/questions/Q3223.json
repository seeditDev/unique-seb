  "solution": {
    "code": {
      "Python3": "# Time:  O(n + 26)\n# Space: O(26)\n\n# freq table\nclass Solution(object):\n    def minimumLength(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        cnt = [0]*26\n        for x in s:\n            cnt[ord(x)-ord('a')] += 1\n        return sum(2-x%2 for x in cnt if x)"
    },
