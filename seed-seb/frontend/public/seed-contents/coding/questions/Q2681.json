  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(1)\n\n# sort, combinatorics, dp\nclass Solution(object):\n    def sumOfPower(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        MOD = 10**9+7\n        nums.sort()\n        result = dp = 0\n        for x in nums:\n            result = (result+(x**2)*(dp+x))%MOD\n            dp = (dp+(dp+x))%MOD\n        return result"
    },
