  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def minOperations(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        cnt = sum(int(c) == i%2 for i, c in enumerate(s))\n        return min(cnt, len(s)-cnt)"
    },
