  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy, math\nclass Solution(object):\n    def minimumReplacement(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def ceil_divide(a, b):\n            return (a+b-1)//b\n\n        result = 0\n        curr = nums[-1]\n        for x in reversed(nums):\n            cnt = ceil_divide(x, curr)\n            result += cnt-1\n            curr = x//cnt\n        return result"
    },
