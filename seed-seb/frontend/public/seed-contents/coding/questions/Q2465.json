  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\n# sort, two pointers, hash table\nclass Solution(object):\n    def distinctAverages(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        lookup = set()\n        nums.sort()\n        left, right = 0, len(nums)-1\n        while left < right:\n            lookup.add(nums[left]+nums[right])\n            left, right = left+1, right-1\n        return len(lookup)"
    },
