  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# hash table\nclass Solution(object):\n    def repeatedCharacter(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        lookup = set()\n        for c in s:\n            if c in lookup:\n                break\n            lookup.add(c)\n        return c"
    },
