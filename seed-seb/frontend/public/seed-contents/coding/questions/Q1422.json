  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def maxScore(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result, zeros, ones = 0, 0, 0\n        for i in range(1, len(s)-1):\n            if s[i] == '0':\n                zeros += 1\n            else:\n                ones += 1\n            result = max(result, zeros-ones)\n        return result + ones + (s[0] == '0') + (s[-1] == '1')"
    },
