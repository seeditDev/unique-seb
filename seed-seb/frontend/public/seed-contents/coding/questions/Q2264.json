  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def largestGoodInteger(self, num):\n        \"\"\"\n        :type num: str\n        :rtype: str\n        \"\"\"\n        result = ''\n        cnt = 0\n        for i, x in enumerate(num):\n            cnt += 1\n            if i+1 < len(num) and num[i] == num[i+1]:\n                continue\n            if cnt >= 3:\n                result = max(result, num[i])\n            cnt = 0\n        return result*3"
    },
