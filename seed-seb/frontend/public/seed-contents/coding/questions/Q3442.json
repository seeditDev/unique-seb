  "solution": {
    "code": {
      "Python3": "# Time:  O(n + 26)\n# Space: O(26)\n\n# freq table\nclass Solution(object):\n    def maxDifference(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        cnt = [0]*26\n        for x in s:\n            cnt[ord(x)-ord('a')] += 1\n        mn, mx = float(\"inf\"), 0\n        for x in cnt:\n            if not x:\n                continue\n            if x%2 == 0:\n                mn = min(mn, x)\n            else:\n                mx = max(mx, x)\n        return mx-mn"
    },
