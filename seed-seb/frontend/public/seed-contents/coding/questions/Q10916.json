  "content": {
    "problemStatement": "You have a rectangle of length AAA units and breadth BBB units. You also have a square with side length of CCC units.\n\nCheck if both the rectangle and the square have the same area. Print Yes\\text{Yes}Yes if they have the same area, and No\\text{No}No otherwise.\n\n\nInput Format\n\nThe first and only line of input contains 333 integers - AAA, BBB and CCC.\n\n\nOutput Format\nOutput on a new line Yes\\text{Yes}Yes if they have the same area, and No\\text{No}No otherwise.\n\n\nIt is allowed to print each character in either case, i.e. YES\\text{YES}YES, yes\\text{yes}yes, yES\\text{yES}yES will all be accepted as a positive response.",
    "constraints": [
      "1≤A,B,C≤101 \\le A, B, C \\le 101≤A,B,C≤10"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "2 8 4",
        "output": "Yes",
        "explanation": "Explanation:\nBoth the rectangle and the square have an area of 161616 units2^22."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "3 5 4",
        "output": "No",
        "explanation": "Explanation:\nThe rectangle has an area of 151515  units2^22 but the square has 161616 units2^22."
      }
    ]
  },
