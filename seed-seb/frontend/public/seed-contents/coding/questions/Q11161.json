    "code": {
      "C": "//Solution as follows\n#include <stdio.h>\n\nint main()\n{\n    int t;\n    scanf(\"%d\", &t);\n\n    while (t--)\n    {\n        int N;\n        scanf(\"%d\", &N);\n\n        int A[N];\n\n        for (int i = 0; i < N; i++)\n        {\n            scanf(\"%d\", &A[i]);\n        }\n\n        int small = A[0];\n        int large = A[0];\n\n        for (int i = 0; i < N; i++)\n        {\n            if (A[i] > large)\n            {\n                large = A[i];\n            }\n\n            if (A[i] < small)\n            {\n                small = A[i];\n            }\n        }\n\n        printf(\"%d %d\\n\", small, large);\n    }\n\n    return 0;\n}\n",
