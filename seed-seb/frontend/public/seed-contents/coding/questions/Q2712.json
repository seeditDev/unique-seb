  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy\nclass Solution(object):\n    def minimumCost(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        return sum(min(i+1, len(s)-(i+1)) for i in range(len(s)-1) if s[i] != s[i+1])"
    },
