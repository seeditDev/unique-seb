  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def alternatingSubarray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = l = -1\n        for i in range(len(nums)-1):\n            if l != -1 and nums[i-1] == nums[i+1]:\n                l += 1\n            else:\n                l = 2 if nums[i+1]-nums[i] == 1 else -1\n            result = max(result, l)\n        return result"
    },
