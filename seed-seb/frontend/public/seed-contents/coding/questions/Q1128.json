  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def numEquivDominoPairs(self, dominoes):\n        \"\"\"\n        :type dominoes: List[List[int]]\n        :rtype: int\n        \"\"\"\n        counter = collections.Counter((min(x), max(x)) for x in dominoes)\n        return sum(v*(v-1)//2 for v in counter.itervalues())"
    },
