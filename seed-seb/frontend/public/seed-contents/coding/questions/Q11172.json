    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "def is_prime_filter(numbers):\n    primes = []\n    for num in numbers:\n        if not isinstance(num, int):\n            continue\n        \n        if num < 2:\n            continue\n\n        is_prime_flag = True\n        for i in range(2, num):\n            if num % i == 0:\n                is_prime_flag = False\n                break\n        \n        if is_prime_flag:\n            primes.append(num)\n            \n    return primes",
      "JavaScript": ""
    },
