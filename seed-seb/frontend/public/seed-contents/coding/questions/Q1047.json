  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nclass Solution(object):\n    def removeDuplicates(self, S):\n        \"\"\"\n        :type S: str\n        :rtype: str\n        \"\"\"\n        result = []\n        for c in S:\n            if result and result[-1] == c:\n                result.pop()\n            else:\n                result.append(c)\n        return \"\".join(result)"
    },
