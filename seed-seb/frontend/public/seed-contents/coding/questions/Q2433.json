  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def findArray(self, pref):\n        \"\"\"\n        :type pref: List[int]\n        :rtype: List[int]\n        \"\"\"\n        for i in reversed(range(1, len(pref))):\n            pref[i] ^= pref[i-1]\n        return pref"
    },
