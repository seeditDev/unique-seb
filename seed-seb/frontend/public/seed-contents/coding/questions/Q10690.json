  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nconst int MOD = 1e9 + 7;\n\nint countWays(int n) {\n    vector<long long> dp(n + 1, 0);\n    dp[0] = 1;\n    dp[1] = 1;\n\n    for (int i = 2; i <= n; ++i) {\n        dp[i] = (dp[i - 1] + (i - 1) * dp[i - 2]) % MOD;\n    }\n    return dp[n];\n}\n\nint main() {\n    int t;\n    cin >> t;\n\n    while (t--) {\n        int n;\n        cin >> n;\n        cout << countWays(n) << endl;\n    }\n\n    return 0;\n}\n",
