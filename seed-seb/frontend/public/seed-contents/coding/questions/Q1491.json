  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# one pass solution\nclass Solution(object):\n    def average(self, salary):\n        \"\"\"\n        :type salary: List[int]\n        :rtype: float\n        \"\"\"\n        total, mi, ma = 0, float(\"inf\"), float(\"-inf\")\n        for s in salary:\n            total += s\n            mi, ma = min(mi, s), max(ma, s)\n        return 1.0*(total-mi-ma)/(len(salary)-2)"
    },
