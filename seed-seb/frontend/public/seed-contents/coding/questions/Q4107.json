  "content": {
    "problemStatement": "Identify and correct the logic to print **true** if a number is even, else **false**.",
    "constraints": [
      "1 <= T <= 10",
      "1 <= N <= 1000000",
      "All values are integers"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single integer N.",
    "outputFormat": "For each test case, print 'true' if N is even, otherwise print 'false'. Each answer is printed on its own line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "5\n1\n2\n3\n4\n5",
        "output": "false\ntrue\nfalse\ntrue\nfalse",
        "explanation": "1 is odd → false, 2 is even → true, 3 is odd → false, 4 is even → true, 5 is odd → false."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "3\n10\n20\n30",
        "output": "true\ntrue\ntrue",
        "explanation": "All three numbers (10, 20, 30) are even, so each yields true."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "2\n1\n2",
        "output": "false\ntrue",
        "explanation": "1 is odd → false, 2 is even → true."
      }
    ]
  },
