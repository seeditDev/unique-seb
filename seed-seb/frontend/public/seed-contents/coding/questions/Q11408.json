  "content": {
    "problemStatement": "Write a program for the coding challenge \"Beautiful Matrix\". Refer to LeetCode description: https://codeforces.com/problemset/problem/263/A",
    "constraints": [
      "The input matrix is a 5x5 grid",
      "The number 1 is guaranteed to be in the matrix",
      "The distance is calculated as |x2-x1| + |y2-y1|, where (x1, y1) is the center of the matrix (3, 3) and (x2, y2) is the position of the number 1"
    ],
    "inputFormat": "A 5x5 matrix",
    "outputFormat": "The distance from the center of the matrix to the position of the number 1",
    "notes": [],
    "sampleTestCases": []
  },
