  "solution": {
    "approach": "Iterate over the matrix to find the position of the number 1 and calculate the distance",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int matrix[5][5];\n    for (int i = 0; i < 5; i++) {\n        for (int j = 0; j < 5; j++) {\n            scanf(\"%d\", &matrix[i][j]);\n        }\n    }\n    int x, y;\n    for (int i = 0; i < 5; i++) {\n        for (int j = 0; j < 5; j++) {\n            if (matrix[i][j] == 1) {\n                x = i;\n                y = j;\n            }\n        }\n    }\n    printf(\"%d\\n\", (x > 2 ? x - 2 : 2 - x) + (y > 2 ? y - 2 : 2 - y));\n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int matrix[5][5];\n    for (int i = 0; i < 5; i++) {\n        for (int j = 0; j < 5; j++) {\n            cin >> matrix[i][j];\n        }\n    }\n    int x, y;\n    for (int i = 0; i < 5; i++) {\n        for (int j = 0; j < 5; j++) {\n            if (matrix[i][j] == 1) {\n                x = i;\n                y = j;\n            }\n        }\n    }\n    cout << (x > 2 ? x - 2 : 2 - x) + (y > 2 ? y - 2 : 2 - y) << endl;\n    return 0;\n}",
