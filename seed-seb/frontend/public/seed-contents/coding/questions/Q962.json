  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nclass Solution(object):\n    def maxWidthRamp(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        s = []\n        for i in A:\n            if not s or A[s[-1]] > A[i]:\n                s.append(i)\n        for j in reversed(range(len(A))):\n            while s and A[s[-1]] <= A[j]:\n                result = max(result, j-s.pop())\n        return result"
    },
