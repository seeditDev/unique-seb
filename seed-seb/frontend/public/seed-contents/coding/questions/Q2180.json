  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def countEven(self, num):\n        \"\"\"\n        :type num: int\n        :rtype: int\n        \"\"\"\n        def parity(x):\n            result = 0\n            while x:\n                result += x%10\n                x //= 10\n            return result%2\n\n        return (num-parity(num))//2"
    },
