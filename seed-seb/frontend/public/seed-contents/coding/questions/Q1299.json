  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def replaceElements(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: List[int]\n        \"\"\"\n        curr_max = -1\n        for i in reversed(range(len(arr))):\n            arr[i], curr_max = curr_max, max(curr_max, arr[i])\n        return arr"
    },
