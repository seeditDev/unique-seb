  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def minimumCardPickup(self, cards):\n        \"\"\"\n        :type cards: List[int]\n        :rtype: int\n        \"\"\"\n        lookup = {}\n        result = float(\"inf\")\n        for i, x in enumerate(cards):\n            if x in lookup:\n                result = min(result, i-lookup[x]+1)\n            lookup[x] = i\n        return result if result != float(\"inf\") else -1"
    },
