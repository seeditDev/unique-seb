  "content": {
    "problemStatement": "Write a program for the coding challenge \"Find Median in a Stream\". Refer to LeetCode description: https://leetcode.com/problems/find-median-from-data-stream/",
    "constraints": [
      "1 <= num <= 10^5",
      "1 <= total numbers in the stream <= 10^5",
      "-10^5 <= num <= 10^5"
    ],
    "inputFormat": "The input will be a stream of integers, and after each integer, the median of the current stream will be queried.",
    "outputFormat": "The output will be the median of the current stream after each integer is added.",
    "notes": [],
