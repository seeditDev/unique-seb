  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <iostream>\n#include <vector>\nusing namespace std;\n\nint maxLoot(vector<int>& money, int n) {\n    // Handle base cases\n    if(n == 0) return 0;\n    if(n == 1) return money[0];\n    if(n == 2) return max(money[0], money[1]);\n    \n    // dp[i] represents maximum money that can be looted from first i houses\n    vector<int> dp(n);\n    \n    // Initialize first two states\n    dp[0] = money[0];\n    dp[1] = max(money[0], money[1]);\n    \n    // Fill dp array\n    for(int i = 2; i < n; i++) {\n        // At each house, thief has two choices:\n        // 1. Skip current house and take previous best (dp[i-1])\n        // 2. Take current house and add to best possible from i-2 houses (dp[i-2] + money[i])\n        dp[i] = max(dp[i-1], dp[i-2] + money[i]);\n    }\n    \n    return dp[n-1];\n}\n\nint main() {\n    int n;\n    cin >> n;\n    \n    vector<int> money(n);\n    for(int i = 0; i < n; i++) {\n        cin >> money[i];\n    }\n    \n    cout << maxLoot(money, n) << endl;\n    \n    return 0;\n}",
