  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nstring solve(string path) {\n    // Initial position and direction\n    int x = 0, y = 0;\n    int dir = 0;  // 0:North, 1:East, 2:South, 3:West\n    \n    for(char move : path) {\n        if(move == 'R') {\n            dir = (dir + 1) % 4;\n        }\n        else if(move == 'L') {\n            dir = (4 + dir - 1) % 4;  // Add 4 to handle negative\n        }\n        else {  // move == 'G'\n            switch(dir) {\n                case 0: y++; break;  // North\n                case 1: x++; break;  // East\n                case 2: y--; break;  // South\n                case 3: x--; break;  // West\n            }\n        }\n    }\n    \n    return (x == 0 && y == 0) ? \"YES\" : \"NO\";\n}\n\nint main() {\n    string path;\n    cin >> path;\n    cout << solve(path) << endl;\n    return 0;\n}",
