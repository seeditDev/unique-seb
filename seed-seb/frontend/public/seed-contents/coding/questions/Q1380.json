  "solution": {
    "code": {
      "Python3": "# Time:  O(m * n)\n# Space: O(m + n)\n\nimport itertools\n\n\nclass Solution(object):\n    def luckyNumbers (self, matrix):\n        \"\"\"\n        :type matrix: List[List[int]]\n        :rtype: List[int]\n        \"\"\"\n        rows = map(min, matrix)\n        cols = map(max, itertools.izip(*matrix))\n        return [cell for i, row in enumerate(matrix)\n                     for j, cell in enumerate(row) if rows[i] == cols[j]]"
    },
