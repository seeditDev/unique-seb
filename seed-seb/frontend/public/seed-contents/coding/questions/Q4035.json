  "content": {
    "problemStatement": "Given two space separated integers as user inputs, aaa and bbb, print the sum of a2a^{\\text{2}}a2 and b3b^{\\text{3}}b3.",
    "constraints": [
      "1 <= T <= 10",
      "1 <= a <= 1000",
      "1 <= b <= 1000",
      "All values are integers"
    ],
    "inputFormat": "First line contains an integer T (1 ≤ T ≤ 10), the number of test cases. Each of the next T lines contains two space‑separated integers a and b (1 ≤ a, b ≤ 1000).",
    "outputFormat": "For each test case, output a single line containing the value a² + b³.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n2 3",
        "output": "31",
        "explanation": "a² = 2² = 4, b³ = 3³ = 27, sum = 4 + 27 = 31."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n5 6",
        "output": "241",
        "explanation": "a² = 5² = 25, b³ = 6³ = 216, sum = 25 + 216 = 241."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n8 9",
        "output": "793",
        "explanation": "a² = 8² = 64, b³ = 9³ = 729, sum = 64 + 729 = 793."
      }
    ]
