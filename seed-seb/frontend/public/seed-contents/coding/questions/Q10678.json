    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h> \nusing namespace std;\n\nconst int MOD = 1e9 + 7;  // To handle large numbers\nvector<int> dp;\n\nint countWaysDP(int n) {\n    // Base cases\n    if(n <= 1) return 1;\n    if(dp[n] != -1) return dp[n];\n    \n    // Calculate ways using recursion with memoization\n    return dp[n] = (countWaysDP(n-1) + countWaysDP(n-2)) % MOD;\n}\n\nint main() {\n    int T;\n    cin >> T;\n    \n    while(T--) {\n        int N;\n        cin >> N;\n        dp.assign(N + 1, -1);  // Reset dp array for each test case\n        cout << countWaysDP(N) << endl;\n    }\n    return 0;\n}",
