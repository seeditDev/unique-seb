  "content": {
    "problemStatement": "Given a target node data and a root of binary tree. If the target is set on fire, determine the shortest amount of time needed to burn the entire binary tree.\nIt is known that in 1 second all nodes connected to a given node get burned. That is its left child, right child, and parent.",
    "constraints": [
      "1 <= Number of nodes in the binary tree <= 10^5",
      "1 <= Node values <= 10^5",
      "1 <= Target node value <= 10^5"
    ],
    "inputFormat": "The input will contain a binary tree and a target node value. The binary tree will be represented as a series of node values, and the target node value will be an integer.",
    "outputFormat": "The output will be the minimum time required to burn the entire binary tree from the target node.",
    "notes": [],
    "sampleTestCases": []
  },
