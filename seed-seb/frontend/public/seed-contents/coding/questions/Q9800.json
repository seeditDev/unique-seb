  "content": {
    "problemStatement": "Chef considers the number 777 lucky. As a result, he believes that the 777-th letter he sees on a day is his lucky letter of the day.\n\nYou are given a string SSS of length 101010, denoting the first 101010 letters Chef saw today.\n\nWhat is Chef's lucky letter?\n\n\nInput Format\n\nThe only line of input contains a string SSS, of length 101010.\n\n\nOutput Format\n\nPrint a single character: Chef's lucky letter\n.",
    "constraints": [
      "SSS has a length of 101010",
      "SSS contains only lowercase Latin letters (i.e, the characters `'a'` to `'z'`)"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "proceeding",
        "output": "d",
        "explanation": "Explanation:\nThe 777-th character of \"proceeding\"\\texttt{\"proceeding\"}\"proceeding\" is 'd', and hence that is Chef's lucky letter."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "outofsight",
        "output": "i",
        "explanation": "Explanation:\nThe 777-th character of \"outofsight\"\\texttt{\"outofsight\"}\"outofsight\" is 'i', and hence that is Chef's lucky letter."
      }
    ]
  },
