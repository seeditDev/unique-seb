  "solution": {
    "approach": "Use bitwise operations to reverse the bits of the input integer.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdint.h>\nuint32_t reverseBits(uint32_t n) {\n    uint32_t result = 0;\n    for (int i = 0; i < 32; i++) {\n        result = (result << 1) | (n & 1);\n        n >>= 1;\n    }\n    return result;\n}",
      "C++": "#include <cstdint>\nuint32_t reverseBits(uint32_t n) {\n    uint32_t result = 0;\n    for (int i = 0; i < 32; i++) {\n        result = (result << 1) | (n & 1);\n        n >>= 1;\n    }\n    return result;\n}",
      "Java": "public class Solution {\n    public int reverseBits(int n) {\n        int result = 0;\n        for (int i = 0; i < 32; i++) {\n            result = (result << 1) | (n & 1);\n            n >>>= 1;\n        }\n        return result;\n    }\n}",
      "Python3": "def reverseBits(n: int) -> int:\n    result = 0\n    for _ in range(32):\n        result = (result << 1) | (n & 1)\n        n >>= 1\n    return result",
      "JavaScript": "var reverseBits = function(n) {\n    let result = 0;\n    for (let i = 0; i < 32; i++) {\n        result = (result << 1) | (n & 1);\n        n >>>= 1;\n    }\n    return result >>> 0;\n};"
    },
