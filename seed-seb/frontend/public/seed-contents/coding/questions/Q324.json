  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\nclass Solution(object):\n    def wiggleSort(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: void Do not return anything, modify nums in-place instead.\n        \"\"\"\n        nums.sort()\n        mid = (len(nums) - 1) / 2\n        nums[::2], nums[1::2] = nums[mid::-1], nums[:mid:-1]"
    },
