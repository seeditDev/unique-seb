  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "# Time:  O(n^2)\n# Space: O(n)\n\nimport math\n\n# Cantor ordering solution\nclass Solution(object):\n    def getPermutation(self, n, k):\n        \"\"\"\n        :type n: int\n        :type k: int\n        :rtype: str\n        \"\"\"\n        seq, k, fact = \"\", k - 1, math.factorial(n - 1)\n        perm = [i for i in range(1, n + 1)]\n        for i in reversed(range(n)):\n            curr = perm[k / fact]\n            seq += str(curr)\n            perm.remove(curr)\n            if i > 0:\n                k %= fact\n                fact /= i\n        return seq",
      "JavaScript": ""
    },
