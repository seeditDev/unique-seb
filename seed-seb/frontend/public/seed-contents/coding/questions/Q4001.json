  "content": {
    "problemStatement": "Write a C program to find the sum of two given numbers, 4 and 8. The program should compute the sum and display the result as output.",
    "constraints": [
      "1 <= T <= 100"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains no additional input.",
    "outputFormat": "For each test case, print the sum of 4 and 8 (which is 12) on a new line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1",
        "output": "12",
        "explanation": "There is a single test case, so the program prints 12 once."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2",
        "output": "12\n12",
        "explanation": "Two test cases require printing 12 on two separate lines."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "3",
        "output": "12\n12\n12",
        "explanation": "Three test cases result in three lines, each containing 12."
      }
    ]
  },
