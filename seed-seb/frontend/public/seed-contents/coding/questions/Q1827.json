  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def minOperations(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = prev = 0\n        for curr in nums:\n            if prev < curr:\n                prev = curr\n                continue\n            prev += 1\n            result += prev-curr                \n        return result"
    },
