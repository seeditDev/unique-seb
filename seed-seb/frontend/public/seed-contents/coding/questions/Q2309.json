  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string, hash table\nclass Solution(object):\n    def greatestLetter(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        lookup = set(s)\n        result = \"\"\n        for c in s:\n            if c.isupper() and lower(c) in s:\n                if c > result:\n                    result = c\n        return result"
    },
