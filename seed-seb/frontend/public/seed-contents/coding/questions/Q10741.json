    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nlong long nthFaithfulNumber(int N) {\n    vector<long long> powers(23);  // 23 is enough as 7^23 exceeds long long\n    \n    // Calculate powers of 7\n    powers[0] = 1;\n    for(int i = 1; i < 23; i++) {\n        powers[i] = powers[i-1] * 7;\n    }\n    \n    long long result = 0;\n    int pos = 0;\n    \n    while(N > 0) {\n        if(N & 1) {\n            result += powers[pos];\n        }\n        pos++;\n        N >>= 1;\n    }\n    \n    return result;\n}\n\nint main() {\n    int t;\n    cin >> t;\n    \n    while(t--) {\n        int n;\n        cin >> n;\n        cout << nthFaithfulNumber(n) << endl;\n    }\n    return 0;\n}",
