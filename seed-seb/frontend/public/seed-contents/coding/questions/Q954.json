  "solution": {
    "code": {
      "Python3": "# Time:  O(n + klogk)\n# Space: O(k)\n\nimport collections\n\n\nclass Solution(object):\n    def canReorderDoubled(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: bool\n        \"\"\"\n        count = collections.Counter(A)\n        for x in sorted(count, key=abs):\n            if count[x] > count[2*x]:\n                return False\n            count[2*x] -= count[x]\n        return True"
    },
