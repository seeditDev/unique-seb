  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2 * logn)\n# Space: O(n^2)\n\nimport fractions\n\nclass Solution(object):\n    def simplifiedFractions(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: List[str]\n        \"\"\"\n        lookup = set()\n        for b in range(1, n+1):\n            for a in range(1, b):\n                g = fractions.gcd(a, b)\n                lookup.add((a//g, b//g))\n        return map(lambda x: \"{}/{}\".format(*x), lookup)"
    },
