  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "",
      "Java": "",
      "Python3": "# Time:  O(k * C(n, k))\n# Space: O(k)\n\nclass Solution(object):\n    def combine(self, n, k):\n        \"\"\"\n        :type n: int\n        :type k: int\n        :rtype: List[List[int]]\n        \"\"\"\n        if k > n:\n            return []\n        nums, idxs = range(1, n+1), range(k)\n        result = [[nums[i] for i in idxs]]\n        while True:\n            for i in reversed(range(k)):\n                if idxs[i] != i+n-k:\n                    break\n            else:\n                break\n            idxs[i] += 1\n            for j in range(i+1, k):\n                idxs[j] = idxs[j-1]+1\n            result.append([nums[i] for i in idxs])\n        return result",
      "JavaScript": ""
    },
