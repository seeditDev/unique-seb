  "content": {
    "problemStatement": "You receive two integers `n` and `k`, output *all possible combinations of* `k` *numbers chosen from the range* `[1, n]`.\n\nYou may output the answer in **any order**.",
    "constraints": [
      "1 <= n <= 20",
      "1 <= k <= n"
    ],
    "inputFormat": "Single line: JSON array of all arguments, e.g. [arg1, arg2, ...]",
    "outputFormat": "Single line: JSON-serialised return value",
    "notes": [],
    "sampleTestCases": [
      {
