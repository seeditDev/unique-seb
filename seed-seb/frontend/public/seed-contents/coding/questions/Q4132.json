  "content": {
    "problemStatement": "Given an integer **N**, Calculate and print the number of digits present in **N**.",
    "constraints": [
      "1 <= T <= 10",
      "1 <= N <= 10^18",
      "All values are integers"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains a single integer N.",
    "outputFormat": "For each test case, output a single line containing the number of decimal digits in N.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n1543",
        "output": "4",
        "explanation": "1543 has four decimal digits: 1, 5, 4, 3."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n123456789",
        "output": "9",
        "explanation": "The number 123456789 consists of nine digits."
