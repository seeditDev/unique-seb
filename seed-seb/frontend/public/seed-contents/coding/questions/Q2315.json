  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def countAsterisks(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = cnt = 0\n        for c in s:\n            if c == '|':\n                cnt = (cnt+1)%2\n                continue\n            if c == '*' and cnt == 0:\n                result += 1\n        return result"
    },
