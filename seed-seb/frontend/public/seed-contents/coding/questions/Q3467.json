  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def transformArray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        cnt = 0\n        for x in nums:\n            if x%2:\n                continue\n            nums[cnt] = 0\n            cnt += 1\n        for i in range(cnt, len(nums)):\n            nums[i] = 1\n        return nums"
    },
