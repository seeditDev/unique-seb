  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def decimalRepresentation(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: List[int]\n        \"\"\"\n        result = []\n        base = 1\n        while n:\n            n, r = divmod(n, 10)\n            if r:\n                result.append(r*base)\n            base *= 10\n        result.reverse()\n        return result"
    },
