  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def largestOddNumber(self, num):\n        \"\"\"\n        :type num: str\n        :rtype: str\n        \"\"\"\n        for i in reversed(range(len(num))):\n            if int(num[i])%2:\n                return num[:i+1]\n        return \"\""
    },
