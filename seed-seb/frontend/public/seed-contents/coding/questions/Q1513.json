  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def numSub(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        MOD = 10**9+7\n        result, count = 0, 0\n        for c in s:\n            count = count+1 if c == '1' else 0\n            result = (result+count)%MOD\n        return result"
    },
