  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\nclass Solution(object):\n    def checkPowersOfThree(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: bool\n        \"\"\"\n        while n > 0:\n            if n%3 == 2:\n                return False\n            n //= 3\n        return True"
    },
