  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy\nclass Solution(object):\n    def getSmallestString(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: str\n        \"\"\"\n        result = map(int, s)\n        for i in range(len(s)-1):\n            if result[i]%2 != result[i+1]%2:\n                continue\n            if result[i] > result[i+1]:\n                result[i], result[i+1] = result[i+1], result[i]\n                break\n        return \"\".join(map(str, result))"
    },
