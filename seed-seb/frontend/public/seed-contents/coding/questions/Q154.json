  "solution": {
    "code": {
      "Python3": "# Time:  O(logn) ~ O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def findMin(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        left, right = 0, len(nums) - 1\n        while left < right:\n            mid = left + (right - left) / 2\n\n            if nums[mid] == nums[right]:\n                right -= 1\n            elif nums[mid] < nums[right]:\n                right = mid\n            else:\n                left = mid + 1\n\n        return nums[left]"
    },
