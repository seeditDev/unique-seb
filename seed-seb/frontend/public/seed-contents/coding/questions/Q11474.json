  "solution": {
    "approach": "The problem can be solved by using the formula 5 * (x / 5) if x is divisible by 5, otherwise 5 * ((x / 5) + 1).",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int x;\n    scanf(\"%d\", &x);\n    if (x % 5 == 0) printf(\"%d\\n\", x / 5);\n    else printf(\"%d\\n\", (x / 5) + 1);\n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int x;\n    cin >> x;\n    if (x % 5 == 0) cout << x / 5;\n    else cout << (x / 5) + 1;\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int x = scanner.nextInt();\n        if (x % 5 == 0) System.out.println(x / 5);\n        else System.out.println((x / 5) + 1);\n    }\n}",
      "Python3": "x = int(input())\nif x % 5 == 0:\n    print(x // 5)\nelse:\n    print((x // 5) + 1)",
      "JavaScript": "const readline = require('readline').createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nreadline.question('', (x) => {\n    x = parseInt(x);\n    if (x % 5 == 0) console.log(x / 5);\n    else console.log(Math.floor(x / 5) + 1);\n    readline.close();\n});"
    },
