  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# difference array\nclass Solution(object):\n    def subarraySum(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        diff = [0]*(len(nums)+1)\n        for i, x in enumerate(nums):\n            diff[max(i-x, 0)] += 1\n            diff[i+1] -= 1\n        for i in range(len(nums)):\n            diff[i+1] += diff[i]\n        return sum(nums[i]*diff[i] for i in range(len(nums)))"
    },
