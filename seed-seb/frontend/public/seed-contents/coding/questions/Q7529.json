  "content": {
    "problemStatement": "You are given a sequence A1,A2,…,ANA_1, A_2, \\ldots, A_NA1​,A2​,…,AN​ of distinct integers. While the sequence contains at least three elements, look at its first three elements, find the median among these elements and delete it. What will the final sequence be?",
    "constraints": [
      "1≤T≤741 \\le T \\le 741≤T≤74",
      "3≤N≤193 \\le N \\le 193≤N≤19",
      "1≤Ai≤1091 \\le A_i \\le 1091≤Ai​≤109 for each valid iii"
    ],
    "inputFormat": "The first line of the input contains a single integer TTT denoting the number of test cases. The description of TTT test cases follows.\nThe first line of each test case contains a single integer NNN.\nThe second line contains NNN space-separated integers A1,A2,…,ANA_1, A_2, \\ldots, A_NA1​,A2​,…,AN​.",
    "outputFormat": "For each test case, print a single line containing KKK space-separated integers, where KKK is the length of the final sequence. For each valid iii, the iii-th of these integers should be the iii-th element of the final sequence.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "2\n3\n2 5 3\n10\n38 9 102 10 96 7 46 28 88 13",
        "output": "2 5 \n102 7",
        "explanation": "Explanation:\nExample case 1: We remove the element 333 because it is the median of (2,5,3)(2, 5, 3)(2,5,3). The final sequence is (2,5)(2, 5)(2,5)."
      }
    ]
  },
