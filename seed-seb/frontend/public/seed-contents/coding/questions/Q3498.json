  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# string\nclass Solution(object):\n    def reverseDegree(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        return sum(i*(26-(ord(x)-ord('a'))) for i, x in enumerate(s, 1))"
    },
