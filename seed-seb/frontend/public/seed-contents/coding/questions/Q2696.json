  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# stack\nclass Solution(object):\n    def minLength(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        stk = []\n        for c in s:\n            if stk and ((stk[-1] == 'A' and c == 'B') or (stk[-1] == 'C' and c == 'D')):\n                stk.pop()\n                continue\n            stk.append(c)\n        return len(stk)"
    },
