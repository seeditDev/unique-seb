  "content": {
    "problemStatement": "Chef has XXX nuggets and YYY star pieces with him.\n\nEach nugget sells for 500050005000 coins, and each star piece sells for 980098009800 coins.\n\nHow much money can Chef make by selling all of his items?\n\n\nInput Format\n\nThe only line of input will contain two space-separated integers XXX and YYY — the number of nuggets and star pieces Chef has.\n\n\nOutput Format\nOutput a single integer: the amount of money Chef can earn by selling all his items.",
    "constraints": [
      "0≤X,Y≤100 \\leq X, Y \\leq 100≤X,Y≤10"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "2 3",
        "output": "39400",
        "explanation": "Explanation:\nThere are two nuggets and three star pieces, so Chef will obtain 2×5000+3×9800=10000+29400=394002\\times 5000 + 3\\times 9800 = 10000 + 29400 = 394002×5000+3×9800=10000+29400=39400 from selling them all."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "4 0",
        "output": "20000",
        "explanation": "Explanation:\nThere are four nuggets and no star pieces, Chef will obtain 4×5000=200004\\times 5000 = 200004×5000=20000 from selling them all."
      }
    ]
  },
