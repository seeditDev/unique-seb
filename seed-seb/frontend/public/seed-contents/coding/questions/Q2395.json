  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\n# hash table\nclass Solution(object):\n    def findSubarrays(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        lookup = set()\n        for i in range(len(nums)-1):\n            if nums[i]+nums[i+1] in lookup:\n                return True\n            lookup.add(nums[i]+nums[i+1])\n        return False"
    },
