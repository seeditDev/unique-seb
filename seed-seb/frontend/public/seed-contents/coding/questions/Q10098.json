  "content": {
    "problemStatement": "Chef knows that a starters will be organised on next Wednesday, i.e., Valentine's day.\n\nSince it is Starters 120120120 today, starters 121121121 is likely to be organised on Valentine's day.\n\nGiven an integer NNN, find whether starters NNN is likely to be organised on Valentine's day.\n\n\nInput Format\n\nThe input will contain a single integer NNN.\n\n\nOutput Format\nOutput `Likely` if starters NNN is likely to be organised on Valentine's day. Otherwise, output `Unlikely`.\n\n\nYou may print each character of the string in uppercase or lowercase (for example, the strings `LIKELY`, `likely`, `Likely`, and `lIkElY` will all be treated as identical).",
    "constraints": [
      "120≤N≤123120 \\leq N \\leq 123120≤N≤123."
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "121",
        "output": "Likely",
        "explanation": "Explanation:\nStarters 121121121 is likely on Valentine's day."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "120",
        "output": "Unlikely",
        "explanation": "Explanation:\nStarters 120120120 is unlikely on Valentine's day."
      }
    ]
  },
