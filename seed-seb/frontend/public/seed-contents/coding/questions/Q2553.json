  "solution": {
    "code": {
      "Python3": "# Time:  O(n * logr)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def separateDigits(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        result = []\n        for x in reversed(nums):\n            while x:\n                result.append(x%10)\n                x //= 10\n        result.reverse()\n        return result"
    },
