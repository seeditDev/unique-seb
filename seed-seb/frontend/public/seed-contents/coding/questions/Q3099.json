  "solution": {
    "code": {
      "Python3": "# Time:  O(logx)\n# Space: O(1)\n\n# math\nclass Solution(object):\n    def sumOfTheDigitsOfHarshadNumber(self, x):\n        \"\"\"\n        :type x: int\n        :rtype: int\n        \"\"\"\n        result = 0\n        y = x\n        while y:\n            y, r = divmod(y, 10)\n            result += r\n        return result if x%result == 0 else -1"
    },
