  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def countSubarrays(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        return sum((nums[i-1]+nums[i+1])*2 == nums[i] for i in range(1, len(nums)-1))"
    },
