  "content": {
    "problemStatement": "Write a C program that prints the count of uppercase and lowercase alphabets in the given string.\n\nTask\nA string variable **str** is given in the IDE, with some string assigned to it.\nThe string consists of only English alphabets.\nCount the uppercase and lowercase alphabets and print them on console with a space between them.",
    "constraints": [
      "1 <= T <= 100",
      "1 <= |S| <= 100",
      "S contains only characters 'A'-'Z' and 'a'-'z'"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains a non‑empty string S consisting only of English alphabet letters (A‑Z, a‑z).",
    "outputFormat": "For each test case output two integers separated by a space: the number of uppercase letters and the number of lowercase letters in S. Print each test case result on its own line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "2\nChefSaysHi\nHelloWorld",
        "output": "3 7\n2 8",
        "explanation": "First string: uppercase letters C, S, H → 3, lowercase letters → 7. Second string: uppercase letters H, W → 2, lowercase letters → 8."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\nABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "output": "26 0",
        "explanation": "All 26 characters are uppercase, no lowercase letters."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\naaaaaaaaaa",
        "output": "0 10",
        "explanation": "All characters are lowercase, so uppercase count is 0 and lowercase count is 10."
      }
    ]
  },
