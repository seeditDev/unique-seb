  "solution": {
    "code": {
      "Python3": "# Time:  O(2^n)\n# Space: O(2^n)\n\nclass Solution(object):\n    def lastStoneWeightII(self, stones):\n        \"\"\"\n        :type stones: List[int]\n        :rtype: int\n        \"\"\"\n        dp = {0}\n        for stone in stones:\n            dp |= {stone+i for i in dp}\n        S = sum(stones)\n        return min(abs(i-(S-i)) for i in dp)"
    },
