  "content": {
    "problemStatement": "Write a program to output the squares (using multiplication) of numbers from 1 to 5 on separate lines.",
    "constraints": [
      "1 <= T <= 10"
    ],
    "inputFormat": "First line contains T, the number of test cases.",
    "outputFormat": "For each test case, print the squares of numbers from 1 to 5, each on its own line in the format 'i - i*i'. The outputs of consecutive test cases are printed one after another without extra blank lines.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1",
        "output": "1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25",
        "explanation": "With a single test case, the program prints the squares of 1 through 5 once."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2",
        "output": "1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25\n1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25",
        "explanation": "Two test cases cause the block of five lines to be printed twice consecutively."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "3",
        "output": "1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25\n1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25\n1 - 1\n2 - 4\n3 - 9\n4 - 16\n5 - 25",
        "explanation": "Three test cases repeat the pattern three times."
      }
    ]
  },
