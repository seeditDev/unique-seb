  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# dp\nclass Solution(object):\n    def secondsToRemoveOccurrences(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = cnt = 0\n        for c in s: \n            if c == '0':\n                cnt += 1\n                continue\n            if cnt:\n                result = max(result+1, cnt)\n        return result"
    },
