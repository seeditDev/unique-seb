  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\n# freq table\nclass Solution(object):\n    def divideArray(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        return all(cnt%2 == 0 for cnt in collections.Counter(nums).itervalues())"
    },
