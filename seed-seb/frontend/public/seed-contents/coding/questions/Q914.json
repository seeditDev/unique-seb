  "solution": {
    "code": {
      "Python3": "# Time:  O(n * (logn)^2)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def hasGroupsSizeX(self, deck):\n        \"\"\"\n        :type deck: List[int]\n        :rtype: bool\n        \"\"\"\n        def gcd(a, b):  # Time: O((logn)^2)\n            while b:\n                a, b = b, a % b\n            return a\n\n        vals = collections.Counter(deck).values()\n        return reduce(gcd, vals) >= 2"
    },
