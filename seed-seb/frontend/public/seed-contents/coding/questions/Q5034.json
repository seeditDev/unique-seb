  "solution": {
    "approach": "Start with fuel = 40. Apply the operations in order: divide by 2, divide by 2, add 10, divide by 2. The result is deterministic, so just compute it and print with two decimal places.",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main(){double fuel=40.0;fuel/=2.0;fuel/=2.0;fuel+=10.0;fuel/=2.0;printf(\"%.2f\\n\",fuel);return 0;}",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;int main(){double fuel=40.0;fuel/=2.0;fuel/=2.0;fuel+=10.0;fuel/=2.0;cout.setf(ios::fixed);cout<<setprecision(2)<<fuel<<\"\\n\";return 0;}",
      "Java": "import java.util.*;public class Main{public static void main(String[] args){double fuel=40.0;fuel/=2.0;fuel/=2.0;fuel+=10.0;fuel/=2.0;System.out.printf(\"%.2f\\n\",fuel);}}",
      "Python3": "fuel=40.0\nfuel/=2.0\nfuel/=2.0\nfuel+=10.0\nfuel/=2.0\nprint(f\"{fuel:.2f}\")",
      "JavaScript": "const fs=require('fs');let fuel=40.0;fuel/=2.0;fuel/=2.0;fuel+=10.0;fuel/=2.0;console.log(fuel.toFixed(2));"
    },
