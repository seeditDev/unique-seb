  "content": {
    "problemStatement": "You have a car with a starting fuel level of 40 liters. Each day, you either burn half the fuel or refuel by adding 10 liters. Finally, you want to display the remaining fuel, rounded to 2 decimal places.\n\n\nDay 1: Burn half (÷2)\nDay 2: Burn half again (÷2)\nRefuel: Add 10 liters\nDay 3: Burn half once more (÷2)",
    "constraints": [
      "The operations are fixed; there are no variable inputs."
    ],
    "inputFormat": "No input required.",
    "outputFormat": "Print the remaining fuel after the described operations, rounded to 2 decimal places.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "",
        "output": "10.00",
        "explanation": "Starting from 40 L: after Day 1 → 20 L, after Day 2 → 10 L, after refuel → 20 L, after Day 3 → 10 L. Printed with two decimals gives 10.00."
      }
    ]
  },
