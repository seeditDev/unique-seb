  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogr)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def sumOfEncryptedInt(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        def f(x):\n            mx = base = 0\n            while x:\n                mx = max(mx, x%10)\n                x //= 10\n                base = 10*base+1\n            return mx*base\n\n        return sum(f(x) for x in nums)"
    },
