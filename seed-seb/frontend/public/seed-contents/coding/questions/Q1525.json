  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    def numSplits(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        left_count, right_count = collections.Counter(), collections.Counter(s)\n        result = 0\n        for c in s:\n            left_count[c] += 1\n            right_count[c] -= 1\n            if not right_count[c]:\n                del right_count[c]\n            if len(left_count) == len(right_count):\n                result += 1\n        return result"
    },
