  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nimport collections\n\n\nclass Solution(object):\n    def numPairsDivisibleBy60(self, time):\n        \"\"\"\n        :type time: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        count = collections.Counter()\n        for t in time:\n            result += count[-t%60]\n            count[t%60] += 1\n        return result"
    },
