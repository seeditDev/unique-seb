  "solution": {
    "code": {
      "Python3": "# Time:  O(m * n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def rowAndMaximumOnes(self, mat):\n        \"\"\"\n        :type mat: List[List[int]]\n        :rtype: List[int]\n        \"\"\"\n        return max(([i, mat[i].count(1)] for i in range(len(mat))), key=lambda x: x[1])"
