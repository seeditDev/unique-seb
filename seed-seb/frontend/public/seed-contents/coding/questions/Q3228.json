  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# greedy\nclass Solution(object):\n    def maxOperations(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        result = curr = 0\n        for i in range(len(s)):\n            if s[i] == '1':\n                curr += 1\n            elif i+1 == len(s) or s[i+1] == '1':\n                result += curr\n        return result"
    },
