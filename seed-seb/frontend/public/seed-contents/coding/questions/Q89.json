  "solution": {
    "code": {
      "Python3": "# Time:  O(2^n)\n# Space: O(1)\n\nclass Solution(object):\n    def grayCode(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: List[int]\n        \"\"\"\n        result = [0]\n        for i in range(n):\n            for n in reversed(result):\n                result.append(1 << i | n)\n        return result"
    },
