  "solution": {
    "approach": "Direct Calculation",
    "timeComplexity": "O(1)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nint main() {\n    int T, N;\n    scanf(\"%d\", &T);\n    while (T--) {\n        scanf(\"%d\", &N);\n        printf(\"%d\\n\", N);\n    }\n    return 0;\n}",
      "C++": "#include <iostream>\nusing namespace std;\nint main() {\n    int T, N;\n    cin >> T;\n    while (T--) {\n        cin >> N;\n        cout << N << endl;\n    }\n    return 0;\n}",
      "Java": "import java.util.Scanner;\npublic class Main {\n    public static void main(String[] args) {\n        Scanner scanner = new Scanner(System.in);\n        int T = scanner.nextInt();\n        while (T-- > 0) {\n            int N = scanner.nextInt();\n            System.out.println(N);\n        }\n    }\n}",
      "Python3": "T = int(input())\nfor _ in range(T):\n    N = int(input())\n    print(N)",
      "JavaScript": "const readline = require('readline').createInterface({\n    input: process.stdin,\n    output: process.stdout\n});\nlet i = 0;\nlet T;\nreadline.on('line', line => {\n    if (i === 0) {\n        T = parseInt(line);\n        i++;\n    } else {\n        console.log(parseInt(line));\n        i++;\n        if (i > T) {\n            readline.close();\n        }\n    }\n});"
    },
