    "code": {
      "C": "",
      "C++": "",
      "Java": "//Solution as follows\n\nprocess.stdin.setEncoding('utf8');\nprocess.stdin.on('data', function(input) {\n  const N = parseInt(input.trim());\n  const square = N * N;\n  const cube = N * N * N;\n  console.log(\"Square is:\", square);\n  console.log(\"Cube is:\", cube);\n});",
