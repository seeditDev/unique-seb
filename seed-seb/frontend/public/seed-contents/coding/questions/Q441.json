  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\nimport math\n\n\nclass Solution(object):\n    def arrangeCoins(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: int\n        \"\"\"\n        return int((math.sqrt(8*n+1)-1) / 2)  # sqrt is O(logn) time."
