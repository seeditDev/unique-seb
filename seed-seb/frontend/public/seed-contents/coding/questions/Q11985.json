  "content": {
    "problemStatement": "Write a program for the coding challenge \"Binary Tree to Doubly Linked List\". Refer to LeetCode description: https://leetcode.com/problems/flatten-binary-tree-to-linked-list/",
    "constraints": [
      "1 <= number of nodes <= 10^4",
      "0 <= Node.val <= 10^4"
    ],
    "inputFormat": "The input is the root of a binary tree where each node has a unique value.",
    "outputFormat": "The output is the root of the resulting doubly linked list.",
    "notes": [],
    "sampleTestCases": []
  },
