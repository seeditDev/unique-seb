  "content": {
    "problemStatement": "Write a C program that calculates and prints the sum of the squares of all numbers from 1 to a given positive integer n using a for loop.",
    "constraints": [
      "1 <= T <= 1000",
      "1 <= N <= 10000",
      "All values fit in 64‑bit signed integer"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains a single positive integer N.",
    "outputFormat": "For each test case, output a single line containing the sum of squares of all integers from 1 to N.",
    "notes": [],
