  "solution": {
    "approach": "Linear Search",
    "timeComplexity": "O(N)",
    "spaceComplexity": "O(1)",
    "code": {
      "C": "#include <stdio.h>\nbool searchInRotatedSortedArrayII(int* arr, int arrSize, int k) {\n    for (int i = 0; i < arrSize; i++) {\n        if (arr[i] == k) return true;\n    }\n    return false;\n}",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\nclass Solution {\npublic:\n    bool searchInARotatedSortedArrayII(vector<int>& arr, int k) {\n        int n = arr.size();\n        for (int i = 0; i < n; i++) {\n            if (arr[i] == k) return true;\n        }\n        return false;\n    }\n};",
      "Java": "import java.util.*;\nclass Solution {\n    public boolean searchInARotatedSortedArrayII(int[] arr, int k) {\n        for (int num : arr) {\n            if (num == k) return true;\n        }\n        return false;\n    }\n}",
      "Python3": "class Solution:\n    def search_in_rotated_sorted_array_II(self, arr, k):\n        for num in arr:\n            if num == k:\n                return True\n        return False",
      "JavaScript": "class Solution {\n    searchInRotatedSortedArrayII(arr, k) {\n        for (let num of arr) {\n            if (num === k) return true;\n        }\n        return false;\n    }\n}"
    },
