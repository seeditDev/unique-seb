  "content": {
    "problemStatement": "Given an integer array arr of size N, sorted in ascending order (may contain duplicate values) and a target value k. Now the array is rotated at some pivot point unknown to you. Return True if k is present and otherwise, return False.",
    "constraints": [
      "1 <= N <= 10^5",
      "1 <= arr[i] <= 10^5",
      "1 <= k <= 10^5"
    ],
    "inputFormat": "arr = list of integers, k = target integer",
    "outputFormat": "boolean indicating whether k is present in arr",
    "notes": [],
    "sampleTestCases": []
  },
