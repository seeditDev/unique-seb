  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(n^2)\n\nimport collections\n\n\nclass Solution(object):\n    def tupleSameProduct(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        count = collections.Counter()\n        for i in range(len(nums)):\n            for j in range(i+1, len(nums)): \n                result += count[nums[i]*nums[j]]\n                count[nums[i]*nums[j]] += 1\n        return 8*result"
    },
