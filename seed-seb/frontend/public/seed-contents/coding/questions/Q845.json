  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n\nclass Solution(object):\n    def longestMountain(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        result, up_len, down_len = 0, 0, 0\n        for i in range(1, len(A)):\n            if (down_len and A[i-1] < A[i]) or A[i-1] == A[i]:\n                up_len, down_len = 0, 0\n            up_len += A[i-1] < A[i]\n            down_len += A[i-1] > A[i]\n            if up_len and down_len:\n                result = max(result, up_len+down_len+1)\n        return result"
    },
