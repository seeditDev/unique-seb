  "content": {
    "problemStatement": "Given an integer array nums, rotate the array to the left by one.\n\n\n\n**Note:** There is no need to return anything, just modify the given array.",
    "constraints": [
      "1 <= n <= 10^5",
      "-10^9 <= nums[i] <= 10^9"
    ],
    "inputFormat": "The input is an array of integers.",
    "outputFormat": "The output is the modified array after rotating it to the left by one position.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "nums = [1, 2, 3, 4, 5]",
        "output": "[2, 3, 4, 5, 1]",
        "explanation": "Initially, nums = [1, 2, 3, 4, 5]  \nRotating once to the left results in nums = [2, 3, 4, 5, 1].\n\n**Example 2:**"
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "nums = [-1, 0, 3, 6]",
        "output": "[0, 3, 6, -1]",
        "explanation": "Initially, nums = [-1, 0, 3, 6]  \nRotating once to the left results in nums = [0, 3, 6, -1].\n        \n    \n\n\n\n**Disclaimer**: Here is the practice link to help you assess your knowledge better. It's highly recommend trying to solve it before looking at the solution."
      }
    ]
  },
