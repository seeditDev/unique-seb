  "solution": {
    "approach": "Use a temporary array to store the rotated elements.",
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "code": {
      "C": "#include <stdio.h>\nvoid rotate(int* nums, int numsSize) {\n    int temp = nums[0];\n    for (int i = 0; i < numsSize - 1; i++) {\n        nums[i] = nums[i + 1];\n    }\n    nums[numsSize - 1] = temp;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\nvoid rotate(int* nums, int numsSize) {\n    int temp = nums[0];\n    for (int i = 0; i < numsSize - 1; i++) {\n        nums[i] = nums[i + 1];\n    }\n    nums[numsSize - 1] = temp;\n}\n",
      "Java": "public class Solution {\n    public void rotate(int[] nums) {\n        int temp = nums[0];\n        for (int i = 0; i < nums.length - 1; i++) {\n            nums[i] = nums[i + 1];\n        }\n        nums[nums.length - 1] = temp;\n    }\n}\n",
      "Python3": "def rotate(nums):\n    temp = nums[0]\n    for i in range(len(nums) - 1):\n        nums[i] = nums[i + 1]\n    nums[-1] = temp\n",
      "JavaScript": "var rotate = function(nums) {\n    let temp = nums[0];\n    for (let i = 0; i < nums.length - 1; i++) {\n        nums[i] = nums[i + 1];\n    }\n    nums[nums.length - 1] = temp;\n};\n"
    },
