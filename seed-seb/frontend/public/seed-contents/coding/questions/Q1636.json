  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def frequencySort(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: List[int]\n        \"\"\"\n        count = collections.Counter(nums)\n        return sorted(nums, key=lambda x: (count[x], -x))"
    },
