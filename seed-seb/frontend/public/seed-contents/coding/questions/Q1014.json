  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def maxScoreSightseeingPair(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        result, curr = 0, 0\n        for x in A:\n            result = max(result, curr+x)\n            curr = max(curr, x)-1\n        return result"
    },
