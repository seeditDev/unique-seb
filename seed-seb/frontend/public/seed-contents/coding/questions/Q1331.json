  "solution": {
    "code": {
      "Python3": "# Time:  O(nlogn)\n# Space: O(n)\n\nclass Solution(object):\n    def arrayRankTransform(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: List[int]\n        \"\"\"\n        return map({x: i+1 for i, x in enumerate(sorted(set(arr)))}.get, arr)"
    },
