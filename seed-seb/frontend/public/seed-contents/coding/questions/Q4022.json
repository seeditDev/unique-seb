  "content": {
    "problemStatement": "Write a C program that takes an integer as input and prints its reverse. Use a while loop for the reversal process.",
    "constraints": [
      "1 <= T <= 10",
      "|N| <= 1000000",
      "N is an integer"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single integer N.",
    "outputFormat": "For each test case, print the integer obtained by reversing the decimal digits of N while preserving its sign, each on a new line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n12345",
        "output": "54321",
        "explanation": "Reversing 12345 yields 54321."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n98765",
        "output": "56789",
        "explanation": "Reversing 98765 yields 56789."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n10001",
        "output": "10001",
        "explanation": "10001 is a palindrome, so its reverse is the same."
      }
    ]
  },
