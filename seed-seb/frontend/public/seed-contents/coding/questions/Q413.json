  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def numberOfArithmeticSlices(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        res, i = 0, 0\n        while i+2 < len(A):\n            start = i\n            while i+2 < len(A) and A[i+2] + A[i] == 2*A[i+1]:\n                res += i - start + 1\n                i += 1\n            i += 1\n\n        return res"
    },
