  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\nclass Solution(object):\n    def maximum69Number (self, num):\n        \"\"\"\n        :type num: int\n        :rtype: int\n        \"\"\"\n        curr, base, change = num, 3, 0\n        while curr:\n            if curr%10 == 6:\n                change = base\n            base *= 10\n            curr //= 10\n        return num+change"
    },
