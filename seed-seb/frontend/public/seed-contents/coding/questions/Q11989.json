  "solution": {
    "approach": "Use a priority queue or sorting to find the k-th largest element.",
    "timeComplexity": "O(n log n) for sorting, O(n log k) for priority queue",
    "spaceComplexity": "O(n) for sorting, O(k) for priority queue",
    "code": {
      "C": "#include <stdio.h>\n#include <stdlib.h>\nint compare(const void *a, const void *b) { return (*(int*)a - *(int*)b); }\nint findKthLargest(int* nums, int numsSize, int k) {\n    qsort(nums, numsSize, sizeof(int), compare);\n    return nums[numsSize - k];\n}",
      "C++": "#include <algorithm>\nusing namespace std;\nint findKthLargest(vector<int>& nums, int k) {\n    sort(nums.begin(), nums.end());\n    return nums[nums.size() - k];\n}",
      "Java": "import java.util.Arrays;\npublic class Solution {\n    public int findKthLargest(int[] nums, int k) {\n        Arrays.sort(nums);\n        return nums[nums.length - k];\n    }\n}",
      "Python3": "def findKthLargest(nums, k):\n    nums.sort()\n    return nums[-k]",
      "JavaScript": "function findKthLargest(nums, k) {\n    nums.sort((a, b) => a - b);\n    return nums[nums.length - k];\n}"
    },
