    "problemStatement": "Write a program for the coding challenge \"K-th largest element in an unsorted array.\". Refer to LeetCode description: https://leetcode.com/problems/kth-largest-element-in-an-array/",
    "constraints": [
      "1 <= k <= n",
      "1 <= n <= 10^4",
      "-10^4 <= nums[i] <= 10^4"
    ],
    "inputFormat": "The input will be an array of integers and an integer k, where k is the position of the element to be found.",
    "outputFormat": "The output will be the k-th largest element in the array.",
