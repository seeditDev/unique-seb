  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "#include <stdio.h>\n\n\nint main() {\n    int t;\n    scanf(\"%d\", &t);\n\n    while (t--) {\n        char str[1002];\n        scanf(\"%s\", str);\n        int sum = 0; \n        for (int i = 0; str[i] != '\\0'; i++) {\n            char ch = str[i];\n            if (ch >= '0' && ch <= '9') {\n                sum += str[i] - '0'; // Convert character to integer and add to sum\n            }\n        }\n        printf(\"%d\\n\", sum);\n    }\n\n    return 0;\n}\n",
      "C++": "#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    int t;\n    cin >> t;\n\n    while (t--) {\n        string str;\n        cin >> str;\n        int sum = 0; \n        for (char ch : str) {\n            if (ch >= '0' && ch <= '9') {\n                sum += ch - '0'; // Convert character to integer and add to sum\n            }\n        }\n        cout << sum << endl;\n    }\n\n    return 0;\n}\n",
