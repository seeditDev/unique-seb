      "Java": "",
      "Python3": "import sys\n\ndef check_password_strength():\n    password = sys.stdin.readline().strip()\n    \n    has_digit = False\n    has_upper = False\n    has_special = False\n    special_chars = \"!@#$%\"\n    \n    if len(password) < 8:\n        print(\"Weak\")\n        return\n        \n    for char in password:\n        if char.isdigit():\n            has_digit = True\n        elif char.isupper():\n            has_upper = True\n        elif char in special_chars:\n            has_special = True\n            \n    if has_digit and has_upper and has_special:\n        print(\"Strong\")\n    else:\n        print(\"Weak\")\n\ncheck_password_strength()",
      "JavaScript": ""
