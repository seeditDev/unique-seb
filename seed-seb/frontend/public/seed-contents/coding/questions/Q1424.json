  "solution": {
    "code": {
      "Python3": "# Time:  O(m * n)\n# Space: O(m)\n\nimport itertools\nimport collections\n\n\nclass Solution(object):\n    def findDiagonalOrder(self, nums):\n        \"\"\"\n        :type nums: List[List[int]]\n        :rtype: List[int]\n        \"\"\"\n        result, dq, col = [], collections.deque(), 0\n        for i in range(len(nums)+max(itertools.imap(len, nums))-1):\n            new_dq = collections.deque()\n            if i < len(nums):\n                dq.appendleft((i, 0))\n            for r, c in dq:\n                result.append(nums[r][c])\n                if c+1 < len(nums[r]):\n                    new_dq.append((r, c+1))\n            dq = new_dq\n        return result"
    },
