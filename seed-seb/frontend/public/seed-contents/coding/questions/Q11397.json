  "content": {
    "problemStatement": "Given the roots of two binary trees root and subRoot, return true if there is a subtree of root with the same structure and node values of subRoot and false otherwise.",
    "constraints": [
      "1 <= number of nodes in the tree <= 2000",
      "The input trees will not be empty",
      "All node values will be unique"
    ],
    "inputFormat": "The input will contain two binary trees represented as a root node. Each node will have an integer value and references to its left and right children.",
    "outputFormat": "A boolean value indicating whether there is a subtree of the first tree that matches the second tree.",
    "notes": [],
    "sampleTestCases": []
  },
