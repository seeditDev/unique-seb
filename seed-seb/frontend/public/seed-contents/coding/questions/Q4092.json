  "content": {
    "problemStatement": "Create a program to perform the following:\n\n\nDeclare two integer variables **a** and **b**.\nAssign the value 202020 to **a** and 666 to **b**.\nprint the result of **a / b**.",
    "constraints": [
      "a = 202020",
      "b = 666",
      "Result fits in 32‑bit signed integer"
    ],
    "inputFormat": "No input required.",
    "outputFormat": "Print a single line containing the integer result of 202020 divided by 666.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "",
        "output": "303",
        "explanation": "202020 divided by 666 using integer division yields 303."
      },
      {
