  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def alternatingSum(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        return sum(nums[i] for i in range(0, len(nums), 2))-sum(nums[i] for i in range(1, len(nums), 2))"
    },
