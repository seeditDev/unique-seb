  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def repeatedNTimes(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        for i in range(2, len(A)):\n            if A[i-1] == A[i] or A[i-2] == A[i]:\n                return A[i]\n        return A[0]"
    },
