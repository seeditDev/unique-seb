  "content": {
    "problemStatement": "Given two space separated integers as user inputs, print `YES` if their sum is even else `NO`.",
    "constraints": [
      "1 <= T <= 1000",
      "-1000 <= a <= 1000",
      "-1000 <= b <= 1000"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains two space-separated integers a and b.",
    "outputFormat": "For each test case, print a single line containing \"YES\" if a+b is even, otherwise \"NO\".",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n2 3",
        "output": "NO",
        "explanation": "2 + 3 = 5 which is odd, so the answer is NO."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n3 5",
        "output": "YES",
        "explanation": "3 + 5 = 8 which is even, so the answer is YES."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n-1 1",
        "output": "YES",
        "explanation": "-1 + 1 = 0 which is even, so the answer is YES."
      }
    ]
  },
