    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h> \nusing namespace std;\n\nint minOperations(vector<int>& arr) {\n    int operations = 0;\n    int i = 0;               // left pointer\n    int j = arr.size() - 1;  // right pointer\n    \n    // Keep going until pointers meet\n    while(i < j) {\n        if(arr[i] == arr[j]) {\n            // If equal, move both pointers\n            i++;\n            j--;\n        }\n        else {\n            operations++;  // need one operation\n            \n            // Always combine elements at smaller end\n            if(arr[i] < arr[j]) {\n                arr[i+1] = arr[i] + arr[i+1];  // combine with next element\n                i++;\n            }\n            else {\n                arr[j-1] = arr[j] + arr[j-1];  // combine with previous element\n                j--;\n            }\n        }\n    }\n    \n    return operations;\n}\n\nint main() {\n    int T;\n    cin >> T;\n    \n    while(T--) {\n        int N;\n        cin >> N;\n        \n        vector<int> arr(N);\n        for(int i = 0; i < N; i++) {\n            cin >> arr[i];\n        }\n        \n        cout << minOperations(arr) << endl;\n    }\n    \n    return 0;\n}",
