  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def numWays(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: int\n        \"\"\"\n        MOD = 10**9+7\n\n        ones = s.count('1')\n        if ones % 3:\n            return 0\n        ones //= 3\n        if ones == 0:\n            return (len(s)-1)*(len(s)-2)//2 % MOD\n        count = left = right = 0\n        for c in s:\n            if c == '1':\n                count += 1\n            if count == ones:\n                left += 1\n            elif count == 2*ones:\n                right += 1\n        return left*right % MOD"
    },
