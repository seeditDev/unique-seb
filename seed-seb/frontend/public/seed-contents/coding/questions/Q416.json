  "solution": {
    "code": {
      "Python3": "# Time:  O(n * s), s is the sum of nums\n# Space: O(s)\n\nclass Solution(object):\n    def canPartition(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: bool\n        \"\"\"\n        s = sum(nums)\n        if s % 2:\n            return False\n\n        dp = [False] * (s/2 + 1)\n        dp[0] = True\n        for num in nums:\n            for i in reversed(range(1, len(dp))):\n                if num <= i:\n                    dp[i] = dp[i] or dp[i - num]\n        return dp[-1]"
    },
