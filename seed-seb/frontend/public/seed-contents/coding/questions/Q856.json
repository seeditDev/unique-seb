  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n\nclass Solution(object):\n    def scoreOfParentheses(self, S):\n        \"\"\"\n        :type S: str\n        :rtype: int\n        \"\"\"\n        result, depth = 0, 0\n        for i in range(len(S)):\n            if S[i] == '(':\n                depth += 1\n            else:\n                depth -= 1\n                if S[i-1] == '(':\n                    result += 2**depth\n        return result"
    },
