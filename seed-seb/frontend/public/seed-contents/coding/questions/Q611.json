  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(1)\n\nclass Solution(object):\n    def triangleNumber(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        nums.sort()\n        for i in reversed(range(2, len(nums))):\n            left, right = 0, i-1\n            while left < right:\n                if nums[left]+nums[right] > nums[i]:\n                    result += right-left\n                    right -= 1\n                else:\n                    left += 1\n        return result"
    },
