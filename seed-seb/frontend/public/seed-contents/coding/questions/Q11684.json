    "problemStatement": "Write a program for the coding challenge \"Playoff Tournament\". Refer to LeetCode description: https://codeforces.com/contest/1535/problem/D?locale=en",
    "constraints": [
      "2 <= n <= 2^30",
      "1 <= rating <= 10^9"
    ],
    "inputFormat": "The first line contains an integer n, the number of teams. The second line contains n integers, the ratings of the teams.",
    "outputFormat": "The output should be the minimum number of matches required to determine the winner.",
