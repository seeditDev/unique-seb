      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# array\nclass Solution(object):\n    def minOperations(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        return 0 if all(x == nums[0] for x in nums) else 1"
