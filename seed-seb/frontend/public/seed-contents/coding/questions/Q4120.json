  "content": {
    "problemStatement": "Write a program that takes t test cases as input, then for each test case, reads an integer N, and prints N + 1.",
    "constraints": [
      "1 <= T <= 100",
      "-1000 <= N <= 1000"
    ],
    "inputFormat": "First line contains T, the number of test cases. Each test case contains a single integer N.",
    "outputFormat": "For each test case, print N+1 on a new line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3\n4\n2\n-1",
        "output": "5\n3\n0",
        "explanation": "Each N is increased by one: 4→5, 2→3, -1→0."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "2\n10\n20",
        "output": "11\n21",
        "explanation": "10→11 and 20→21."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n-5",
        "output": "-4",
        "explanation": "-5 increased by one gives -4."
      }
    ]
  },
