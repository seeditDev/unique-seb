  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\n# dp\nclass Solution(object):\n    def countAlternatingSubarrays(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = curr = 0\n        for i in range(len(nums)):\n            if i-1 >= 0 and nums[i-1] == nums[i]:\n                curr = 0\n            curr += 1\n            result += curr\n        return result"
    },
