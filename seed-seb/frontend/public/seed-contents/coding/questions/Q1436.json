  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport itertools\n\n\nclass Solution(object):\n    def destCity(self, paths):\n        \"\"\"\n        :type paths: List[List[str]]\n        :rtype: str\n        \"\"\"\n        A, B = map(set, itertools.izip(*paths))\n        return (B-A).pop()"
