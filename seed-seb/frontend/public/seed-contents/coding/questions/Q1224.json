  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\nclass Solution(object):\n    def maxEqualFreq(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = 0\n        count = collections.Counter()\n        freq = [0 for _ in range(len(nums)+1)]\n        for i, n in enumerate(nums, 1):\n            freq[count[n]] -= 1\n            freq[count[n]+1] += 1\n            count[n] += 1\n            c = count[n]\n            if freq[c]*c == i and i < len(nums):\n                result = i+1\n            remain = i-freq[c]*c\n            if freq[remain] == 1 and remain in [1, c+1]:\n                result = i\n        return result"
    },
