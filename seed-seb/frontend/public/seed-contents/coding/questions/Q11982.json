  "content": {
    "problemStatement": "Write a program for the coding challenge \"Ceil in a BST\". Refer to LeetCode description: N/A",
    "constraints": [
      "1 <= Number of nodes in the BST <= 10^4",
      "1 <= Node values <= 10^4",
      "1 <= Target value <= 10^4"
    ],
    "inputFormat": "The input will contain a binary search tree and a target value. The binary search tree will be represented as a list of nodes where each node is a list containing the node's value and references to its left and right children. The target value will be an integer.",
    "outputFormat": "The output will be the smallest value in the binary search tree that is greater than or equal to the target value. If no such value exists, the output will be -1.",
