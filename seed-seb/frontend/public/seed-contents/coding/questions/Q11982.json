  "solution": {
    "approach": "Recursive/Iterative traversal of the BST to find the smallest value greater than or equal to the target",
    "timeComplexity": "O(h) where h is the height of the BST",
    "spaceComplexity": "O(h) for recursive call stack",
    "code": {
      "C": "#include <stdio.h>\n// Define the structure for a BST node\ntypedef struct Node {\n    int val;\n    struct Node* left;\n    struct Node* right;\n} Node;\n\nint findCeil(Node* root, int target) {\n    int res = -1;\n    while (root) {\n        if (root->val == target) return root->val;\n        if (root->val > target) {\n            res = root->val;\n            root = root->left;\n        } else {\n            root = root->right;\n        }\n    }\n    return res;\n}\n",
      "C++": "#include <iostream>\nusing namespace std;\n// Define the structure for a BST node\nstruct Node {\n    int val;\n    Node* left;\n    Node* right;\n};\n\nint findCeil(Node* root, int target) {\n    int res = -1;\n    while (root) {\n        if (root->val == target) return root->val;\n        if (root->val > target) {\n            res = root->val;\n            root = root->left;\n        } else {\n            root = root->right;\n        }\n    }\n    return res;\n}\n",
      "Java": "class Node {\n    int val;\n    Node left;\n    Node right;\n    Node(int val) {\n        this.val = val;\n        left = null;\n        right = null;\n    }\n}\npublic class Main {\n    public static int findCeil(Node root, int target) {\n        int res = -1;\n        while (root != null) {\n            if (root.val == target) return root.val;\n            if (root.val > target) {\n                res = root.val;\n                root = root.left;\n            } else {\n                root = root.right;\n            }\n        }\n        return res;\n    }\n}\n",
      "Python3": "class Node:\n    def __init__(self, val):\n        self.val = val\n        self.left = None\n        self.right = None\n\ndef findCeil(root, target):\n    res = -1\n    while root:\n        if root.val == target: return root.val\n        if root.val > target:\n            res = root.val\n            root = root.left\n        else:\n            root = root.right\n    return res\n",
      "JavaScript": "class Node {\n    constructor(val) {\n        this.val = val;\n        this.left = null;\n        this.right = null;\n    }\n}\nfunction findCeil(root, target) {\n    let res = -1;\n    while (root) {\n        if (root.val === target) return root.val;\n        if (root.val > target) {\n            res = root.val;\n            root = root.left;\n        } else {\n            root = root.right;\n        }\n    }\n    return res;\n}\n"
    },
