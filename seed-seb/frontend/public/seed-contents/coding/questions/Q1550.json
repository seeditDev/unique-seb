  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def threeConsecutiveOdds(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: bool\n        \"\"\"\n        count = 0\n        for x in arr:\n            count = count+1 if x%2 else 0\n            if count == 3:\n                return True\n        return False"
    },
