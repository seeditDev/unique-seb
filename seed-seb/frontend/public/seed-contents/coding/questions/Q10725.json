  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nvector<int> solve(int N) {\n    vector<int> denominations = {2000, 500, 200, 100, 50, 20, 10, 5, 2, 1};\n    vector<int> result;\n    \n    // Greedy approach - start with largest denomination\n    for(int coin : denominations) {\n        // While we can use current denomination\n        while(N >= coin) {\n            result.push_back(coin);\n            N -= coin;\n        }\n    }\n    \n    return result;\n}\n\nint main() {\n    int N;\n    cin >> N;\n    \n    vector<int> result = solve(N);\n    \n    // Print denominations used\n    for(int coin : result) {\n        cout << coin << \" \";\n    }\n    cout << endl;\n    \n    return 0;\n}",
