  "content": {
    "problemStatement": "Given an infinite supply of Indian currency denominations {1, 2, 5, 10, 20, 50, 100, 200, 500, 2000} and a target amount NNN, find the minimum number of coins/notes needed to make the amount. Return the list of denominations used in descending order.\n\n\nInput Format\n\nThe only line of input contains NNN - target amount\n\n\nOutput Format\n\nPrint space-separated integers representing the denominations used (in descending order)",
    "constraints": [
      "1 ≤ N ≤ 10^6"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
