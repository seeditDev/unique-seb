  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport itertools\n\n\nclass Solution(object):\n    def printVertically(self, s):\n        \"\"\"\n        :type s: str\n        :rtype: List[str]\n        \"\"\"\n        return [\"\".join(c).rstrip() for c in itertools.izip_longest(*s.split(), fillvalue=' ')]"
    },
