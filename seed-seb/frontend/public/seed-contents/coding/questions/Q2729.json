  "solution": {
    "code": {
      "Python3": "# Time:  O(logn)\n# Space: O(1)\n\n# string, bitmasks\nclass Solution(object):\n    def isFascinating(self, n):\n        \"\"\"\n        :type n: int\n        :rtype: bool\n        \"\"\"\n        lookup = [0]\n        def check(x):\n            while x:\n                x, d = divmod(x, 10)\n                if d == 0 or lookup[0]&(1<<d):\n                    return False\n                lookup[0] |= (1<<d)\n            return True\n    \n        return check(n) and check(2*n) and check(3*n)"
    },
