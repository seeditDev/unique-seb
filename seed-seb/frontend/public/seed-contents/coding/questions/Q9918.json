  "content": {
    "problemStatement": "The newspaper in Chefland consists of 101010 pages numbered 111 to 101010.\n\nThe last 333 pages of the newspaper are always dedicated to the **sports section**.\n\nGiven a random page number XXX, determine whether that page is dedicated to the sports section.\n\n\nInput Format\n\nThe first and only line of input consists of a single integer XXX, denoting the page number.\n\n\nOutput Format\nOutput on a new line, `YES`, if the given page number is dedicated to the sports section, and `NO` otherwise.\n\n\nYou may print each character of the string in uppercase or lowercase (for example, the strings `YES`, `yEs`, `yes`, and `yeS` will all be treated as identical).",
    "constraints": [
      "1≤X≤101 \\leq X \\leq 101≤X≤10"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "3",
        "output": "NO",
        "explanation": "Explanation:\nPage number 333 is not dedicated to the sports section."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "8",
        "output": "YES",
        "explanation": "Explanation:\nSince page number 888 is one of the last three pages, it is dedicated to the sports section."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "10",
        "output": "YES",
        "explanation": "Explanation:\nSince page number 101010 is one of the last three pages, it is dedicated to the sports section."
      }
    ]
  },
