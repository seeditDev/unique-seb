  "content": {
    "problemStatement": "Write a program to input an integer N in decimal form, convert it into binary, and then print the result.",
    "constraints": [
      "1 <= T <= 1000",
      "0 <= N <= 1000",
      "All values are integers"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains a single integer N (in decimal).",
    "outputFormat": "For each test case, print the binary representation of N without leading zeros on a separate line.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n28",
        "output": "11100",
        "explanation": "28 in decimal equals 11100 in binary."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n21",
        "output": "10101",
        "explanation": "21 in decimal equals 10101 in binary."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n10",
        "output": "1010",
        "explanation": "10 in decimal equals 1010 in binary."
      }
    ]
  },
