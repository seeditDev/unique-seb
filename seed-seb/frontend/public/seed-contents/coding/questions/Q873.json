  "solution": {
    "code": {
      "Python3": "# Time:  O(n^2)\n# Space: O(n)\n\nclass Solution(object):\n    def lenLongestFibSubseq(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: int\n        \"\"\"\n        lookup = set(A)\n        result = 2\n        for i in range(len(A)):\n            for j in range(i+1, len(A)):\n                x, y, l = A[i], A[j], 2\n                while x+y in lookup:\n                    x, y, l = y, x+y, l+1\n                result = max(result, l)\n        return result if result > 2 else 0"
    },
