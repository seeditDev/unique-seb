  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nclass Solution(object):\n    def checkIfExist(self, arr):\n        \"\"\"\n        :type arr: List[int]\n        :rtype: bool\n        \"\"\"\n        lookup = set()\n        for x in arr:\n            if 2*x in lookup or \\\n               (x%2 == 0 and x//2 in lookup):\n                return True\n            lookup.add(x)\n        return False"
    },
