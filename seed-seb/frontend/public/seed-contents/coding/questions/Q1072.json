  "solution": {
    "code": {
      "Python3": "# Time:  O(m * n)\n# Space: O(m * n)\n\nimport collections\n\n\nclass Solution(object):\n    def maxEqualRowsAfterFlips(self, matrix):\n        \"\"\"\n        :type matrix: List[List[int]]\n        :rtype: int\n        \"\"\"\n        count = collections.Counter(tuple(x^row[0] for x in row)\n                                          for row in matrix)\n        return max(count.itervalues())"
    },
