  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nvoid merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {\n    int last = m + n - 1;  // Last position in nums1\n    int i = m - 1;         // Last valid element in nums1\n    int j = n - 1;         // Last element in nums2\n    \n    // Start from the end and fill larger elements first\n    while(j >= 0) {\n        if(i >= 0 && nums1[i] > nums2[j]) {\n            nums1[last] = nums1[i];\n            i--;\n        } else {\n            nums1[last] = nums2[j];\n            j--;\n        }\n        last--;\n    }\n}\n\nint main() {\n    int m, n;\n    cin >> m >> n;\n    \n    vector<int> nums1(m + n);\n    vector<int> nums2(n);\n    \n    // Input for array 1\n    for(int i = 0; i < m + n; i++) {\n        cin >> nums1[i];\n    }\n    \n    // Input for array 2\n    for(int i = 0; i < n; i++) {\n        cin >> nums2[i];\n    }\n    \n    merge(nums1, m, nums2, n);\n    \n    // Print merged array\n    for(int i = 0; i < m + n; i++) {\n        cout << nums1[i] << \" \";\n    }\n    cout << endl;\n    \n    return 0;\n}",
