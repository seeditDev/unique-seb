      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nvoid solve() {\n    int n;\n    cin >> n;\n    vector<long long> arr(n);\n    \n    for(int i = 0; i < n; i++) {\n        cin >> arr[i];\n    }\n    \n    // Sort in descending order\n    sort(arr.begin(), arr.end());\n    \n    // Check consecutive triplets\n    bool possible = false;\n    for(int i = 0; i < n-2; i++) {\n        if(arr[i] + arr[i+1] > arr[i+2]) {\n            possible = true;\n            break;\n        }\n    }\n    \n    cout << (possible ? \"YES\" : \"NO\") << \"\\n\";\n}\n\nint main() {\n    int t;\n    cin >> t;\n    while(t--) {\n        solve();\n    }\n    return 0;\n}",
