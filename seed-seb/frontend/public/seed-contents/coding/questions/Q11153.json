  "content": {
    "problemStatement": "Chef is playing with two standard six-sided dice. After rolling both dice once, Chef observes the numbers appearing on them.\n\nYou are given two integers AAA and BBB — the numbers shown on the first and second die, respectively.\n\nYour task is to determine whether both dice show the same number. If they are equal, output `YES`; otherwise, output `NO`.\n\n\nInput Format\nThe first and only line of input contains two space-separated integers\nAAA and BBB — the numbers shown on the first and second die, respectively.\n\n\n\nOutput Format\nOutput a single string on a new line:\n\n\nPrint `YES` if both dice show the same number.\nOtherwise, print `NO`.\n\nYou may print each character of the output in either uppercase or lowercase.",
    "constraints": [
      "1≤A≤61 \\leq A \\leq 61≤A≤6",
      "1≤B≤61 \\leq B \\leq 61≤B≤6"
    ],
    "inputFormat": "",
    "outputFormat": "",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1 1",
        "output": "Yes",
        "explanation": "Explanation:\nSince AAA is equal to BBB, print Yes."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1 3",
        "output": "No",
        "explanation": "Explanation:\nSince AAA is not equal to BBB, print No."
      }
    ]
  },
