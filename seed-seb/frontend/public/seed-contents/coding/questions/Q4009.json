  "content": {
    "problemStatement": "Write a C program that takes two floating-point numbers as input and calculates their product. Print the result with two decimal places.",
    "constraints": [
      "1 <= T <= 1000",
      "-1000.0 <= num1, num2 <= 1000.0"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains two floating-point numbers num1 and num2 separated by a single space.",
    "outputFormat": "For each test case, output a line in the format \"Product: X\" where X is the product of num1 and num2 rounded to exactly two decimal places.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n0.2 2.1",
        "output": "Product: 0.42",
        "explanation": "Multiplying 0.2 by 2.1 gives 0.42, which already has two decimal places."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n10.5 2.0",
        "output": "Product: 21.00",
        "explanation": "10.5 multiplied by 2.0 equals 21.00 after formatting to two decimal places."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n-5.0 3.0",
        "output": "Product: -15.00",
        "explanation": "-5.0 times 3.0 results in -15.00."
      }
    ]
  },
