  "solution": {
    "approach": "",
    "timeComplexity": "",
    "spaceComplexity": "",
    "code": {
      "C": "",
      "C++": "#include <bits/stdc++.h>\nusing namespace std;\n\nstring solve(string& s) {\n    int n = s.length();\n    bool dp[1000][1000] = {false};\n    string ans = \"\";\n    int maxLen = -1;\n    \n    // Fill dp table\n    for(int gap = 0; gap < n; gap++) {\n        for(int i = 0, j = gap; j < n; i++, j++) {\n            if(gap == 0) {\n                // Single character\n                dp[i][j] = true;\n            }\n            else if(gap == 1) {\n                // Two characters\n                dp[i][j] = (s[i] == s[j]);\n            }\n            else {\n                // More than two characters\n                dp[i][j] = (s[i] == s[j] && dp[i+1][j-1]);\n            }\n            \n            // Update answer if current palindrome is longer\n            if(dp[i][j] && maxLen < j - i + 1) {\n                ans = s.substr(i, j - i + 1);\n                maxLen = j - i + 1;\n            }\n        }\n    }\n    \n    return ans;\n}\n\nint main() {\n    int n;\n    cin >> n;\n    string s;\n    cin >> s;\n    cout << solve(s) << endl;\n    return 0;\n}",
