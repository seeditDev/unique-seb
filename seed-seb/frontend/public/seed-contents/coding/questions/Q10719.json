      {
        "id": "sample_3",
        "type": "reg",
        "input": "12\nabacdfgdcaba",
        "output": "aba",
        "explanation": "Explanation:\nString = \"abacdfgdcaba\"\n\"aba\" appears twice and is the longest palindrome\nReturn first occurrence from left"
      }
