  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(n)\n\nimport collections\n\n\n# freq table\nclass Solution(object):\n    def countBadPairs(self, nums):\n        \"\"\"\n        :type nums: List[int]\n        :rtype: int\n        \"\"\"\n        result = len(nums)*(len(nums)-1)//2\n        cnt = collections.Counter()\n        for i, x in enumerate(nums):\n            result -= cnt[x-i]\n            cnt[x-i] += 1\n        return result"
    },
