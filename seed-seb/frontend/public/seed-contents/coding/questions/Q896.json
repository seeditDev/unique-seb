  "solution": {
    "code": {
      "Python3": "# Time:  O(n)\n# Space: O(1)\n\nclass Solution(object):\n    def isMonotonic(self, A):\n        \"\"\"\n        :type A: List[int]\n        :rtype: bool\n        \"\"\"\n        inc, dec = False, False\n        for i in range(len(A)-1):\n            if A[i] < A[i+1]:\n                inc = True\n            elif A[i] > A[i+1]:\n                dec = True\n        return not inc or not dec"
    },
