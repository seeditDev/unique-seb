  "content": {
    "problemStatement": "Write a C program that takes three integers as input and determines the largest among them. Print the largest number.",
    "constraints": [
      "1 <= T <= 1000",
      "1 <= num1, num2, num3 <= 1000"
    ],
    "inputFormat": "First line contains an integer T, the number of test cases. Each of the next T lines contains three space-separated integers denoting the three numbers.",
    "outputFormat": "For each test case, print a line in the format \"Largest: X\" where X is the greatest of the three given integers.",
    "notes": [],
    "sampleTestCases": [
      {
        "id": "sample_1",
        "type": "reg",
        "input": "1\n1 2 3",
        "output": "Largest: 3",
        "explanation": "The three numbers are 1, 2 and 3; the greatest is 3."
      },
      {
        "id": "sample_2",
        "type": "reg",
        "input": "1\n10 5 8",
        "output": "Largest: 10",
        "explanation": "Among 10, 5 and 8 the maximum value is 10."
      },
      {
        "id": "sample_3",
        "type": "reg",
        "input": "1\n7 7 7",
        "output": "Largest: 7",
        "explanation": "All three numbers are equal, so the largest is 7."
      }
    ]
  },
