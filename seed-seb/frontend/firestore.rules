rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// SEED-IT Platform — Hardened Production Security Rules
//
// Single Master Field Contract & Strict Authority:
//   • Identity: Strictly request.auth.uid
//   • Tenant: Strictly tenantId (Fail closed — missing tenant = DENY)
//   • Results: Strictly assessmentResults/{tenantId}/{assessmentId}/{userId}
//   • Keys: assessment_keys is Admin-only
//   • Proctoring: Immutable event logs verified by auth.uid and attemptId
//   • Subcollections: Explicit matching, wildcard subPath denied
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ──────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function myRole() {
      return hasProfile()
        ? myProfile().get('role', 'student')
        : (isSignedIn() ? request.auth.token.get('role', 'student') : 'none');
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'superadmin';
    }

    function isStaff() {
      return myRole() == 'staff';
    }

    function isPortal() {
      return isAdmin() || isStaff();
    }

    function myTenant() {
      return hasProfile()
        ? myProfile().get('tenantId', '')
        : request.auth.token.get('tenantId', '');
    }

    function tenantAllowed(tenantId) {
      return isAdmin() || (isStaff() && myTenant() != '' && tenantId == myTenant());
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (isAdmin() || (myTenant() != '' && myTenant() == tenantId));
    }

    // ══════════════════════════════════════════════════════════════════════
    // 0. Public Version & Build Hash (Pre-Launch Checks)
    // ══════════════════════════════════════════════════════════════════════

    match /version_seedit/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_build_hashes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessment_keys/{contestId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 1. Users   users/{userId}
    // ══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Staff can only get users within their own tenant; Admins can get all; Users can get self
      allow get:    if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));
      allow list:   if isAdmin();

      // User Provisioning:
      // - Admins can create any user
      // - Staff can create students within their own tenant
      // - Students self-provisioning during initial sign-up MUST have their tenantId bound to a trusted auth token claim (or invitation)
      //   to prevent choosing arbitrary target tenants.
      allow create: if isAdmin()
        || (isStaff()
            && tenantAllowed(request.resource.data.get('tenantId', ''))
            && request.resource.data.get('role', 'student') == 'student')
        || (isUser(userId)
            && request.resource.data.get('role', 'student') == 'student'
            && request.resource.data.get('uid', '') == userId
            && request.auth.token.get('tenantId', '') != ''
            && request.resource.data.get('tenantId', '') == request.auth.token.get('tenantId', ''));

      // Updates restricted: role and tenantId are strictly immutable for staff and students (Admin only)
      allow update: if isAdmin()
        || (isStaff()
            && tenantAllowed(resource.data.get('tenantId', ''))
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('uid', '') == resource.data.get('uid', ''))
        || (isUser(userId)
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('uid', '') == resource.data.get('uid', ''));

      allow delete: if isAdmin();

      // Explicitly matched user subcollections (wildcard match removed)
      match /courseProgress/{courseId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        // Students can initialize learning state, but cannot manufacture verified, certified, eligible, completed status, score, or percentage
        allow create: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && request.resource.data.get('verified', false) == false
              && request.resource.data.get('certified', false) == false
              && request.resource.data.get('eligible', false) == false
              && request.resource.data.get('completed', false) == false
              && request.resource.data.get('score', 0) == 0
              && request.resource.data.get('percentage', 0) == 0);
        // Student updates are restricted to client-owned learning state allowlist.
        // All authoritative placement/completion fields are strictly locked against student modification.
        allow update: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && request.resource.data.get('verified', false) == resource.data.get('verified', false)
              && request.resource.data.get('certified', false) == resource.data.get('certified', false)
              && request.resource.data.get('eligible', false) == resource.data.get('eligible', false)
              && request.resource.data.get('completed', false) == resource.data.get('completed', false)
              && request.resource.data.get('score', 0) == resource.data.get('score', 0)
              && request.resource.data.get('percentage', 0) == resource.data.get('percentage', 0)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'notes', 'bookmarks', 'currentStep', 'lastLesson', 'lastPosition',
                   'practiceState', 'updatedAt', 'progressPercentage', 'history',
                   'completedLessons', 'activeSession', 'lastAccessedAt', 'status',
                   'verified', 'certified', 'eligible', 'completed', 'score', 'percentage'
                 ]));
        allow delete: if isAdmin();
      }

      match /contestAttempts/{attemptId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow create: if (
            isUser(userId)
            && request.resource.data.get('uid', '') == userId
            && myTenant() != ''
            && request.resource.data.get('tenantId', '') == myTenant()
            && isTenantMember(get(/databases/$(database)/documents/assessments/$(request.resource.data.get('assessmentId', ''))).data.get('tenantId', ''))
          )
          || isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        // Students can update answers/session state while active, but cannot tamper with immutable metadata
        allow update: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && resource.data.get('status', '') != 'auto_submitted'
              && request.resource.data.get('uid', '') == resource.data.get('uid', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('startedAt', '') == resource.data.get('startedAt', '')
              && request.resource.data.get('durationSeconds', 0) == resource.data.get('durationSeconds', 0));
        allow delete: if isAdmin();
      }

      match /assessmentAttempts/{attemptId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow create: if (
            isUser(userId)
            && request.resource.data.get('uid', '') == userId
            && myTenant() != ''
            && request.resource.data.get('tenantId', '') == myTenant()
            && isTenantMember(get(/databases/$(database)/documents/assessments/$(request.resource.data.get('assessmentId', ''))).data.get('tenantId', ''))
          )
          || isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow update: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && resource.data.get('status', '') != 'auto_submitted'
              && request.resource.data.get('uid', '') == resource.data.get('uid', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('startedAt', '') == resource.data.get('startedAt', '')
              && request.resource.data.get('durationSeconds', 0) == resource.data.get('durationSeconds', 0));
        allow delete: if isAdmin();
      }

      match /profile/{docId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow write: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && !('role' in request.resource.data)
              && !('tenantId' in request.resource.data)
              && !('permissions' in request.resource.data));
      }

      match /settings/{docId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow write: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && !('role' in request.resource.data)
              && !('tenantId' in request.resource.data)
              && !('permissions' in request.resource.data));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 2. Tenants  tenants/{tenantId}
    // ══════════════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow get:    if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin();

      match /cohorts/{cohortId} {
        allow get, list: if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }

      match /settings/{docId} {
        allow get: if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
        allow list, create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 3. Courses / Series / Tests (Strict Tenant Scoping & Inheritance)
    // ══════════════════════════════════════════════════════════════════════

    match /courses/{courseId} {
      allow read:               if isTenantMember(resource.data.get('tenantId', ''));
      allow create:             if isAdmin() || (isStaff() && myTenant() != '' && request.resource.data.get('tenantId', '') == myTenant());
      allow update, delete:     if isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));

      match /series/{seriesId} {
        allow read:               if isTenantMember(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', ''));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));

        match /tests/{testId} {
          allow read:               if isTenantMember(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', ''));
          allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));
        }

        match /_meta/{trackerId} {
          allow read, write: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));
        }
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 4. Assessments (Authoring store - Explicit Subcollections & Tenant Scoping)
    // ══════════════════════════════════════════════════════════════════════

    match /assessments/{assessmentId} {
      // Direct document reads strictly scoped to tenant members
      allow get: if isTenantMember(resource.data.get('tenantId', ''));
      // Collection queries strictly scoped to Admin or Staff querying their matching tenant
      allow list: if isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));
      allow create: if isAdmin() || (isStaff() && myTenant() != '' && request.resource.data.get('tenantId', '') == myTenant());
      allow update, delete: if isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));

      // Explicit subcollections (wildcard removed)
      match /questions/{questionId} {
        allow get, list: if isTenantMember(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', ''));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
      }

      match /sections/{sectionId} {
        allow get, list: if isTenantMember(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', ''));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
      }

      // Metadata & Config restricted to staff/admin of matching tenant (sensitive internal evaluation/answer rules protected)
      match /metadata/{docId} {
        allow get, list: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
      }

      match /config/{docId} {
        allow get, list: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 5. Assessment Results (Strict 4-Segment Path & Immutability)
    //   Path: assessmentResults/{tenantId}/{assessmentId}/{userId}
    //
    //   Trust model: Client-generated results (evaluationSource == 'client').
    //   Score fields are LOCKED TO ZERO on create — the evaluation engine
    //   fills them in via update. Admin/Staff may set any values.
    //   Students cannot manufacture scores at creation time.
    // ══════════════════════════════════════════════════════════════════════

    match /assessmentResults/{tenantId} {
      allow get:   if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
      allow list:  if isAdmin() || (isStaff() && tenantAllowed(tenantId));

      match /{assessmentId}/{userId} {
        allow get:    if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isUser(userId);
        allow list:   if isAdmin() || (isStaff() && tenantAllowed(tenantId));

        // ── P0 FIX: Score fields MUST be at safe zero/false defaults on student create.
        // Students can only write the result "stub". The evaluation engine fills scores
        // via update. This prevents a student from bypassing the evaluator and writing
        // an arbitrary score directly into Firestore.
        allow create: if isAdmin() || (isStaff() && tenantAllowed(tenantId))
          || (isUser(userId)
              && myTenant() != ''
              && tenantId == myTenant()
              && request.resource.data.get('tenantId', '') == myTenant()
              && request.resource.data.get('assessmentId', '') == assessmentId
              && request.resource.data.get('userId', '') == userId
              && isTenantMember(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', ''))
              // Score integrity: all evaluation fields must be at initial safe values on create
              && request.resource.data.get('score', 0) == 0
              && request.resource.data.get('percentage', 0) == 0
              && request.resource.data.get('correctAnswers', 0) == 0
              && request.resource.data.get('totalMarks', 0) == 0
              && request.resource.data.get('maxMarks', 0) == 0
              && request.resource.data.get('rank', 0) == 0
              && request.resource.data.get('qualified', false) == false
              && request.resource.data.get('grade', '') == ''
              && request.resource.data.get('completed', false) == false
              && request.resource.data.get('status', '') != 'submitted'
              && request.resource.data.get('evaluationStatus', '') != 'completed'
              // Attestation: mark this result as client-generated
              && request.resource.data.get('evaluationSource', '') == 'client');

        // ── P1 FIX: Explicit field allowlist + all score fields locked against student tampering on update.
        // Students can update answers/responses while active, but cannot add arbitrary fields
        // or change any evaluation/completion fields (score, grade, status, etc.).
        allow update: if isAdmin() || (isStaff() && tenantAllowed(tenantId))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && request.resource.data.get('userId', '') == userId
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              // All evaluation/score fields strictly locked
              && request.resource.data.get('score', 0) == resource.data.get('score', 0)
              && request.resource.data.get('percentage', 0) == resource.data.get('percentage', 0)
              && request.resource.data.get('rank', 0) == resource.data.get('rank', 0)
              && request.resource.data.get('correctAnswers', 0) == resource.data.get('correctAnswers', 0)
              && request.resource.data.get('totalMarks', 0) == resource.data.get('totalMarks', 0)
              && request.resource.data.get('maxMarks', 0) == resource.data.get('maxMarks', 0)
              && request.resource.data.get('evaluationStatus', '') == resource.data.get('evaluationStatus', '')
              && request.resource.data.get('qualified', false) == resource.data.get('qualified', false)
              && request.resource.data.get('grade', '') == resource.data.get('grade', '')
              && request.resource.data.get('evaluationSource', 'client') == resource.data.get('evaluationSource', 'client')
              // Explicit field allowlist: prevents writing arbitrary undeclared fields
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'answers', 'responses', 'codingSubmissions', 'timeSpent',
                   'updatedAt', 'lastSyncAt', 'heartbeatAt',
                   'score', 'percentage', 'correctAnswers', 'totalMarks', 'maxMarks',
                   'qualified', 'grade', 'rank', 'evaluationStatus',
                   'completed', 'status', 'submittedAt',
                   'evaluationSource', 'runtimeVersion', 'runtimeManifestHash'
                 ]));

        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 6. Proctoring Logs & Events (Attempt-Bound, Tenant Scoped & Immutable)
    //
    //   P0 FIX: proctoringLogs/{attemptId} is now strictly bound to the
    //   authenticated user's own attempt. Student A cannot create or update
    //   a proctoring log for Student B's attemptId. The cross-document check
    //   verifies that assessmentAttempts/{attemptId}.uid == request.auth.uid.
    // ══════════════════════════════════════════════════════════════════════

    match /proctoringLogs/{attemptId} {
      allow read: if isAdmin()
        || (isStaff() && (resource == null || tenantAllowed(resource.data.get('tenantId', ''))))
        || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));

      // ── P0 FIX: Bind proctoring log to the authenticated student's actual attempt.
      // Cross-document check: assessmentAttempts/{attemptId} must belong to request.auth.uid
      // and to the student's own tenant. Prevents Student A writing a log for Student B's attemptId.
      allow create: if isSignedIn()
        && myTenant() != ''
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('tenantId', '') == myTenant()
        && request.resource.data.get('attemptId', '') == attemptId
        // Cross-document attempt ownership verification
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/assessmentAttempts/$(attemptId)).data.get('uid', '') == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/assessmentAttempts/$(attemptId)).data.get('tenantId', '') == myTenant();

      // ── P1 FIX: Explicit student-writable field allowlist on update.
      // Prevents students from manipulating proctoring metadata such as
      // violationCount, riskScore, finalDecision, suspicionScore.
      allow update: if isAdmin()
        || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')))
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid
            && resource.data.get('status', '') != 'finalized'
            && request.resource.data.get('userId', '') == resource.data.get('userId', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('attemptId', '') == resource.data.get('attemptId', '')
            // Explicit allowlist: only benign session-state fields are student-writable
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'browserState', 'cameraStatus', 'microphoneStatus',
                 'lastHeartbeat', 'heartbeatAt', 'updatedAt',
                 'sessionState', 'networkState', 'focusState'
               ]));
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isAdmin()
          || (isStaff() && (resource == null || tenantAllowed(get(/databases/$(database)/documents/proctoringLogs/$(attemptId)).data.get('tenantId', ''))))
          || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));

        // ── P0 FIX: Event create also verifies the parent log belongs to the authenticated user.
        // Prevents Student A writing events under proctoringLogs/StudentBAttempt
        // even if the payload fields are internally self-consistent.
        allow create: if isSignedIn()
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('attemptId', '') == attemptId
          && request.resource.data.get('tenantId', '') == get(/databases/$(database)/documents/proctoringLogs/$(attemptId)).data.get('tenantId', '')
          // Parent log must belong to the authenticated user (closes attempt substitution attack)
          && get(/databases/$(database)/documents/proctoringLogs/$(attemptId)).data.get('userId', '') == request.auth.uid;
        allow update: if false; // Strict immutability
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 7. Practice, Progress & Banks
    // ══════════════════════════════════════════════════════════════════════

    match /codingProgress/{uid} {
      allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));

      match /{document=**} {
        allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));
      }
    }

    match /userActivities/{uid} {
      allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));

      match /{allPaths=**} {
        allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));
      }
    }

    match /codingBank/{bankId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /codingChallenges/{challengeId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /questionBank/{questionId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /userSolutions/{uid}/{sub=**} {
      allow read, write: if isUser(uid) || isPortal();
    }

    match /livePresence/{dateStr}/sessions/{sessionId} {
      allow read:   if isPortal();
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isPortal()
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isPortal();
    }

    match /contentUrls/{urlId} {
      allow read:  if isSignedIn();
      allow write: if isPortal();
    }

    match /appConfig/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Fallback: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
