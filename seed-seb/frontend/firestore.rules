rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// SEED-IT Platform — Hardened Production Security Rules
//
// Single Master Field Contract & Strict Authority:
//   • Identity: Strictly request.auth.uid
//   • Tenant: Strictly tenantId (Fail closed — missing tenant = DENY)
//   • Results: Strictly assessmentResults/{tenantId}/{assessmentId}/{userId}
//   • Keys: assessment_keys is Admin-only
//   • Proctoring: Immutable event logs verified by auth.uid
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ──────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function myRole() {
      return hasProfile()
        ? myProfile().get('role', 'student')
        : (isSignedIn() ? request.auth.token.get('role', 'student') : 'none');
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'superadmin';
    }

    function isStaff() {
      return myRole() == 'staff';
    }

    function isPortal() {
      return isAdmin() || isStaff();
    }

    function myTenant() {
      return hasProfile()
        ? myProfile().get('tenantId', '')
        : request.auth.token.get('tenantId', '');
    }

    function tenantAllowed(tenantId) {
      return isAdmin() || (isStaff() && myTenant() != '' && tenantId == myTenant());
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (isAdmin() || (myTenant() != '' && myTenant() == tenantId));
    }

    // ══════════════════════════════════════════════════════════════════════
    // 0. Public Version & Build Hash (Pre-Launch Checks)
    // ══════════════════════════════════════════════════════════════════════

    match /version_seedit/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_build_hashes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessment_keys/{contestId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 1. Users   users/{userId}
    // ══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow get:    if isUser(userId) || isPortal();
      allow list:   if isPortal();

      // Student can self-provision during initial sign-up
      allow create: if isUser(userId)
        && request.resource.data.get('role', 'student') == 'student'
        || isPortal();

      // Updates restricted to non-sensitive fields
      allow update: if isPortal()
        || (isUser(userId)
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', ''));

      allow delete: if isAdmin();

      // User subcollections (courseProgress, activity, etc.)
      match /courseProgress/{courseId} {
        allow read, write: if isUser(userId) || isPortal();
      }

      match /{subPath=**} {
        allow read, write: if isUser(userId) || isPortal();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 2. Tenants  tenants/{tenantId}
    // ══════════════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow get:    if isPortal() || isTenantMember(tenantId);
      allow list:   if isPortal();
      allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));

      match /{sub=**} {
        allow read:  if isPortal() || isTenantMember(tenantId);
        allow write: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    match /publicTenants/{tenantId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 3. Courses / Series / Tests
    // ══════════════════════════════════════════════════════════════════════

    match /courses/{courseId} {
      allow read:               if isSignedIn();
      allow create, update, delete: if isPortal();

      match /series/{seriesId} {
        allow read:               if isSignedIn();
        allow create, update, delete: if isPortal();

        match /tests/{testId} {
          allow read:               if isSignedIn();
          allow create, update, delete: if isPortal();
        }

        match /_meta/{trackerId} {
          allow read:  if isPortal();
          allow write: if isPortal();
        }
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 4. Assessments (Authoring store)
    // ══════════════════════════════════════════════════════════════════════

    match /assessments/{assessmentId} {
      allow list: if isPortal();
      allow create, update, delete: if isPortal();
      allow get: if isSignedIn();

      match /{document=**} {
        allow read:  if isSignedIn();
        allow write: if isPortal();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 5. Assessment Results (Strict 4-Segment Path)
    //   Path: assessmentResults/{tenantId}/{assessmentId}/{userId}
    // ══════════════════════════════════════════════════════════════════════

    match /assessmentResults/{tenantId} {
      allow read:  if isPortal() || isTenantMember(tenantId);
      allow write: if isPortal();

      match /{assessmentId}/{userId} {
        allow read:   if isPortal() || isUser(userId);
        allow create: if isPortal() || (isSignedIn() && isUser(userId)) || (request.resource.data.get('isGuest', false) == true);
        allow update: if isPortal()
          || (isUser(userId)
              && (
                resource.data.get('status', '') != 'submitted' ||
                request.resource.data.get('status', '') == 'submitted'
              ));
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 6. Proctoring Logs & Events (Immutable Event Log)
    // ══════════════════════════════════════════════════════════════════════

    match /proctoringLogs/{attemptId} {
      allow read: if isPortal()
        || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isPortal()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isPortal()
          || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
        allow create: if isSignedIn()
          && request.resource.data.get('userId', '') == request.auth.uid;
        allow update: if false; // Immutable
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 7. Practice, Progress & Banks
    // ══════════════════════════════════════════════════════════════════════

    match /codingProgress/{uid} {
      allow read, write: if isUser(uid) || isPortal();

      match /{document=**} {
        allow read, write: if isUser(uid) || isPortal();
      }
    }

    match /userActivities/{uid} {
      allow read, write: if isUser(uid) || isPortal();

      match /{allPaths=**} {
        allow read, write: if isUser(uid) || isPortal();
      }
    }

    match /codingBank/{bankId} {
      allow get:    if isSignedIn();
      allow list:   if isPortal();
      allow create, update, delete: if isPortal();
    }

    match /codingChallenges/{challengeId} {
      allow get:    if isSignedIn();
      allow list:   if isPortal();
      allow create, update, delete: if isPortal();
    }

    match /questionBank/{questionId} {
      allow get:    if isSignedIn();
      allow list:   if isPortal();
      allow create, update, delete: if isPortal();
    }

    match /userSolutions/{uid}/{sub=**} {
      allow read, write: if isUser(uid) || isPortal();
    }

    match /livePresence/{dateStr}/sessions/{sessionId} {
      allow read:   if isPortal();
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isPortal()
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isPortal();
    }

    match /contentUrls/{urlId} {
      allow read:  if isSignedIn();
      allow write: if isPortal();
    }

    match /appConfig/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Fallback: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
