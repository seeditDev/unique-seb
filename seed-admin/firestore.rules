rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// SEED-IT Platform — Hardened Production Security Rules
//
// Single Master Field Contract & Strict Authority:
//   • Identity: Strictly request.auth.uid
//   • Tenant: Strictly tenantId (Fail closed — missing tenant = DENY)
//   • Results: Strictly assessmentResults/{tenantId}/{assessmentId}/{userId}
//   • Keys: assessment_keys is Admin-only
//   • Proctoring: Immutable event logs verified by auth.uid and attemptId
//   • Subcollections: Explicit matching, wildcard subPath denied
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ──────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function myRole() {
      return hasProfile()
        ? myProfile().get('role', 'student')
        : (isSignedIn() ? request.auth.token.get('role', 'student') : 'none');
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'superadmin';
    }

    function isStaff() {
      return myRole() == 'staff';
    }

    function isPortal() {
      return isAdmin() || isStaff();
    }

    function myTenant() {
      return hasProfile()
        ? myProfile().get('tenantId', '')
        : request.auth.token.get('tenantId', '');
    }

    function tenantAllowed(tenantId) {
      return isAdmin() || (isStaff() && myTenant() != '' && tenantId == myTenant());
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (isAdmin() || (myTenant() != '' && myTenant() == tenantId));
    }

    // ══════════════════════════════════════════════════════════════════════
    // 0. Public Version & Build Hash (Pre-Launch Checks)
    // ══════════════════════════════════════════════════════════════════════

    match /version_seedit/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_build_hashes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessment_keys/{contestId} {
      allow read, write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 1. Users   users/{userId}
    // ══════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      // Staff can only get users within their own tenant; Admins can get all; Users can get self
      allow get:    if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));
      allow list:   if isAdmin();

      // Student can self-provision during initial sign-up
      allow create: if (isUser(userId)
          && request.resource.data.get('role', 'student') == 'student'
          && request.resource.data.get('uid', '') == userId)
        || isAdmin()
        || (isStaff()
            && tenantAllowed(request.resource.data.get('tenantId', ''))
            && request.resource.data.get('role', 'student') == 'student');

      // Updates restricted: role and tenantId are strictly immutable for staff and students (Admin only)
      allow update: if isAdmin()
        || (isStaff()
            && tenantAllowed(resource.data.get('tenantId', ''))
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('uid', '') == resource.data.get('uid', ''))
        || (isUser(userId)
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('uid', '') == resource.data.get('uid', ''));

      allow delete: if isAdmin();

      // Explicitly matched user subcollections (wildcard match removed)
      match /courseProgress/{courseId} {
        allow read, write: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
      }

      match /contestAttempts/{attemptId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow create: if isUser(userId)
          && request.resource.data.get('uid', '') == userId
          || isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        // Students can update answers/session state while active, but cannot tamper with immutable metadata
        allow update: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && resource.data.get('status', '') != 'auto_submitted'
              && request.resource.data.get('uid', '') == resource.data.get('uid', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('startedAt', '') == resource.data.get('startedAt', '')
              && request.resource.data.get('durationSeconds', 0) == resource.data.get('durationSeconds', 0));
        allow delete: if isAdmin();
      }

      match /assessmentAttempts/{attemptId} {
        allow read: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow create: if isUser(userId)
          && request.resource.data.get('uid', '') == userId
          || isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
        allow update: if isAdmin()
          || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && resource.data.get('status', '') != 'auto_submitted'
              && request.resource.data.get('uid', '') == resource.data.get('uid', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('startedAt', '') == resource.data.get('startedAt', '')
              && request.resource.data.get('durationSeconds', 0) == resource.data.get('durationSeconds', 0));
        allow delete: if isAdmin();
      }

      match /profile/{docId} {
        allow read, write: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
      }

      match /settings/{docId} {
        allow read, write: if isUser(userId) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(userId)).data.get('tenantId', '')));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 2. Tenants  tenants/{tenantId}
    // ══════════════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow get:    if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(tenantId));

      match /{sub=**} {
        allow read:  if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
        allow write: if isAdmin() || (isStaff() && tenantAllowed(tenantId));
      }
    }

    match /publicTenants/{tenantId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // 3. Courses / Series / Tests (Strict Tenant Scoping & Inheritance)
    // ══════════════════════════════════════════════════════════════════════

    match /courses/{courseId} {
      allow read:               if isTenantMember(resource.data.get('tenantId', ''));
      allow create:             if isAdmin() || (isStaff() && myTenant() != '' && request.resource.data.get('tenantId', '') == myTenant());
      allow update, delete:     if isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));

      match /series/{seriesId} {
        allow read:               if isTenantMember(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', ''));
        allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));

        match /tests/{testId} {
          allow read:               if isTenantMember(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', ''));
          allow create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));
        }

        match /_meta/{trackerId} {
          allow read, write: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/courses/$(courseId)).data.get('tenantId', '')));
        }
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 4. Assessments (Authoring store - Strict Tenant Scoping & Inheritance)
    // ══════════════════════════════════════════════════════════════════════

    match /assessments/{assessmentId} {
      // Direct document reads strictly scoped to tenant members
      allow get: if isTenantMember(resource.data.get('tenantId', ''));
      // Collection queries strictly scoped to Admin or Staff with non-empty tenant
      allow list: if isAdmin() || (isStaff() && myTenant() != '');
      allow create: if isAdmin() || (isStaff() && myTenant() != '' && request.resource.data.get('tenantId', '') == myTenant());
      allow update, delete: if isAdmin() || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')));

      match /{document=**} {
        allow get: if isTenantMember(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', ''));
        allow list, create, update, delete: if isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/assessments/$(assessmentId)).data.get('tenantId', '')));
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 5. Assessment Results (Strict 4-Segment Path & Immutability)
    //   Path: assessmentResults/{tenantId}/{assessmentId}/{userId}
    // ══════════════════════════════════════════════════════════════════════

    match /assessmentResults/{tenantId} {
      allow read:  if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isTenantMember(tenantId);
      allow write: if isAdmin() || (isStaff() && tenantAllowed(tenantId));

      match /{assessmentId}/{userId} {
        allow read:   if isAdmin() || (isStaff() && tenantAllowed(tenantId)) || isUser(userId);
        
        // Strict create: must belong to authenticated user, matching tenantId and assessmentId
        allow create: if isAdmin() || (isStaff() && tenantAllowed(tenantId))
          || (isUser(userId)
              && myTenant() != ''
              && request.resource.data.get('tenantId', '') == tenantId
              && request.resource.data.get('assessmentId', '') == assessmentId
              && request.resource.data.get('userId', '') == userId);
        
        // Strict update: only permitted while attempt is active. All evaluation & score fields locked against student tampering.
        allow update: if isAdmin() || (isStaff() && tenantAllowed(tenantId))
          || (isUser(userId)
              && resource.data.get('completed', false) == false
              && resource.data.get('status', '') != 'submitted'
              && request.resource.data.get('userId', '') == userId
              && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
              && request.resource.data.get('assessmentId', '') == resource.data.get('assessmentId', '')
              && request.resource.data.get('score', 0) == resource.data.get('score', 0)
              && request.resource.data.get('percentage', 0) == resource.data.get('percentage', 0)
              && request.resource.data.get('rank', 0) == resource.data.get('rank', 0)
              && request.resource.data.get('correctAnswers', 0) == resource.data.get('correctAnswers', 0)
              && request.resource.data.get('totalMarks', 0) == resource.data.get('totalMarks', 0)
              && request.resource.data.get('maxMarks', 0) == resource.data.get('maxMarks', 0)
              && request.resource.data.get('evaluationStatus', '') == resource.data.get('evaluationStatus', '')
              && request.resource.data.get('qualified', false) == resource.data.get('qualified', false)
              && request.resource.data.get('grade', '') == resource.data.get('grade', ''));

        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 6. Proctoring Logs & Events (Tenant Scoped & Immutable Event Log)
    // ══════════════════════════════════════════════════════════════════════

    match /proctoringLogs/{attemptId} {
      allow read: if isAdmin()
        || (isStaff() && (resource == null || tenantAllowed(resource.data.get('tenantId', ''))))
        || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
      allow create: if isSignedIn()
        && myTenant() != ''
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('tenantId', '') == myTenant()
        && request.resource.data.get('attemptId', '') == attemptId;
      allow update: if isAdmin()
        || (isStaff() && tenantAllowed(resource.data.get('tenantId', '')))
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid
            && resource.data.get('status', '') != 'finalized'
            && request.resource.data.get('userId', '') == resource.data.get('userId', '')
            && request.resource.data.get('tenantId', '') == resource.data.get('tenantId', '')
            && request.resource.data.get('attemptId', '') == resource.data.get('attemptId', ''));
      allow delete: if isAdmin();

      match /events/{eventId} {
        allow read: if isAdmin()
          || (isStaff() && (resource == null || tenantAllowed(get(/databases/$(database)/documents/proctoringLogs/$(attemptId)).data.get('tenantId', ''))))
          || (isSignedIn() && (resource == null || resource.data.get('userId', '') == request.auth.uid));
        allow create: if isSignedIn()
          && request.resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.get('attemptId', '') == attemptId
          && request.resource.data.get('tenantId', '') == get(/databases/$(database)/documents/proctoringLogs/$(attemptId)).data.get('tenantId', '');
        allow update: if false; // Strict immutability
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 7. Practice, Progress & Banks
    // ══════════════════════════════════════════════════════════════════════

    match /codingProgress/{uid} {
      allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));

      match /{document=**} {
        allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));
      }
    }

    match /userActivities/{uid} {
      allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));

      match /{allPaths=**} {
        allow read, write: if isUser(uid) || isAdmin() || (isStaff() && tenantAllowed(get(/databases/$(database)/documents/users/$(uid)).data.get('tenantId', '')));
      }
    }

    match /codingBank/{bankId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /codingChallenges/{challengeId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /questionBank/{questionId} {
      allow get:    if isSignedIn();
      allow list, create, update, delete: if isPortal();
    }

    match /userSolutions/{uid}/{sub=**} {
      allow read, write: if isUser(uid) || isPortal();
    }

    match /livePresence/{dateStr}/sessions/{sessionId} {
      allow read:   if isPortal();
      allow create: if isSignedIn()
        && request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if isPortal()
        || (isSignedIn()
            && resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isPortal();
    }

    match /contentUrls/{urlId} {
      allow read:  if isSignedIn();
      allow write: if isPortal();
    }

    match /appConfig/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // Fallback: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
